---
// Weight axis only: Geologica's slant, sharpness and cursive axes stay at their defaults.
import '@fontsource-variable/geologica/wght.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource-variable/ibm-plex-sans/wght-italic.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { site } from '../data/site';
import { DEFAULT_LOCALE, LOCALES, PUBLISHED_LOCALES, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { withBase } from '../i18n/utils';

interface Props {
  title: string;
  /** Use `title` as the whole document title, without the site name added. */
  rawTitle?: boolean;
  description?: string;
  lang?: Locale;
  /** Locale-neutral path of this page, for hreflang alternates, e.g. '/services/'. */
  path?: string;
  /** Keep the page out of the search index (e.g. the search page itself). */
  noSearch?: boolean;
}

const { title, rawTitle = false, description, lang = DEFAULT_LOCALE, path, noSearch = false } = Astro.props;
const t = useTranslations(lang);
const fullTitle = rawTitle ? title : title === site.name ? `${site.name} | ${t('site.tagline')}` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = path
  ? PUBLISHED_LOCALES.map((l) => ({ lang: LOCALES[l].htmlLang, href: new URL(withBase(l === DEFAULT_LOCALE ? path : `/${l}${path}`), Astro.site).href }))
  : [];
---

<!doctype html>
<html lang={LOCALES[lang].htmlLang} data-theme="b">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:locale" content={LOCALES[lang].ogLocale} />
    {description && <meta property="og:description" content={description} />}
    <meta name="theme-color" content="#0b1631" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <!-- Demo build: keep it out of search engines until launch. -->
    <meta name="robots" content="noindex" />
  </head>
  <body class="flex min-h-dvh flex-col bg-white font-body text-ink antialiased">
    <a href="#main" class="sr-only z-50 bg-ink px-4 py-2 text-paper focus:not-sr-only focus:fixed focus:top-2 focus:left-2">{t('nav.skip')}</a>
    <Header lang={lang} />
    <main id="main" class="flex-1" data-pagefind-body={noSearch ? undefined : ''}>
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchDialog lang={lang} />
  </body>
</html>
