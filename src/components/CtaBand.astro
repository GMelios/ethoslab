---
import { localePath } from '../i18n/utils';
import { closingCta } from '../data/offer';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
  title?: string;
  body?: string;
  /** Button label. Defaults to the shared closing call to action. */
  button?: string;
}
const { lang, title = closingCta.title, body = closingCta.body, button = closingCta.button } = Astro.props;
---

<section class="band-ember relative overflow-hidden">
  <svg class="pointer-events-none absolute -right-24 -bottom-40 h-[28rem] w-[28rem] opacity-[0.13]" viewBox="0 0 200 200" aria-hidden="true">
    <g fill="none" stroke="#0b1631" stroke-width="1.2">
      {Array.from({ length: 9 }, (_, i) => <circle cx="100" cy="100" r={12 + i * 11} />)}
    </g>
  </svg>
  <div class="wrap relative grid items-end gap-8 py-16 md:grid-cols-[1fr_auto] md:py-20">
    <div>
      <h2 class="display h-section max-w-3xl text-ink">{title}</h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink/85">{body}</p>
    </div>
    <a href={localePath(lang, '/contact/')} class="btn btn-primary !px-7 !py-3.5 text-base">{button} <span aria-hidden="true">→</span></a>
  </div>
</section>
