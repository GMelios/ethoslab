---
/** A static redirect for a moved page (GitHub Pages has no server-side redirects). */
import { localePath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
  to: string;
}
const { lang, to } = Astro.props;
const href = localePath(lang, to);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${href}`} />
    <link rel="canonical" href={href} />
    <title>Moved</title>
  </head>
  <body>
    <p>This page has moved to <a href={href}>{href}</a>.</p>
  </body>
</html>
