---
/**
 * Decorative streamgraph: layered ribbons that swell and thin across the width,
 * echoing the "story of the discussion" chart in Room Wisdom. Generated at build
 * time from a fixed seed, so it is identical on every build. Purely decorative.
 */
interface Props {
  class?: string;
  seed?: number;
  layers?: number;
  /** Colours from back to front. */
  colors?: string[];
}
const {
  class: className = '',
  seed = 7,
  layers = 6,
  // Brand kit colours that read on midnight: Line Dark, Slate, Haze, Line, Ember, Ethos Orange.
  colors = ['#2c3a60', '#5b6478', '#a3adc2', '#d5d9e2', '#c2410c', '#f1592a'],
} = Astro.props;

const W = 1200;
const H = 520;
const N = 48;

// Small deterministic PRNG (mulberry32).
let a = seed >>> 0;
const rand = () => {
  a = (a + 0x6d2b79f5) >>> 0;
  let t = a;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

// Each layer is a sum of a few soft bumps, so ribbons rise and fall at different moments.
const series = Array.from({ length: layers }, () => {
  const bumps = Array.from({ length: 3 }, () => ({ c: rand(), w: 0.08 + rand() * 0.18, h: 0.4 + rand() }));
  return Array.from({ length: N }, (_, i) => {
    const x = i / (N - 1);
    return 0.08 + bumps.reduce((s, b) => s + b.h * Math.exp(-((x - b.c) ** 2) / (2 * b.w * b.w)), 0);
  });
});

// Stack around a centred ("silhouette") baseline.
const totals = Array.from({ length: N }, (_, i) => series.reduce((s, l) => s + l[i], 0));
const maxTotal = Math.max(...totals);
const scale = (H * 0.86) / maxTotal;
const xs = Array.from({ length: N }, (_, i) => (i / (N - 1)) * W);
let lower = totals.map((t) => H / 2 + (t * scale) / 2);

const smooth = (pts: [number, number][]) => {
  // Catmull-Rom to cubic Bezier.
  let d = `M${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }
  return d;
};

const paths = series.map((l, k) => {
  const upper = lower.map((y, i) => y - l[i] * scale);
  const top = smooth(xs.map((x, i) => [x, upper[i]]));
  const bottom = smooth(xs.map((x, i) => [x, lower[i]] as [number, number]).reverse()).replace(/^M/, 'L');
  lower = upper;
  return { d: `${top}${bottom}Z`, fill: colors[k % colors.length], i: k };
});
---

<svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" class:list={['ribbons', className]} aria-hidden="true" focusable="false">
  {paths.map((p) => <path d={p.d} fill={p.fill} style={`--i:${p.i}`} />)}
</svg>

<style>
  .ribbons path {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation:
      ribbon-in 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) both,
      ribbon-breathe 9s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * 90ms), calc(1.4s + var(--i) * 0.7s);
    stroke: #0b1631;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  @keyframes ribbon-in {
    from {
      opacity: 0;
      transform: scaleY(0.2);
    }
  }
  @keyframes ribbon-breathe {
    to {
      transform: scaleY(1.06) translateY(-1.5%);
    }
  }
</style>
