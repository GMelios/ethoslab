---
/** One labelled section on the product pages: heading on the left, content on the right. */
interface Props {
  heading: string;
  id: string;
  /** The first row after the page hero drops its top rule (the hero already has one). */
  first?: boolean;
}
const { heading, id, first = false } = Astro.props;
---

<section class="wrap" aria-labelledby={id}>
  <div class:list={['grid gap-6 py-10 md:py-14 lg:grid-cols-12 lg:gap-10', !first && 'border-t border-line']}>
    <h2 id={id} class="display text-2xl text-ink md:text-3xl lg:col-span-4">{heading}</h2>
    <div class="lg:col-span-8">
      <slot />
    </div>
  </div>
</section>
