---
import { Image } from 'astro:assets';
import type { Localised } from '../i18n/utils';
import { localePath } from '../i18n/utils';
import { sectorLabel, programmeLine } from '../lib/content';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  entry: Localised<'projects'>;
  lang: Locale;
  /** 'text' for the editorial direction, 'card' elsewhere. */
  variant?: 'card' | 'text';
  headingLevel?: 'h2' | 'h3';
}
const { entry, lang, variant = 'card', headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;
const href = localePath(lang, `/work/${entry.slug}/`);
const Heading = headingLevel;
const meta = [d.design ?? programmeLine(d.programmes), d.years].filter(Boolean).join(' · ');
---

<article
  class:list={[
    'group relative flex h-full flex-col',
    variant === 'card' &&
      'overflow-hidden rounded-card bg-white ring-1 ring-line transition hover:shadow-[0_18px_40px_-18px_rgb(11_22_49/0.35)] hover:ring-ink/30',
    variant === 'text' && 'border-t border-ink pt-5',
  ]}
  data-sectors={d.sectors.join(' ')}
>
  {
    variant === 'card' && d.cover && !d.results && (
      <div class="flex aspect-[16/9] items-center justify-center overflow-hidden border-b border-line bg-white p-8">
        <Image src={d.cover} alt="" widths={[320, 640]} sizes="(min-width: 1024px) 380px, 90vw" class="max-h-full w-auto object-contain" />
      </div>
    )
  }
  {
    variant === 'card' && d.headline && (
      <div class="border-b border-line bg-surface px-6 pt-6 pb-5 theme-b:border-0 theme-b:bg-accent theme-b:text-on-accent theme-c:bg-accent-soft">
        <p class="text-4xl font-semibold tracking-tight theme-c:text-accent">{d.headline.value}</p>
        <p class="mt-1 text-sm leading-snug opacity-80">{d.headline.label}</p>
      </div>
    )
  }
  <div class:list={['flex flex-1 flex-col', variant === 'card' && 'p-6']}>
    <ul class="flex flex-wrap gap-x-3 gap-y-1" aria-label={t('case.sectors')}>
      {d.sectors.map((s) => <li class="eyebrow !text-[0.68rem] text-display-accent">{sectorLabel(s, lang)}</li>)}
    </ul>
    <Heading class:list={['mt-3 text-xl leading-snug font-semibold text-[#0b1631]', variant === 'text' && 'display !text-2xl !font-medium']}>
      <a href={href} class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">
        {d.title}
      </a>
    </Heading>
    <p class="mt-3 line-clamp-4 text-[0.95rem] leading-relaxed text-[#5b6478]">{d.summary}</p>
    <div class="mt-auto flex flex-wrap items-center gap-2 pt-5 text-xs text-muted">
      {meta && <span>{meta}</span>}
      {d.illustrative && <span class="sample-badge">Illustrative</span>}
      {d.provisional && <span class="sample-badge" title={d.provisional}>Provisional</span>}
    </div>
  </div>
</article>
