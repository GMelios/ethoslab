---
/**
 * "The evaluation gap", direction B (warm and illustrated).
 * All wording comes from src/data/narratives/gap.ts; this file is layout only.
 * The two stakes cards open the two questions that the two real studies in the
 * proof answer, in the same order.
 */
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Illustration from '../../illustrations/Illustration.astro';
import EffectSizeChart from '../../EffectSizeChart.astro';
import PartnerGrid from '../../PartnerGrid.astro';
import GapIllustration from './GapIllustration.astro';
import Counterfactual from './Counterfactual.astro';
import BracketKey from './BracketKey.astro';
import { getGapStory } from '../../../data/narratives/gap';
import { localePath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

interface Props {
  lang: Locale;
  homeHref?: string;
}
const { lang, homeHref } = Astro.props;
const s = await getGapStory(lang);
const { multipod: mp, pip } = s;
const stepIll = ['listen', 'test', 'explain'] as const;
const onAccentBadge = 'sample-badge !border-on-accent/50 !text-on-accent/85';
---

<Base title={s.meta.title} description={s.meta.description} lang={lang} theme="b" path="/" homeHref={homeHref}>
  <!-- 1. Hook: launched is not the same as working -->
  <section class="overflow-hidden" aria-labelledby="gap-hero-heading">
    <div class="wrap grid items-center gap-8 pt-10 pb-12 md:gap-12 md:pt-20 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-10 lg:pb-24">
      <div>
        <p class="eyebrow text-accent">{s.hero.eyebrow}</p>
        <h1 id="gap-hero-heading" class="display mt-5 text-[2.7rem] text-ink sm:text-6xl lg:text-[4.2rem]">
          {s.hero.title.map((p) => (p.accent ? <span class="text-accent">{p.text}</span> : p.text))}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink/80">{s.hero.lead}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-4">
          <a href={localePath(lang, s.hero.primary.path)} class="btn btn-primary !px-6">{s.hero.primary.label}</a>
          <a href={s.hero.secondary.href} class="inline-flex items-center gap-2 font-semibold text-ink underline decoration-highlight decoration-2 underline-offset-[6px] hover:decoration-accent">
            {s.hero.secondary.label} <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <!-- The programme report: everything ticked except the one line that matters -->
      <div class="relative mx-auto w-full max-w-[30rem] px-5 pt-8 pb-10 sm:px-10">
        <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M8 70C0 44 10 16 38 8s58 0 62 30-4 54-34 60S14 94 8 70z" fill="var(--t-accent-soft)" />
        </svg>
        <GapIllustration name="sun" class="absolute -top-1 right-0 w-16 sm:w-24" />
        <div class="relative">
          <div class="absolute inset-0 translate-x-2 translate-y-2 rotate-[3deg] rounded-[22px] border-[2.5px] border-ink bg-highlight" aria-hidden="true"></div>
          <div class="relative -rotate-[1.5deg] rounded-[22px] border-[2.5px] border-ink bg-paper px-5 pt-7 pb-5 sm:px-8 sm:pb-6">
            <GapIllustration name="clip" class="absolute -top-4 left-1/2 w-20 -translate-x-1/2" />
            <p class="text-xl font-extrabold text-ink">{s.hero.report.title}</p>
            <ul class="mt-4 space-y-3" role="list">
              {
                s.hero.report.rows.map((r) => (
                  <li class:list={['flex items-center gap-3', !r.known && 'mt-4 border-t-2 border-dashed border-ink/25 pt-4']}>
                    {r.known ? (
                      <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border-2 border-ink bg-accent-soft" aria-hidden="true">
                        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="var(--t-ink)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
                      </span>
                    ) : (
                      <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border-2 border-dashed border-accent text-sm font-extrabold text-accent" aria-hidden="true">?</span>
                    )}
                    <span class:list={['flex-1 leading-snug', r.known ? 'text-ink/80' : 'font-bold text-ink']}>{r.label}</span>
                    <span class:list={['shrink-0 rounded-full px-2.5 py-0.5 text-xs font-bold', r.known ? 'text-muted' : 'bg-accent text-on-accent']}>{r.status}</span>
                  </li>
                ))
              }
            </ul>
            <p class="mt-5 text-[0.95rem] font-bold text-ink underline decoration-highlight decoration-[3px] underline-offset-4">{s.hero.report.footnote}</p>
          </div>
        </div>
        <GapIllustration name="magnifier" class="absolute -bottom-2 left-0 w-16 sm:-left-2 sm:w-24" />
        <GapIllustration name="sparkle" class="absolute top-14 left-2 w-6" />
      </div>
    </div>
  </section>

  <!-- 2. Stakes: two quiet failures, each an open question -->
  <section class="wrap pb-12 md:pb-24" aria-labelledby="gap-stakes-heading">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow text-accent">{s.stakes.eyebrow}</p>
      <h2 id="gap-stakes-heading" class="display mt-4 text-3xl text-ink md:text-[2.6rem]">{s.stakes.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink/75">{s.stakes.lead}</p>
    </div>
    <ol class="mx-auto mt-10 grid max-w-5xl gap-5 md:grid-cols-2" role="list">
      {
        s.stakes.items.map((it) => (
          <li class="flex flex-col rounded-card bg-surface p-6 md:p-8">
            <div class="flex items-start justify-between gap-4">
              <span class="rounded-full bg-paper px-3 py-1 text-xs font-bold text-accent">{it.thread}</span>
              <GapIllustration name={it.id} class="h-20 w-auto md:h-28" />
            </div>
            <h3 class="mt-4 text-xl leading-snug font-extrabold text-ink">{it.title}</h3>
            <p class="mt-3 flex-1 text-[0.97rem] leading-relaxed text-ink/75">{it.body}</p>
            <p class="mt-5 flex items-start gap-3 rounded-[18px] border-2 border-dashed border-ink/25 px-3.5 py-3 text-sm leading-snug">
              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-highlight text-xs font-extrabold text-ink" aria-hidden="true">?</span>
              <span><span class="font-bold text-ink">{s.stakes.unknownLabel}:</span> <span class="text-ink/75">{it.unknown}</span></span>
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 3. Turn: before and after vs with and without, on one schematic -->
  <section class="bg-surface theme-b:mx-3 theme-b:rounded-card" aria-labelledby="gap-turn-heading">
    <div class="wrap py-12 md:py-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow text-accent">{s.turn.eyebrow}</p>
        <h2 id="gap-turn-heading" class="display mt-4 text-3xl text-ink md:text-[2.6rem]">{s.turn.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink/75">{s.turn.lead}</p>
      </div>
      <div class="mt-10 grid items-center gap-5 lg:grid-cols-12">
        <div class="rounded-card bg-paper px-5 py-7 md:p-10 lg:col-span-7">
          <Counterfactual variant="b" labels={s.turn.chart} describe={s.turn.chart.describe} class="flex justify-center" />
          <p class="mt-4 text-center text-sm text-muted">{s.turn.chart.caption}</p>
        </div>
        <div class="grid gap-4 lg:col-span-5">
          {
            s.turn.contrast.map((c, i) => (
              <div class:list={['flex gap-4 rounded-card bg-paper p-5 md:p-6', i === 1 && 'ring-[2.5px] ring-ink']}>
                <BracketKey kind={c.id} variant="b" class="mt-0.5" />
                <div>
                  <h3 class="text-xl font-extrabold text-ink">{c.title}</h3>
                  <p class="mt-1.5 leading-relaxed text-ink/75">{c.body}</p>
                  <p class:list={['mt-3 w-fit rounded-full px-3 py-1 text-sm font-bold', i === 1 ? 'bg-highlight text-ink' : 'bg-surface text-ink/75']}>{c.verdict}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <p class="mx-auto mt-10 max-w-2xl text-center text-xl leading-snug font-bold text-ink md:text-2xl">{s.turn.close}</p>
    </div>
  </section>

  <!-- 4. How -->
  <section class="wrap py-12 md:py-24" aria-labelledby="gap-how-heading">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow text-accent">{s.how.eyebrow}</p>
      <h2 id="gap-how-heading" class="display mt-4 text-3xl text-ink md:text-[2.6rem]">{s.how.title}</h2>
    </div>
    <ol class="relative mt-10 grid gap-8 md:mt-14 md:grid-cols-3">
      <svg class="pointer-events-none absolute top-14 right-[16%] left-[16%] hidden h-8 md:block" viewBox="0 0 600 30" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 15C100 3 200 3 300 15S500 27 600 15" fill="none" stroke="var(--t-ink)" stroke-width="2" stroke-dasharray="2 9" stroke-linecap="round" vector-effect="non-scaling-stroke" />
      </svg>
      {
        s.how.steps.map((st, i) => (
          <li class="relative flex gap-5 md:flex-col md:items-center md:text-center">
            <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-surface md:h-36 md:w-36">
              <Illustration name={stepIll[i]} class="h-12 w-auto md:h-24" />
            </div>
            <div class="md:flex md:flex-col md:items-center">
              <p class="text-sm font-bold text-accent md:mt-6">{s.how.stepLabel} {i + 1}</p>
              <h3 class="mt-1 text-xl font-extrabold text-ink md:text-2xl">{st.title}</h3>
              <p class="mt-2 leading-relaxed text-ink/75 md:mx-auto md:mt-3 md:max-w-xs">{st.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 5. Proof: the two open questions, answered by real studies -->
  <section id="proof" class="scroll-mt-6 wrap pb-12 md:pb-24" aria-labelledby="gap-proof-heading">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow text-accent">{s.proof.eyebrow}</p>
      <h2 id="gap-proof-heading" class="display mt-4 text-3xl text-ink md:text-[2.6rem]">{s.proof.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink/75">{s.proof.lead}</p>
    </div>

    <ol class="mt-10 space-y-6" role="list">
      <!-- Case 1: MultiPoD -->
      <li>
        <article class="grid overflow-hidden rounded-card bg-accent text-on-accent lg:grid-cols-12 lg:grid-rows-[auto_1fr]" aria-labelledby="gap-case-understanding">
          <!-- Source order is the mobile reading order (question, evidence, conclusion); on desktop the conclusion sits under the figure. -->
          <div class="flex flex-col p-6 md:p-10 lg:col-span-5 lg:row-start-1">
            <p class="eyebrow flex flex-wrap items-center gap-3 text-on-accent/75">
              {mp.thread}
              {mp.provisional && <span class={onAccentBadge}>{s.proof.provisionalBadge}</span>}
            </p>
            <h3 id="gap-case-understanding" class="mt-4 text-2xl leading-snug font-extrabold">{mp.title}</h3>
            <p class="mt-1 text-sm text-on-accent/70">{mp.meta}</p>
            <p class="mt-5 rounded-[18px] border-2 border-dashed border-on-accent/35 px-4 py-3 text-sm leading-snug">
              <span class="font-bold">{s.proof.questionLabel}:</span> <span class="text-on-accent/85">{mp.question}</span>
            </p>
            <p class="mt-6 font-body text-6xl font-extrabold tracking-tight md:text-7xl">{mp.figure.value}</p>
            <p class="mt-2 max-w-sm text-lg leading-snug text-on-accent/85">{mp.figure.label}</p>
            <p class="mt-5 w-fit rounded-full bg-highlight px-3.5 py-1.5 text-sm font-bold text-ink">{mp.verdict}</p>
          </div>
          <div class="bg-paper p-6 text-ink md:p-10 lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1 lg:m-4 lg:rounded-[calc(var(--t-radius)-8px)]">
            <p class="text-[0.95rem] leading-relaxed text-ink/70">{mp.design}</p>
            <p class="mt-3 leading-relaxed text-ink/85">{mp.body}</p>
            <div class="mt-6">
              <EffectSizeChart results={mp.chart} lang={lang} compact />
            </div>
            <p class="mt-4 text-sm leading-relaxed text-muted">{mp.note}</p>
            <p class="mt-4 text-xs leading-relaxed text-muted" role="note">
              {mp.provisional && <><span class="sample-badge mr-1.5 align-middle">{s.proof.provisionalBadge}</span>{mp.provisional} </>}
              {mp.credit}
            </p>
            <a href={mp.href} class="mt-5 inline-flex items-center gap-2 font-semibold text-ink underline decoration-highlight decoration-2 underline-offset-[6px] hover:decoration-accent">
              {mp.readLabel} <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="flex flex-col justify-start p-6 md:px-10 md:py-9 lg:col-span-5 lg:row-start-2 lg:pt-0 lg:pb-10">
            <div class="lg:border-t-2 lg:border-dashed lg:border-on-accent/30 lg:pt-6">
              <p class="text-sm font-bold text-highlight">{s.proof.withoutLabel}</p>
              <p class="mt-1 text-xl leading-snug font-extrabold">{mp.without}</p>
              <p class="mt-5 text-sm leading-relaxed text-on-accent/85"><span class="font-bold text-on-accent">{mp.recommendsLabel}:</span> {mp.recommends}</p>
            </div>
          </div>
        </article>
      </li>

      <!-- Case 2: PIP working paper -->
      <li>
        <article class="grid overflow-hidden rounded-card bg-accent text-on-accent lg:grid-cols-12 lg:grid-rows-[auto_1fr]" aria-labelledby="gap-case-employment">
          <div class="flex flex-col p-6 md:p-10 lg:col-span-5 lg:row-start-1">
            <p class="eyebrow text-on-accent/75">{pip.thread}</p>
            <h3 id="gap-case-employment" class="mt-4 text-2xl leading-snug font-extrabold">{pip.title}</h3>
            <p class="mt-1 text-sm text-on-accent/70">{pip.meta}</p>
            <p class="mt-5 rounded-[18px] border-2 border-dashed border-on-accent/35 px-4 py-3 text-sm leading-snug">
              <span class="font-bold">{s.proof.questionLabel}:</span> <span class="text-on-accent/85">{pip.question}</span>
            </p>
            <div class="mt-6 rounded-[18px] border-2 border-dashed border-on-accent/35 px-4 py-4">
              <span class={onAccentBadge}>{s.proof.estimatesBadge}</span>
              <p class="mt-2 text-sm text-on-accent/85">{pip.slotLabel}</p>
            </div>
            <p class="mt-5 w-fit rounded-full bg-ink px-3.5 py-1.5 text-sm font-bold text-paper">{pip.verdict}</p>
          </div>
          <div class="bg-paper p-6 text-ink md:p-10 lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1 lg:m-4 lg:rounded-[calc(var(--t-radius)-8px)]">
            <p class="leading-relaxed text-ink/85">{pip.body}</p>
            <p class="mt-6 text-sm font-bold text-accent">{pip.highlightsLabel}</p>
            <ul class="mt-3 space-y-3" role="list">
              {
                pip.highlights.map((h) => (
                  <li class="flex gap-3 leading-relaxed text-ink/85">
                    <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full border-2 border-ink bg-highlight" aria-hidden="true" />
                    <span>{h}</span>
                  </li>
                ))
              }
            </ul>
            <p class="mt-5 leading-relaxed font-semibold text-ink">{pip.suggests}</p>
            <a href={pip.href} class="mt-5 inline-flex items-center gap-2 font-semibold text-ink underline decoration-highlight decoration-2 underline-offset-[6px] hover:decoration-accent" rel="noopener">
              {pip.readLabel} <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="flex flex-col justify-start p-6 md:px-10 md:py-9 lg:col-span-5 lg:row-start-2 lg:pt-0 lg:pb-10">
            <div class="lg:border-t-2 lg:border-dashed lg:border-on-accent/30 lg:pt-6">
              <p class="text-sm font-bold text-highlight">{s.proof.withoutLabel}</p>
              <p class="mt-1 text-xl leading-snug font-extrabold">{pip.without}</p>
            </div>
          </div>
        </article>
      </li>
    </ol>
  </section>

  <!-- 6. Who -->
  <section class="wrap pb-10 md:pb-14" aria-labelledby="gap-who-heading">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow text-accent">{s.who.eyebrow}</p>
      <h2 id="gap-who-heading" class="display mt-4 text-3xl text-ink md:text-[2.6rem]">{s.who.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink/75">{s.who.lead}</p>
    </div>

    <dl class="mx-auto mt-10 grid max-w-4xl grid-cols-3 gap-3 md:gap-4">
      {
        s.whoData.stats.map((st) => (
          <div class="flex flex-col items-center rounded-card bg-surface px-3 py-5 text-center md:px-6 md:py-7">
            <dt class="order-2 mt-1.5 text-xs leading-snug text-ink/75 md:text-sm">{st.label}</dt>
            <dd class="order-1 text-3xl font-extrabold tracking-tight text-accent md:text-5xl">{st.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-12 flex flex-col items-center text-center">
      <h3 class="text-lg font-extrabold text-ink">{s.who.teamTitle}</h3>
      <ul class="mt-4 flex -space-x-2.5" role="list">
        {
          s.whoData.team.map((p) => (
            <li>
              <Image src={p.cover} alt={p.name} widths={[112, 224]} sizes="56px" class="aspect-square w-10 rounded-full border-[2.5px] border-paper object-cover ring-2 ring-ink md:w-14" />
            </li>
          ))
        }
      </ul>
      <a href={localePath(lang, s.who.teamLink.path)} class="mt-4 font-semibold text-ink underline decoration-highlight decoration-2 underline-offset-[6px] hover:decoration-accent">{s.who.teamLink.label} <span aria-hidden="true">→</span></a>
    </div>

    <h3 class="mt-12 text-center text-lg font-extrabold text-ink">{s.who.partnersTitle}</h3>
    <PartnerGrid variant="strip" class="mt-6" />

    <h3 class="mt-12 text-center text-lg font-extrabold text-ink">{s.who.projectsTitle}</h3>
    <ul class="mx-auto mt-4 flex max-w-3xl flex-wrap justify-center gap-2" role="list">
      {
        s.whoData.euProjects.map((p) => (
          <li>
            <a href={p.href} class="inline-block rounded-full bg-surface px-3.5 py-1.5 text-sm font-bold text-ink hover:bg-accent-soft">{p.name}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 7. Invite -->
  <section class="wrap pt-6 pb-14 md:pb-20" aria-labelledby="gap-invite-heading">
    <div class="grid items-center gap-6 rounded-card bg-surface px-6 py-10 md:grid-cols-[1fr_auto] md:gap-8 md:px-14 md:py-12">
      <div>
        <p class="eyebrow text-accent">{s.invite.eyebrow}</p>
        <h2 id="gap-invite-heading" class="display mt-4 max-w-2xl text-3xl text-ink md:text-5xl">{s.invite.title}</h2>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-ink/75">{s.invite.body}</p>
        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-4">
          <a href={localePath(lang, s.invite.primary.path)} class="btn btn-primary !px-6">{s.invite.primary.label}</a>
          <a href={localePath(lang, s.invite.secondary.path)} class="inline-flex items-center gap-2 font-semibold text-ink underline decoration-highlight decoration-2 underline-offset-[6px] hover:decoration-accent">
            {s.invite.secondary.label} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <Illustration name="plane" class="hidden w-56 md:block md:w-72" />
    </div>
  </section>
</Base>
