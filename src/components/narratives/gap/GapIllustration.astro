---
/**
 * Line illustrations for the evaluation-gap story in direction B, drawn in the
 * same style as components/illustrations/Illustration.astro: monoline ink
 * strokes (2.5, round caps), fills from theme tokens. Decorative: aria-hidden.
 *
 *   understanding  a reader puzzling over pages of text (published is not understood)
 *   employment     a level balance: a benefit on one pan, a briefcase on the other
 *   sun, magnifier, clip, sparkle   small pieces for the hero composition
 */
interface Props {
  name: 'understanding' | 'employment' | 'sun' | 'magnifier' | 'clip' | 'sparkle';
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---

{
  name === 'understanding' && (
    <svg viewBox="0 0 160 120" class:list={['gi', className]} aria-hidden="true">
      <path class="f-soft no-stroke" d="M12 106c6-32 34-54 70-54s62 22 68 54z" />
      <!-- three pages of legal text -->
      <rect class="f-soft" x="92" y="26" width="40" height="56" rx="3" transform="rotate(12 112 54)" />
      <rect class="f-paper" x="88" y="24" width="40" height="56" rx="3" transform="rotate(5 108 52)" />
      <g transform="rotate(-4 104 50)">
        <rect class="f-paper" x="84" y="22" width="40" height="58" rx="3" />
        <path d="M91 32h26M91 39h22M91 46h26M91 53h18M91 60h26M91 67h14" stroke-width="2" />
      </g>
      <!-- resident -->
      <path class="f-sun" d="M26 106V88c0-12 10-22 22-22s22 10 22 22v18" />
      <circle class="f-paper" cx="48" cy="44" r="12" />
      <circle class="ink no-stroke" cx="44" cy="43" r="1.6" />
      <circle class="ink no-stroke" cx="52" cy="43" r="1.6" />
      <path d="M45 50q3-2 6 0" stroke-width="2" />
      <path d="M66 82c6-2 12-7 17-14" />
      <!-- question -->
      <path d="M18 14c0-5 4-8 8-8s8 3 8 7c0 5-7 5-7 10" stroke-width="3" />
      <circle class="f-accent no-stroke" cx="27" cy="29" r="2.6" />
      <path d="M8 106h144" />
    </svg>
  )
}
{
  name === 'employment' && (
    <svg viewBox="0 0 160 120" class:list={['gi', className]} aria-hidden="true">
      <path class="f-soft no-stroke" d="M16 106c6-32 32-54 64-54s58 22 64 54z" />
      <!-- stand -->
      <path class="f-paper" d="M67 104h26l-5-11H72z" />
      <path d="M52 104h56M80 93V38" />
      <!-- level beam -->
      <path d="M30 38H130" stroke-width="3" />
      <circle class="f-accent" cx="80" cy="36" r="5" />
      <!-- left pan: the benefit -->
      <path d="M30 38L18 70M30 38l12 32" />
      <path class="f-paper" d="M12 70h36c-3 9-10 14-18 14s-15-5-18-14z" />
      <circle class="f-sun" cx="30" cy="61" r="8.5" />
      <path d="M33.8 57.2a5 5 0 1 0 0 7.6" stroke-width="1.8" />
      <path d="M25.2 60h5.2M25.2 62.6h5.2" stroke-width="1.8" />
      <!-- right pan: work -->
      <path d="M130 38l-12 32M130 38l12 32" />
      <path class="f-paper" d="M112 70h36c-3 9-10 14-18 14s-15-5-18-14z" />
      <rect class="f-soft" x="120" y="56" width="20" height="14" rx="2.5" />
      <path d="M126 56v-3.5h8V56M120 62h20" stroke-width="2" />
      <!-- question -->
      <path d="M74 12c0-4.5 3-7 6-7s6 2.5 6 6c0 4.5-6 4.5-6 9" stroke-width="2.6" />
      <circle class="f-accent no-stroke" cx="80" cy="25.5" r="2.2" />
      <path class="f-sun" d="M140 20l2.5 5.5 5.5 2.5-5.5 2.5-2.5 5.5-2.5-5.5-5.5-2.5 5.5-2.5z" />
    </svg>
  )
}
{
  name === 'sun' && (
    <svg viewBox="0 0 100 100" class:list={['gi', className]} aria-hidden="true">
      <circle class="f-sun" cx="50" cy="50" r="22" />
      <path d="M50 12v-8M50 96v-8M12 50h-8M96 50h-8M23 23l-6-6M83 83l-6-6M77 23l6-6M17 83l6-6" />
    </svg>
  )
}
{
  name === 'magnifier' && (
    <svg viewBox="0 0 100 100" class:list={['gi', className]} aria-hidden="true">
      <circle class="f-paper" cx="42" cy="42" r="28" />
      <path d="M62 62l26 26" stroke-width="7" />
      <path d="M34 34c0-6 4-9 8.5-9s8.5 3 8.5 8c0 6-8 6-8 12" stroke-width="3" />
      <circle class="f-accent no-stroke" cx="42.5" cy="55" r="3" />
    </svg>
  )
}
{
  name === 'clip' && (
    <svg viewBox="0 0 80 32" class:list={['gi', className]} aria-hidden="true">
      <path class="f-accent" d="M14 30V14a6 6 0 0 1 6-6h10a10 10 0 0 1 20 0h10a6 6 0 0 1 6 6v16z" />
      <circle class="f-paper" cx="40" cy="8" r="3.5" />
    </svg>
  )
}
{
  name === 'sparkle' && (
    <svg viewBox="0 0 24 24" class:list={['gi', className]} aria-hidden="true">
      <path class="f-sun" d="M12 2l3 7 7 3-7 3-3 7-3-7-7-3 7-3z" />
    </svg>
  )
}

<style>
  .gi {
    fill: none;
    stroke: var(--t-ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  .gi :global(.no-stroke) {
    stroke: none;
  }
  .f-soft {
    fill: var(--t-accent-soft);
  }
  .f-sun {
    fill: var(--t-highlight);
  }
  .f-accent {
    fill: var(--t-accent);
  }
  .f-paper {
    fill: var(--t-paper);
  }
  .ink {
    fill: var(--t-ink);
  }
</style>
