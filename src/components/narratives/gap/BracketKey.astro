---
/**
 * Legend mark for Counterfactual.astro: a small bracket drawn in the same style
 * as the chart's "before and after" (dashed) or "with and without" (highlighted)
 * bracket. Decorative; the card title next to it carries the meaning.
 */
interface Props {
  kind: 'before-after' | 'with-without';
  variant: 'b' | 'c';
  class?: string;
}
const { kind, variant, class: className = '' } = Astro.props;
---

<svg viewBox="0 0 20 32" class:list={['bk', `bk--${variant}`, `bk--${kind}`, className]} aria-hidden="true">
  {kind === 'with-without' && <rect class="bk-band" x="5" y="3" width="12" height="26" rx="5" />}
  <path class="bk-line" d="M6 4H11V28H6" />
</svg>

<style>
  .bk {
    width: 1.25rem;
    height: 2rem;
    flex: none;
    overflow: visible;
  }
  .bk-line {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bk--b .bk-line {
    stroke: var(--t-ink);
    stroke-width: 2.5;
  }
  .bk--b .bk-band {
    fill: var(--t-highlight);
  }
  .bk--c .bk-line {
    stroke: var(--t-chart);
    stroke-width: 1.75;
  }
  .bk--c .bk-band {
    fill: var(--t-accent-soft);
  }
  .bk--before-after .bk-line {
    stroke-dasharray: 3 5;
  }
  .bk--c.bk--before-after .bk-line {
    stroke: var(--t-muted);
  }
</style>
