---
/**
 * "The evaluation gap", direction C (data-forward).
 * All wording comes from src/data/narratives/gap.ts; this file is layout only.
 * The gap is drawn as missing numbers: a report with one untested line, then
 * two "?" tiles, which the two real studies in the proof answer in order.
 */
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import EffectSizeChart from '../../EffectSizeChart.astro';
import PartnerGrid from '../../PartnerGrid.astro';
import Counterfactual from './Counterfactual.astro';
import BracketKey from './BracketKey.astro';
import { getGapStory } from '../../../data/narratives/gap';
import { localePath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

interface Props {
  lang: Locale;
  homeHref?: string;
}
const { lang, homeHref } = Astro.props;
const s = await getGapStory(lang);
const { multipod: mp, pip } = s;
const pad = (n: number) => String(n).padStart(2, '0');
// Decorative fill lengths for the reported rows of the programme report.
const bars = ['82%', '64%', '91%'];
const label = 'font-label text-[0.65rem] font-semibold tracking-wider uppercase';
---

<Base title={s.meta.title} description={s.meta.description} lang={lang} theme="c" path="/" homeHref={homeHref}>
  <!-- 1. Hook -->
  <section class="overflow-hidden" aria-labelledby="gap-hero-heading">
    <div class="wrap grid grid-cols-[minmax(0,1fr)] items-center gap-10 pt-12 pb-14 md:gap-14 md:pt-20 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:pb-24">
      <div>
        <p class="eyebrow text-accent">{s.hero.eyebrow}</p>
        <h1 id="gap-hero-heading" class="display mt-5 text-[2.8rem] text-ink sm:text-6xl lg:text-[4.1rem]">
          {s.hero.title.map((p) => (p.accent ? <span class="text-accent">{p.text}</span> : p.text))}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{s.hero.lead}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={localePath(lang, s.hero.primary.path)} class="btn btn-primary">{s.hero.primary.label}</a>
          <a href={s.hero.secondary.href} class="btn text-ink hover:text-accent">{s.hero.secondary.label} <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-x-10 -inset-y-8 -z-10 rounded-[2rem] bg-[radial-gradient(60%_60%_at_60%_40%,var(--t-accent-soft),transparent)]" aria-hidden="true"></div>
        <div class="rounded-card border border-line bg-paper shadow-[0_24px_60px_-24px_rgb(11_18_32/0.25)]">
          <div class="flex items-center gap-2 border-b border-line px-4 py-3">
            <span class="h-2.5 w-2.5 rounded-full bg-line"></span><span class="h-2.5 w-2.5 rounded-full bg-line"></span><span class="h-2.5 w-2.5 rounded-full bg-line"></span>
            <p class="ml-3 truncate font-label text-[0.7rem] tracking-wide text-muted uppercase">{s.hero.report.title}</p>
          </div>
          <ul class="divide-y divide-line px-5 md:px-6" role="list">
            {
              s.hero.report.rows.map((r, i) => (
                <li class="py-3 md:py-3.5">
                  <div class="flex items-center justify-between gap-4">
                    <span class:list={['text-[0.95rem]', r.known ? 'text-ink' : 'font-semibold text-ink']}>{r.label}</span>
                    <span class:list={['inline-flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-1', label, r.known ? 'bg-surface text-muted' : 'border border-dashed border-accent bg-accent-soft text-accent']}>
                      {r.known ? (
                        <svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M3 8.5l3 3 7-7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      ) : (
                        <span class="grid h-3.5 w-3.5 place-items-center rounded-full bg-accent text-[0.55rem] leading-none text-on-accent" aria-hidden="true">?</span>
                      )}
                      {r.status}
                    </span>
                  </div>
                  {r.known ? (
                    <div class="mt-2.5 h-2 rounded-full bg-surface" aria-hidden="true"><div class="h-2 rounded-full bg-ink/70" style={`width:${bars[i]}`} /></div>
                  ) : (
                    <div class="mt-2.5 flex h-11 items-center justify-center rounded-control border border-dashed border-accent/60 bg-[repeating-linear-gradient(135deg,transparent_0_8px,var(--t-accent-soft)_8px_9px)] font-display text-2xl font-semibold text-accent" aria-hidden="true">?</div>
                  )}
                </li>
              ))
            }
          </ul>
          <p class="border-t border-line px-5 py-3.5 font-label text-[0.72rem] text-muted md:px-6">{s.hero.report.footnote}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Stakes: two unknowns -->
  <section class="border-y border-line bg-surface/60" aria-labelledby="gap-stakes-heading">
    <div class="wrap py-12 md:py-24">
      <div class="grid gap-5 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow text-accent">{s.stakes.eyebrow}</p>
          <h2 id="gap-stakes-heading" class="display mt-4 text-3xl text-ink md:text-[2.6rem]">{s.stakes.title}</h2>
        </div>
        <p class="text-lg leading-relaxed text-muted lg:col-span-5">{s.stakes.lead}</p>
      </div>
      <ol class="mt-10 grid grid-cols-1 gap-px overflow-hidden rounded-card border border-line bg-line md:grid-cols-2" role="list">
        {
          s.stakes.items.map((it, i) => (
            <li class="flex flex-col bg-paper p-5 md:p-8">
              <div class="flex items-center justify-between gap-4">
                <p class="eyebrow text-accent">{pad(i + 1)} · {it.thread}</p>
                <span class:list={['rounded-full border border-dashed border-accent bg-accent-soft px-2.5 py-1 text-accent', label]}>{s.stakes.unknownLabel}</span>
              </div>
              <div class="mt-5 flex items-end gap-4 border-b border-dashed border-line pb-5">
                <span class="font-display text-5xl leading-none font-semibold text-accent/35 md:text-6xl" aria-hidden="true">?</span>
                <p class="text-sm leading-snug text-ink/80"><span class="sr-only">{s.stakes.unknownLabel}: </span>{it.unknown}</p>
              </div>
              <h3 class="mt-6 text-xl leading-snug font-semibold text-ink">{it.title}</h3>
              <p class="mt-2.5 leading-relaxed text-muted">{it.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 3. Turn -->
  <section class="wrap py-12 md:py-24" aria-labelledby="gap-turn-heading">
    <div class="max-w-3xl">
      <p class="eyebrow text-accent">{s.turn.eyebrow}</p>
      <h2 id="gap-turn-heading" class="display mt-4 text-3xl text-ink md:text-[2.6rem]">{s.turn.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">{s.turn.lead}</p>
    </div>
    <div class="mt-10 grid items-center gap-5 lg:grid-cols-12 lg:gap-8">
      <div class="rounded-card border border-line bg-paper px-5 py-7 shadow-[0_18px_40px_-24px_rgb(11_18_32/0.2)] md:p-10 lg:col-span-7">
        <Counterfactual variant="c" labels={s.turn.chart} describe={s.turn.chart.describe} class="flex justify-center" />
        <p class="mt-4 font-label text-[0.68rem] tracking-wide text-muted uppercase">{s.turn.chart.caption}</p>
      </div>
      <div class="grid gap-4 lg:col-span-5">
        {
          s.turn.contrast.map((c, i) => (
            <div class:list={['flex gap-4 rounded-card border bg-paper p-5 md:p-6', i === 1 ? 'border-accent' : 'border-line']}>
              <BracketKey kind={c.id} variant="c" class="mt-1" />
              <div>
                <p class:list={[label, i === 1 ? 'text-accent' : 'text-muted']}>{c.verdict}</p>
                <h3 class="mt-2 text-xl font-semibold text-ink">{c.title}</h3>
                <p class="mt-1.5 leading-relaxed text-muted">{c.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <p class="mt-8 max-w-3xl border-l-2 border-accent pl-5 text-lg leading-snug font-semibold text-ink md:mt-10 md:text-2xl">{s.turn.close}</p>
  </section>

  <!-- 4. How -->
  <section class="border-y border-line bg-surface/60" aria-labelledby="gap-how-heading">
    <div class="wrap py-12 md:py-24">
      <p class="eyebrow text-accent">{s.how.eyebrow}</p>
      <h2 id="gap-how-heading" class="display mt-4 max-w-2xl text-3xl text-ink md:text-[2.6rem]">{s.how.title}</h2>
      <ol class="mt-8 grid gap-7 md:mt-10 md:grid-cols-3 md:gap-8" role="list">
        {
          s.how.steps.map((st, i) => (
            <li class="flex flex-col border-t-2 border-ink pt-5">
              <p class="font-label text-xs font-semibold tracking-wider text-accent uppercase">{s.how.stepLabel} {pad(i + 1)}</p>
              <h3 class="mt-2.5 text-xl font-semibold text-ink">{st.title}</h3>
              <p class="mt-2.5 leading-relaxed text-muted">{st.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 5. Proof: the "?" tiles, answered -->
  <section id="proof" class="scroll-mt-6 wrap py-12 md:py-24" aria-labelledby="gap-proof-heading">
    <div class="max-w-3xl">
      <p class="eyebrow text-accent">{s.proof.eyebrow}</p>
      <h2 id="gap-proof-heading" class="display mt-4 text-3xl text-ink md:text-[2.6rem]">{s.proof.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">{s.proof.lead}</p>
    </div>

    <ol class="mt-8 space-y-6 md:mt-10 md:space-y-8" role="list">
      <!-- Case 1: MultiPoD -->
      <li>
        <article class="grid gap-8 rounded-card border border-line p-5 md:p-8 lg:grid-cols-12 lg:gap-12" aria-labelledby="gap-case-understanding">
          <div class="lg:col-span-5">
            <p class="flex flex-wrap items-center gap-3">
              <span class="eyebrow text-accent">01 · {mp.thread}</span>
              {mp.provisional && <span class="sample-badge">{s.proof.provisionalBadge}</span>}
            </p>
            <h3 id="gap-case-understanding" class="mt-4 text-2xl font-semibold text-ink">{mp.title}</h3>
            <p class="mt-1 font-label text-[0.72rem] text-muted">{mp.meta}</p>
            <p class="mt-5 flex items-start gap-3 rounded-control bg-surface px-4 py-3 text-sm leading-snug">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full border border-dashed border-accent font-label text-[0.65rem] text-accent" aria-hidden="true">?</span>
              <span><span class:list={['text-muted', label]}>{s.proof.questionLabel}</span><br />{mp.question}</span>
            </p>
            <div class="mt-6 flex flex-wrap items-end gap-x-4 gap-y-3">
              <p class="font-display text-5xl leading-none font-semibold tracking-tight text-accent md:text-6xl">{mp.figure.value}</p>
              <p class:list={['rounded-full bg-accent px-2.5 py-1 text-on-accent', label]}>{mp.verdict}</p>
            </div>
            <p class="mt-3 text-muted">{mp.figure.label}</p>
            <p class="mt-5 text-[0.95rem] leading-relaxed text-muted">{mp.design}</p>
            <p class="mt-3 leading-relaxed text-ink">{mp.body}</p>
          </div>
          <div class="flex flex-col lg:col-span-7">
            <div class="rounded-card bg-surface/70 p-4 md:p-6">
              <EffectSizeChart results={mp.chart} lang={lang} compact />
              <p class="mt-4 border-t border-line pt-4 text-sm leading-relaxed text-muted">{mp.note}</p>
            </div>
            <p class="mt-5 text-sm leading-relaxed text-ink"><span class:list={['mr-1 text-accent', label]}>{mp.recommendsLabel}</span> {mp.recommends}</p>
            <p class="mt-4 text-xs leading-relaxed text-muted" role="note">
              {mp.provisional && <><span class="sample-badge mr-1.5 align-middle">{s.proof.provisionalBadge}</span>{mp.provisional} </>}
              {mp.credit}
            </p>
            <div class="mt-6 flex flex-wrap items-end justify-between gap-5">
              <div class="border-l-2 border-accent pl-4">
                <p class:list={['text-accent', label]}>{s.proof.withoutLabel}</p>
                <p class="mt-1 text-lg leading-snug font-semibold text-ink">{mp.without}</p>
              </div>
              <a href={mp.href} class="inline-flex shrink-0 items-center gap-2 font-semibold text-ink hover:text-accent">{mp.readLabel} <span aria-hidden="true">›</span></a>
            </div>
          </div>
        </article>
      </li>

      <!-- Case 2: PIP working paper -->
      <li>
        <article class="grid gap-8 rounded-card border border-line p-5 md:p-8 lg:grid-cols-12 lg:gap-12" aria-labelledby="gap-case-employment">
          <div class="lg:col-span-5">
            <p class="eyebrow text-accent">02 · {pip.thread}</p>
            <h3 id="gap-case-employment" class="mt-4 text-2xl font-semibold text-ink">{pip.title}</h3>
            <p class="mt-1 font-label text-[0.72rem] text-muted">{pip.meta}</p>
            <p class="mt-5 flex items-start gap-3 rounded-control bg-surface px-4 py-3 text-sm leading-snug">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full border border-dashed border-accent font-label text-[0.65rem] text-accent" aria-hidden="true">?</span>
              <span><span class:list={['text-muted', label]}>{s.proof.questionLabel}</span><br />{pip.question}</span>
            </p>
            <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3">
              <div class="flex h-14 min-w-[9rem] items-center justify-center rounded-control border border-dashed border-accent/60 bg-[repeating-linear-gradient(135deg,transparent_0_8px,var(--t-accent-soft)_8px_9px)] px-3">
                <span class="sample-badge bg-paper">{s.proof.estimatesBadge}</span>
              </div>
              <p class:list={['rounded-full bg-ink px-2.5 py-1 text-paper', label]}>{pip.verdict}</p>
            </div>
            <p class="mt-3 text-muted">{pip.slotLabel}</p>
            <p class="mt-5 leading-relaxed text-ink">{pip.body}</p>
          </div>
          <div class="flex flex-col lg:col-span-7">
            <div class="rounded-card bg-surface/70 p-5 md:p-7">
              <p class:list={['text-accent', label]}>{pip.highlightsLabel}</p>
              <ol class="mt-4 space-y-4" role="list">
                {
                  pip.highlights.map((h, i) => (
                    <li class="grid grid-cols-[2rem_1fr] gap-2 leading-relaxed text-ink">
                      <span class="font-label text-xs text-muted">{pad(i + 1)}</span>
                      <span>{h}</span>
                    </li>
                  ))
                }
              </ol>
              <p class="mt-5 border-t border-line pt-4 leading-relaxed font-medium text-ink">{pip.suggests}</p>
            </div>
            <div class="mt-6 flex flex-wrap items-end justify-between gap-5">
              <div class="border-l-2 border-accent pl-4">
                <p class:list={['text-accent', label]}>{s.proof.withoutLabel}</p>
                <p class="mt-1 text-lg leading-snug font-semibold text-ink">{pip.without}</p>
              </div>
              <a href={pip.href} class="inline-flex shrink-0 items-center gap-2 font-semibold text-ink hover:text-accent" rel="noopener">{pip.readLabel} <span aria-hidden="true">›</span></a>
            </div>
          </div>
        </article>
      </li>
    </ol>
  </section>

  <!-- 6. Who -->
  <section class="border-t border-line bg-surface/60" aria-labelledby="gap-who-heading">
    <div class="wrap py-12 md:py-24">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-6">
          <p class="eyebrow text-accent">{s.who.eyebrow}</p>
          <h2 id="gap-who-heading" class="display mt-4 text-3xl text-ink md:text-[2.6rem]">{s.who.title}</h2>
          <p class="mt-4 text-lg leading-relaxed text-muted">{s.who.lead}</p>
        </div>
        <div class="self-end lg:col-span-6">
          <dl class="grid grid-cols-3 gap-px overflow-hidden rounded-card border border-line bg-line">
            {
              s.whoData.stats.map((st) => (
                <div class="flex flex-col bg-paper p-4 md:p-6">
                  <dt class="order-2 mt-2 text-xs leading-snug text-muted md:text-sm">{st.label}</dt>
                  <dd class="order-1 font-display text-3xl font-semibold tracking-tight text-ink md:text-5xl">{st.value}</dd>
                </div>
              ))
            }
          </dl>
          <h3 class:list={['mt-8 text-muted', label]}>{s.who.teamTitle}</h3>
          <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-3">
            <ul class="flex -space-x-2" role="list">
              {
                s.whoData.team.map((p) => (
                  <li>
                    <Image src={p.cover} alt={p.name} widths={[96, 192]} sizes="48px" class="aspect-square w-10 rounded-full border-2 border-paper object-cover md:w-12" />
                  </li>
                ))
              }
            </ul>
            <a href={localePath(lang, s.who.teamLink.path)} class="font-semibold text-ink hover:text-accent">{s.who.teamLink.label} <span aria-hidden="true">›</span></a>
          </div>
        </div>
      </div>

      <h3 class:list={['mt-10 text-center text-muted md:mt-14', label]}>{s.who.partnersTitle}</h3>
      <PartnerGrid variant="strip" class="mt-6" />

      <h3 class:list={['mt-8 text-center text-muted md:mt-12', label]}>{s.who.projectsTitle}</h3>
      <ul class="mx-auto mt-4 flex max-w-4xl flex-wrap justify-center gap-2" role="list">
        {
          s.whoData.euProjects.map((p) => (
            <li>
              <a href={p.href} class="inline-block rounded-control border border-line bg-paper px-3 py-1.5 text-sm font-medium text-ink hover:border-accent hover:text-accent">{p.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. Invite -->
  <section class="wrap py-12 md:py-24" aria-labelledby="gap-invite-heading">
    <div class="relative overflow-hidden rounded-card bg-inverse px-6 py-10 text-on-inverse md:px-14 md:py-20">
      <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-accent/40 blur-3xl" aria-hidden="true"></div>
      <p class="eyebrow text-on-inverse/60">{s.invite.eyebrow}</p>
      <h2 id="gap-invite-heading" class="display mt-4 max-w-2xl text-3xl md:text-5xl">{s.invite.title}</h2>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-on-inverse/75">{s.invite.body}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={localePath(lang, s.invite.primary.path)} class="btn btn-primary">{s.invite.primary.label}</a>
        <a href={localePath(lang, s.invite.secondary.path)} class="btn border border-on-inverse/30 text-on-inverse hover:border-on-inverse">{s.invite.secondary.label}</a>
      </div>
    </div>
  </section>
</Base>
