---
/** Direction B: the opening of one belief. Roman numeral, the view it argues against, the conviction. */
import '@fontsource-variable/alegreya/wght.css';
import BeliefIllustration from './BeliefIllustration.astro';
import type { BeliefsStory } from '../../../data/narratives/beliefs';

interface Props {
  belief: BeliefsStory['beliefs'][number];
  labels: BeliefsStory['labels'];
  /** Section sits on the surface band: flip the fills so shapes stay visible. */
  onSurface?: boolean;
  reverse?: boolean;
}
const { belief, labels, onSurface = false, reverse = false } = Astro.props;
const ill = belief.id as 'intentions' | 'nulls' | 'uncertainty' | 'decisions';
const disc = onSurface ? 'bg-paper' : 'bg-surface';
---

<div class="grid items-center gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:gap-14">
  <div class:list={['max-w-2xl', reverse && 'md:order-2']}>
    <div class="flex items-center justify-between gap-6 md:justify-start">
      <span aria-hidden="true" class="numeral block text-[6rem] leading-[0.8] font-extrabold text-accent md:text-[9rem]">{belief.numeral}</span>
      <span class:list={['flex h-28 w-28 shrink-0 items-center justify-center rounded-full md:hidden', disc]}>
        <BeliefIllustration name={ill} class="w-[76%]" />
      </span>
    </div>
    <p class:list={['bubble relative mt-6 w-fit max-w-md rounded-[1.25rem] px-5 py-3 text-[0.95rem] leading-snug text-ink/70', disc]}>
      <span class="mb-1 block text-[0.7rem] font-bold tracking-[0.06em] text-muted uppercase">{labels.comfortable}</span>
      <s class="decoration-accent decoration-2">{belief.comfortable}</s>
    </p>
    <h2 id={`belief-${belief.id}-title`} class="display mt-7 text-[2.5rem] text-ink md:text-6xl">
      <span class="sr-only">{labels.belief} {belief.index}: </span>{belief.title}
    </h2>
    <p class="mt-6 text-lg leading-relaxed text-ink/80 md:text-xl md:leading-relaxed">{belief.body}</p>
  </div>
  <div class:list={['hidden h-72 w-72 shrink-0 items-center justify-center rounded-full md:flex', disc, reverse && 'md:order-1']}>
    <BeliefIllustration name={ill} class="w-[74%]" />
  </div>
</div>

<style>
  .numeral {
    font-family: 'Alegreya Variable', Georgia, serif;
    letter-spacing: -0.02em;
  }
  /* Speech-bubble tail pointing up at the numeral. */
  .bubble::before {
    content: '';
    position: absolute;
    left: 2.25rem;
    top: -7px;
    width: 16px;
    height: 16px;
    background: inherit;
    transform: rotate(45deg);
    border-radius: 3px;
  }
</style>
