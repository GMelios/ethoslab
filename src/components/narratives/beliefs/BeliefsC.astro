---
/**
 * Narrative "What we believe", direction C (data-forward).
 * Four numbered theses; each sits beside a proof panel of stat tiles and
 * interval charts. Copy: src/data/narratives/beliefs.ts (shared with B).
 */
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import EffectSizeChart from '../../EffectSizeChart.astro';
import PartnerGrid from '../../PartnerGrid.astro';
import IntervalGlyph from './IntervalGlyph.astro';
import CHead from './CHead.astro';
import CBridge from './CBridge.astro';
import { getBeliefsStory } from '../../../data/narratives/beliefs';
import type { Locale } from '../../../i18n/config';

interface Props {
  lang: Locale;
  homeHref?: string;
}
const { lang, homeHref } = Astro.props;
const s = await getBeliefsStory(lang);
const { labels, hook, invite } = s;
const [bI, bII, bIII, bIV] = s.beliefs;
const total = s.beliefs.length;
const pI = s.intentions;
const pII = s.nulls;
const pIII = s.uncertainty;
const pIV = s.decisions;
const badge = labels.illustrative;
/** Keep hyphenated compounds ("evidence-based") on one line in the big headline. */
const keepHyphenated = (text: string) => text.split(/(\S+-\S+)/).filter(Boolean);
const pad = (n: number) => String(n).padStart(2, '0');

const panel = 'overflow-hidden rounded-card border border-line bg-paper shadow-[0_18px_40px_-24px_rgb(11_18_32/0.2)]';
const panelHead = 'flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-line px-5 py-3 font-label text-[0.68rem] font-semibold tracking-[0.08em] text-muted uppercase';
const link = 'inline-flex items-center gap-2 font-semibold text-ink hover:text-accent';
---

<Base title="Ethos Lab" description={s.meta.description} lang={lang} theme="c" path="/" homeHref={homeHref}>
  {
    hook.announcement && (
      <a slot="before-header" href={hook.announcement.href} rel="noopener" class="block bg-inverse text-on-inverse">
        <span class="wrap flex items-center justify-center gap-3 py-2.5 text-center text-sm">
          <span class="rounded bg-on-inverse px-1.5 py-0.5 font-label text-[0.65rem] font-bold tracking-wider text-inverse uppercase">{hook.announcement.tag}</span>
          <span class="line-clamp-2 sm:truncate">{hook.announcement.text}</span>
          <span aria-hidden="true">→</span>
        </span>
      </a>
    )
  }

  <!-- Hook -->
  <section class="overflow-hidden">
    <div class="wrap grid grid-cols-[minmax(0,1fr)] items-center gap-12 pt-14 pb-16 md:pt-20 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-14 lg:pb-24">
      <div>
        <p class="eyebrow text-accent">{hook.eyebrow}</p>
        <h1 class="display mt-5 text-[2.6rem] text-ink sm:text-6xl lg:text-[4rem]">
          {keepHyphenated(hook.title).map((part) => (/\S-\S/.test(part) ? <span class="whitespace-nowrap">{part}</span> : part))} <span class="text-accent">{hook.titleAccent}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{hook.lede}</p>
        <p class="mt-6 max-w-xl border-l-2 border-accent pl-4 text-lg leading-relaxed font-medium text-ink">{hook.stakes}</p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href={hook.primary.href} class="btn btn-primary">{hook.primary.label}</a>
          <a href={hook.secondary.href} class="btn text-ink hover:text-accent">{hook.secondary.label} <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <nav class="relative" aria-labelledby="toc-title">
        <div class="absolute -inset-x-10 -inset-y-8 -z-10 rounded-[2rem] bg-[radial-gradient(60%_60%_at_60%_40%,var(--t-accent-soft),transparent)]" aria-hidden="true"></div>
        <div class={panel}>
          <div class={panelHead}>
            <h2 id="toc-title">{hook.tocTitle}</h2>
            <span class="sample-badge ml-auto">{badge}</span>
          </div>
          <ol class="divide-y divide-line">
            {
              hook.toc.map((t) => (
                <li>
                  <a href={`#belief-${t.id}`} class="group grid grid-cols-[2.25rem_minmax(0,1fr)] items-center gap-x-4 gap-y-1 px-5 py-4 transition-colors hover:bg-surface sm:grid-cols-[2.5rem_minmax(0,1fr)_auto] md:py-5">
                    <span aria-hidden="true" class="row-span-2 self-start font-display text-2xl font-semibold tracking-tight text-accent tabular-nums sm:row-span-1 sm:self-center">{pad(t.index)}</span>
                    <span class="min-w-0">
                      <span class="block font-semibold text-ink group-hover:text-accent">{t.title}</span>
                      <span class="mt-0.5 block text-sm text-muted">{t.proof}</span>
                    </span>
                    <span class:list={['font-label text-sm font-semibold whitespace-nowrap text-ink tabular-nums sm:text-right', !t.metric && 'max-sm:hidden']}>
                      {t.metric ?? <span aria-hidden="true" class="text-accent">↓</span>}
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      </nav>
    </div>
  </section>

  <!-- I. Good intentions are not evidence -->
  <section id={`belief-${bI.id}`} class="scroll-mt-4 border-t border-line" aria-labelledby={`belief-${bI.id}-title`}>
    <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-10 pt-16 pb-12 md:pt-24 md:pb-16 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
      <CHead belief={bI} labels={labels} total={total} />
      <article class={panel}>
        <div class={panelHead}>
          <span>{labels.proof}: {pI.kicker}</span>
          <span class="sample-badge ml-auto">{badge}</span>
        </div>
        <div class="p-5 md:p-7">
          <h3 class="text-xl leading-snug font-semibold text-ink">{keepHyphenated(pI.heading).map((part) => (/\S-\S/.test(part) ? <span class="whitespace-nowrap">{part}</span> : part))}</h3>
          <p class="mt-2 font-label text-xs leading-relaxed text-muted">{pI.meta}</p>
          <dl class="mt-6 grid grid-cols-2 gap-3 xl:grid-cols-4">
            {
              pI.stats.map((st, i) => (
                <div class:list={['flex flex-col rounded-control p-3', i === 1 ? 'bg-accent-soft' : 'bg-surface']}>
                  <dt class="font-label text-[0.62rem] leading-snug tracking-wide text-muted uppercase">{st.label}</dt>
                  <dd class:list={['mt-1 text-2xl font-semibold tracking-tight tabular-nums', i === 1 ? 'text-accent' : 'text-ink']}>{st.value}</dd>
                  {st.note && <dd class="mt-0.5 text-xs leading-snug text-muted">{st.note}</dd>}
                </div>
              ))
            }
          </dl>
          <div class="mt-7">
            <EffectSizeChart results={pI.entry.data.results} lang={lang} groups={pI.chartGroups} compact />
          </div>
          <p class="mt-6 border-t border-line pt-5 leading-relaxed text-ink">{pI.takeaway}</p>
          <a href={pI.href} class:list={[link, 'mt-4']}>{labels.readCase} <span aria-hidden="true">›</span></a>
        </div>
      </article>
    </div>
    <CBridge text={bI.bridge} next={bII.index} />
  </section>

  <!-- II. A null result is a result -->
  <section id={`belief-${bII.id}`} class="scroll-mt-4 border-t border-line bg-surface/60" aria-labelledby={`belief-${bII.id}-title`}>
    <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-10 pt-16 pb-12 md:pt-24 md:pb-16 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
      <CHead belief={bII} labels={labels} total={total} />
      <div class="space-y-6">
        <article class={panel}>
          <div class={panelHead}>
            <span>{labels.proof}: {pII.mayor.kicker}</span>
            <span class="sample-badge ml-auto">{badge}</span>
          </div>
          <div class="p-5 md:p-7">
            <h3 class="text-xl leading-snug font-semibold text-ink">{pII.mayor.heading}</h3>
            <p class="mt-3 leading-relaxed text-muted">{pII.mayor.text}</p>
            <div class="mt-6">
              <EffectSizeChart results={pII.mayor.entry.data.results} lang={lang} groups={pII.mayor.chartGroups} compact />
            </div>
            <p class="mt-6 border-t border-line pt-5 font-medium text-ink">{pII.mayor.takeaway}</p>
            <a href={pII.mayor.href} class:list={[link, 'mt-4']}>{labels.readCase} <span aria-hidden="true">›</span></a>
          </div>
        </article>

        <article class={panel}>
          <div class={panelHead}>
            <span>{labels.proof}: {pII.helpline.kicker}</span>
            <span class="sample-badge ml-auto">{badge}</span>
          </div>
          <div class="p-5 md:p-7">
            <h3 class="text-xl leading-snug font-semibold text-ink">{pII.helpline.heading}</h3>
            <div class="mt-5 grid items-center gap-5 sm:grid-cols-[auto_minmax(0,1fr)]">
              <div class="rounded-control bg-surface p-3 sm:min-w-44">
                <p class="font-label text-[0.62rem] tracking-wide text-muted uppercase">{pII.helpline.statLabel}</p>
                <p class="mt-1 text-2xl font-semibold tracking-tight text-ink tabular-nums">{pII.helpline.stat}</p>
                <p class="mt-0.5 text-xs text-muted tabular-nums">{pII.helpline.statNote}</p>
              </div>
              <div>
                <IntervalGlyph estimate={pII.helpline.effect.estimate} ciLow={pII.helpline.effect.ciLow} ciHigh={pII.helpline.effect.ciHigh} domain={pII.helpline.axis.domain} ticks={pII.helpline.axis.ticks} />
                <p class="mt-1 text-center text-xs text-muted">{pII.helpline.unitLabel}</p>
              </div>
            </div>
            <p class="mt-5 leading-relaxed text-muted">{pII.helpline.text}</p>
            <p class="mt-5 border-t border-line pt-5 font-medium text-ink">{pII.helpline.takeaway}</p>
            <a href={pII.helpline.href} class:list={[link, 'mt-4']}>{labels.readCase} <span aria-hidden="true">›</span></a>
          </div>
        </article>

        {
          pII.paper && (
            <article class="rounded-card border border-accent/30 bg-accent-soft/50 p-5 md:p-7">
              <p class="eyebrow text-accent">{pII.paper.kicker}</p>
              <h3 class="mt-3 text-xl leading-snug font-semibold text-ink">{pII.paper.heading}</h3>
              <p class="mt-2 font-label text-xs text-muted">{pII.paper.meta}</p>
              <p class="mt-4 leading-relaxed text-muted">{pII.paper.text}</p>
              <a href={pII.paper.href} rel="noopener" class:list={[link, 'mt-4']}>{pII.paper.link} <span aria-hidden="true">↗</span></a>
            </article>
          )
        }
      </div>
    </div>
    <CBridge text={bII.bridge} next={bIII.index} />
  </section>

  <!-- III. Show the uncertainty -->
  <section id={`belief-${bIII.id}`} class="scroll-mt-4 border-t border-line" aria-labelledby={`belief-${bIII.id}-title`}>
    <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-10 pt-16 pb-12 md:pt-24 md:pb-16 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
      <CHead belief={bIII} labels={labels} total={total} />
      <article class={panel}>
        <div class={panelHead}>
          <span>{labels.proof}: {pIII.kicker}</span>
          <span class="sample-badge ml-auto">{badge}</span>
        </div>
        <div class="p-5 md:p-7">
          <h3 class="text-xl leading-snug font-semibold text-ink">{keepHyphenated(pIII.heading).map((part) => (/\S-\S/.test(part) ? <span class="whitespace-nowrap">{part}</span> : part))}</h3>
          <p class="mt-2 font-label text-xs leading-relaxed text-muted">{pIII.meta}</p>
          <div class="mt-6 rounded-control bg-accent-soft p-4">
            <p class="text-4xl font-semibold tracking-tight text-accent tabular-nums">{pIII.big}</p>
            <p class="mt-1 text-sm leading-snug text-ink">{pIII.bigLabel}</p>
          </div>
          <div class="mt-7">
            <EffectSizeChart results={pIII.entry.data.results} lang={lang} />
          </div>
          <ol class="mt-7 grid gap-px overflow-hidden rounded-control border border-line bg-line sm:grid-cols-2">
            {
              pIII.notes.map((n, i) => (
                <li class="bg-paper p-4">
                  <p class="flex items-baseline gap-2 text-sm font-semibold text-ink tabular-nums">
                    <span aria-hidden="true" class="font-label text-xs text-accent">[{i + 1}]</span>
                    {n.title}
                  </p>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted">{n.text}</p>
                </li>
              ))
            }
          </ol>
          <a href={pIII.href} class:list={[link, 'mt-6']}>{labels.readCase} <span aria-hidden="true">›</span></a>
        </div>
      </article>
    </div>
    <CBridge text={bIII.bridge} next={bIV.index} />
  </section>

  <!-- IV. Evidence should change decisions -->
  <section id={`belief-${bIV.id}`} class="scroll-mt-4 border-t border-line bg-surface/60" aria-labelledby={`belief-${bIV.id}-title`}>
    <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-10 pt-16 pb-12 md:pt-24 md:pb-16 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
      <CHead belief={bIV} labels={labels} total={total} />
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <h3 class="font-label text-xs font-semibold tracking-[0.08em] text-muted uppercase">{pIV.heading}</h3>
          <span class="sample-badge">{badge}</span>
        </div>
        <ol class="mt-4 space-y-4">
          {
            pIV.cases.map((c) => (
              <li class:list={[panel, 'grid gap-4 p-5 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-6 md:p-6']}>
                <div>
                  <a href={`#belief-${c.from.id}`} class="group inline-flex items-start gap-2 text-sm leading-snug font-medium text-muted hover:text-accent">
                    <span aria-hidden="true" class="rounded bg-accent-soft px-1.5 py-0.5 font-label text-[0.7rem] font-bold text-accent tabular-nums">{pad(c.from.index)}</span>
                    <span><span class="sr-only">{labels.from} {c.from.index}: </span>{c.from.title}</span>
                  </a>
                  <h4 class="mt-3 font-semibold text-ink">{c.name}</h4>
                </div>
                <div>
                  <p class="leading-relaxed text-ink">{c.text}</p>
                  <a href={c.href} class:list={[link, 'mt-3 text-sm']}>{labels.readCase} <span aria-hidden="true">›</span></a>
                </div>
              </li>
            ))
          }
        </ol>
        {
          pIV.tool && (
            <article class:list={[panel, 'mt-6 grid md:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)]']}>
              <div class="p-5 md:p-7">
                <p class="eyebrow flex flex-wrap items-center gap-3 text-accent">
                  {pIV.tool.kicker}
                  {pIV.tool.placeholder && <span class="sample-badge">{labels.draft}</span>}
                </p>
                <h3 class="mt-3 text-xl font-semibold text-ink">{pIV.tool.heading}</h3>
                <p class="mt-3 leading-relaxed text-muted">{pIV.tool.text}</p>
                <a href={pIV.tool.href} class:list={[link, 'mt-4']}>{pIV.tool.link} <span aria-hidden="true">›</span></a>
              </div>
              {pIV.tool.cover && (
                <div class="border-t border-line bg-surface md:border-t-0 md:border-l">
                  <Image src={pIV.tool.cover} alt={`${pIV.tool.heading} interface`} widths={[480, 900]} sizes="(min-width: 1024px) 380px, 92vw" class="h-full w-full object-cover object-left-top" />
                </div>
              )}
            </article>
          )
        }
      </div>
    </div>
    <CBridge text={bIV.bridge} />
  </section>

  <!-- Invitation -->
  <section class="border-t border-line" aria-labelledby="partners-title">
    <div class="wrap py-12">
      <h2 id="partners-title" class="text-center font-label text-xs font-semibold tracking-[0.12em] text-muted uppercase">{invite.partners}</h2>
      <PartnerGrid variant="strip" class="mt-8" />
    </div>
  </section>
  <section class="wrap pb-16 md:pb-24" aria-labelledby="invite-title">
    <div class="relative overflow-hidden rounded-card bg-inverse px-8 py-14 text-on-inverse md:px-14 md:py-20">
      <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-accent/40 blur-3xl" aria-hidden="true"></div>
      <p class="eyebrow text-on-inverse/60">{invite.eyebrow}</p>
      <h2 id="invite-title" class="display mt-4 max-w-3xl text-4xl md:text-6xl">{invite.title}</h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-on-inverse/80">{invite.body}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={invite.primary.href} class="btn btn-primary">{invite.primary.label}</a>
        <a href={invite.secondary.href} class="btn border border-on-inverse/30 text-on-inverse hover:border-on-inverse">{invite.secondary.label}</a>
      </div>
      <p class="mt-10 border-t border-on-inverse/15 pt-6 font-label text-sm text-on-inverse/60">{invite.aside}</p>
    </div>
  </section>
</Base>
