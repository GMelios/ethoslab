---
/** Direction C: the sentence that hands one thesis to the next, as a "therefore" row. */
interface Props {
  text: string;
  /** Index of the belief this leads to, or undefined for the close. */
  next?: number;
}
const { text, next } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="wrap pb-16 md:pb-24">
  <div class="mx-auto flex max-w-4xl items-start gap-4 rounded-card bg-inverse px-6 py-6 text-on-inverse md:items-center md:gap-6 md:px-8">
    <span aria-hidden="true" class="flex shrink-0 items-center gap-2 pt-0.5 font-label text-sm font-semibold text-on-inverse/60 md:pt-0">
      <svg viewBox="0 0 16 16" class="h-4 w-4 text-accent-soft" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v11M3 9l5 5 5-5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      {next !== undefined && <span class="tabular-nums">{pad(next)}</span>}
    </span>
    <p class="text-lg leading-snug font-medium md:text-xl">{text}</p>
  </div>
</div>
