---
/** Direction C: the opening of one belief, as a numbered thesis. Sticky beside its proof on wide screens (CSS only). */
import type { BeliefsStory } from '../../../data/narratives/beliefs';

interface Props {
  belief: BeliefsStory['beliefs'][number];
  labels: BeliefsStory['labels'];
  total: number;
}
const { belief, labels, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<header class="lg:sticky lg:top-8 lg:self-start">
  <div class="flex items-center gap-3 font-label text-xs tracking-[0.08em] uppercase" aria-hidden="true">
    <span class="font-semibold text-accent">{labels.belief}</span>
    <span class="h-px flex-1 bg-line"></span>
    <span class="text-muted tabular-nums">{pad(belief.index)} / {pad(total)}</span>
  </div>
  <p aria-hidden="true" class="mt-5 font-display text-[5.5rem] leading-[0.85] font-semibold tracking-[-0.05em] text-accent tabular-nums md:text-[8rem]">{pad(belief.index)}</p>
  <p class="mt-7 border-l-2 border-line pl-4 font-label text-[0.8rem] leading-relaxed text-muted">
    <span class="block text-[0.68rem] font-semibold tracking-[0.08em] uppercase">{labels.comfortable}</span>
    <s class="decoration-accent decoration-2">{belief.comfortable}</s>
  </p>
  <h2 id={`belief-${belief.id}-title`} class="display mt-6 text-[2.2rem] text-ink md:text-5xl">
    <span class="sr-only">{labels.belief} {belief.index}: </span>{belief.title}
  </h2>
  <p class="mt-5 text-lg leading-relaxed text-muted">{belief.body}</p>
</header>
