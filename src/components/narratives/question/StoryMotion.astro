---
/**
 * Gentle scroll reveals for the story. Progressive enhancement only:
 * - Content is fully visible without JavaScript and with reduced motion
 *   (the hidden state exists only under html.q-anim, which the script adds
 *   when motion is allowed and IntersectionObserver exists).
 * - [data-reveal] fades an element up once; [data-reveal-chart] also draws the
 *   confidence intervals of an EffectSizeChart from left to right.
 */
---

<script is:inline>
  (function () {
    var d = document.documentElement;
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    d.classList.add('q-anim');
    var run = function () {
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.setAttribute('data-revealed', '');
            io.unobserve(e.target);
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      document.querySelectorAll('[data-reveal],[data-reveal-chart]').forEach(function (el) {
        io.observe(el);
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
  })();
</script>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    html.q-anim [data-reveal] {
      transition:
        opacity 0.6s ease,
        transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    html.q-anim [data-reveal]:not([data-revealed]) {
      opacity: 0;
      transform: translateY(14px);
    }
    html.q-anim [data-reveal-chart] :is(.ec-line, .ec-strip) {
      transition: clip-path 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s;
    }
    html.q-anim [data-reveal-chart] .ec-point {
      transition: opacity 0.4s ease 0.7s;
    }
    html.q-anim [data-reveal-chart]:not([data-revealed]) :is(.ec-line, .ec-strip) {
      clip-path: inset(0 100% 0 0);
    }
    html.q-anim [data-reveal-chart]:not([data-revealed]) .ec-point {
      opacity: 0;
    }
  }
  @media print {
    html.q-anim [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
