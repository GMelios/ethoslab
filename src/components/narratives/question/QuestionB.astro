---
/**
 * "Follow one question", direction B: a storybook in five chapters, following
 * the real MultiPoD language experiment. Warm, illustrated, plain words.
 * Every string comes from src/data/narratives/question.ts; this file only
 * decides layout and visuals.
 */
import Base from '../../../layouts/Base.astro';
import EffectSizeChart from '../../EffectSizeChart.astro';
import PartnerGrid from '../../PartnerGrid.astro';
import Illustration from '../../illustrations/Illustration.astro';
import StoryIllustration from './StoryIllustration.astro';
import ChapterNav from './ChapterNav.astro';
import StoryMotion from './StoryMotion.astro';
import { getQuestionStory } from '../../../data/narratives/question';
import type { Locale } from '../../../i18n/config';

interface Props {
  lang: Locale;
  homeHref?: string;
}
const { lang, homeHref } = Astro.props;
const s = await getQuestionStory(lang);
const { hero, question: c1, design: c2, field: c3, findings: c4, decision: c5, turn, invite, ui } = s;

// Visual emphasis only: the last two words of the question in plum.
const words = hero.title.split(' ');
const titleHead = words.slice(0, -2).join(' ');
const titleTail = words.slice(-2).join(' ');
const second = turn.second;
---

<Base title={s.meta.title} description={s.meta.description} lang={lang} theme="b" path="/" homeHref={homeHref}>
  <StoryMotion />

  <!-- Hook -->
  <section class="wrap grid items-center gap-10 pt-10 pb-10 md:pt-14 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-8 lg:pb-10">
    <div>
      <p class="eyebrow text-accent">{hero.eyebrow}</p>
      <h1 class="display mt-5 text-[2.5rem] text-ink sm:text-[3.4rem] lg:text-[3.5rem]">
        {titleHead} <span class="text-accent">{titleTail}</span>
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink/80">{hero.lede}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href={hero.primary.href} class="btn btn-primary !px-6">{hero.primary.label} <span aria-hidden="true">↓</span></a>
        <a href={hero.secondary.href} class="inline-flex items-center gap-2 font-semibold text-ink underline decoration-highlight decoration-2 underline-offset-[6px] hover:decoration-accent">
          {hero.secondary.label}
        </a>
      </div>
      <p class="mt-8 flex max-w-lg items-start gap-2 text-xs leading-relaxed text-muted">
        <span class="sample-badge mt-0.5">{ui.provisional}</span>
        <span>{hero.note}</span>
      </p>
    </div>
    <StoryIllustration name="hook" class="mx-auto w-full max-w-[20rem] sm:max-w-[28rem]" />
  </section>

  <!-- The story -->
  <div class="wrap lg:grid lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-14 xl:gap-20">
    <div class="sticky top-0 z-20 -mx-4 border-b border-line bg-paper/95 px-4 backdrop-blur sm:-mx-6 sm:px-6 lg:hidden">
      <ChapterNav chapters={s.chapters} label={ui.chapterNav} variant="bar" />
    </div>
    <aside class="hidden lg:block">
      <div class="sticky top-10 pt-16">
        <p class="eyebrow text-muted">{hero.contentsLabel}</p>
        <ChapterNav chapters={s.chapters} label={ui.chapterNav} variant="rail" class="mt-5" />
      </div>
    </aside>

    <div class="min-w-0">
      <!-- Chapter 1 -->
      <section id={c1.id} data-chapter aria-labelledby={`${c1.id}-title`} class="chapter">
        <header class="chapter-head">
          <span class="numeral" aria-hidden="true">{c1.n}</span>
          <div>
            <p class="eyebrow text-accent">{c1.kicker}</p>
            <h2 id={`${c1.id}-title`} class="display mt-2 text-[2rem] text-ink md:text-[2.6rem]">{c1.title}</h2>
          </div>
        </header>
        <div class="mt-8 grid grid-cols-[minmax(0,1fr)] items-start gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)]">
          <div class="space-y-5 text-lg leading-relaxed text-ink/80">{c1.body.map((p) => <p>{p}</p>)}</div>
          <div class="art" data-reveal><StoryIllustration name="europe" class="w-full" /></div>
        </div>
        <p class="pull display mt-8 text-[1.75rem] text-accent md:text-[2.3rem]" data-reveal>{c1.pull}</p>
        <h3 class="mt-8 text-lg font-extrabold text-ink">{c1.worriesTitle}</h3>
        <ol class="mt-5 grid gap-4 sm:grid-cols-3" role="list">
          {
            c1.worries.map((w, i) => (
              <li class="bubble flex items-start gap-3" data-reveal>
                <span class="bubble-n flex-none" aria-hidden="true">{i + 1}</span>
                <p class="pt-1 leading-snug font-semibold text-ink">{w}</p>
              </li>
            ))
          }
        </ol>
        <div class="bridge">
          <p>{c1.bridge}</p>
          <svg viewBox="0 0 24 24" class="bridge-arrow" aria-hidden="true"><path d="M12 4v15M6 13l6 6 6-6" /></svg>
        </div>
      </section>

      <!-- Chapter 2 -->
      <section id={c2.id} data-chapter aria-labelledby={`${c2.id}-title`} class="chapter">
        <header class="chapter-head">
          <span class="numeral" aria-hidden="true">{c2.n}</span>
          <div>
            <p class="eyebrow flex flex-wrap items-center gap-3 text-accent">{c2.kicker} <span class="sample-badge">{ui.provisional}</span></p>
            <h2 id={`${c2.id}-title`} class="display mt-2 text-[2rem] text-ink md:text-[2.6rem]">{c2.title}</h2>
          </div>
        </header>
        <div class="mt-8 grid grid-cols-[minmax(0,1fr)] items-start gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)]">
          <div class="space-y-5 text-lg leading-relaxed text-ink/80">{c2.body.map((p) => <p>{p}</p>)}</div>
          <div class="art" data-reveal><StoryIllustration name="draw" class="w-full" /></div>
        </div>
        <div class="mt-8 grid gap-8 rounded-card bg-accent p-6 text-on-accent md:grid-cols-2 md:p-8" data-reveal>
          <div>
            <svg viewBox="0 0 48 48" class="h-11 w-11" aria-hidden="true">
              <rect x="6" y="8" width="36" height="32" rx="4" fill="var(--t-paper)" stroke="var(--t-ink)" stroke-width="2.5" />
              <path d="M14 18h20M14 25h14M14 32h18" fill="none" stroke="var(--t-ink)" stroke-width="2.2" stroke-linecap="round" />
              <circle cx="36" cy="36" r="8" fill="var(--t-highlight)" stroke="var(--t-ink)" stroke-width="2.5" />
              <path d="M40 40l5 5" stroke="var(--t-ink)" stroke-width="2.5" stroke-linecap="round" />
            </svg>
            <h3 class="mt-4 text-2xl font-extrabold">{c2.openBook.title}</h3>
            <p class="mt-3 leading-relaxed text-on-accent/85">{c2.openBook.body}</p>
          </div>
          <div>
            <h3 class="text-lg font-bold">{c2.measuresTitle}</h3>
            <ol class="mt-4 space-y-3" role="list">
              {
                c2.measures.map((m, i) => (
                  <li class="flex items-center gap-3 rounded-[18px] bg-on-accent/10 px-4 py-2.5">
                    <span class="grid h-8 w-8 flex-none place-items-center rounded-full bg-on-accent text-sm font-extrabold text-accent" aria-hidden="true">{i + 1}</span>
                    <span class="font-semibold">{m.label}</span>
                    {m.tag && <span class="ml-auto rounded-full bg-highlight px-2.5 py-1 text-[0.7rem] font-bold whitespace-nowrap text-ink">{m.tag}</span>}
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
        <div class="bridge">
          <p>{c2.bridge}</p>
          <svg viewBox="0 0 24 24" class="bridge-arrow" aria-hidden="true"><path d="M12 4v15M6 13l6 6 6-6" /></svg>
        </div>
      </section>

      <!-- Chapter 3 -->
      <section id={c3.id} data-chapter aria-labelledby={`${c3.id}-title`} class="chapter">
        <header class="chapter-head">
          <span class="numeral" aria-hidden="true">{c3.n}</span>
          <div>
            <p class="eyebrow flex flex-wrap items-center gap-3 text-accent">{c3.kicker} <span class="sample-badge">{ui.provisional}</span></p>
            <h2 id={`${c3.id}-title`} class="display mt-2 text-[2rem] text-ink md:text-[2.6rem]">{c3.title}</h2>
          </div>
        </header>
        <div class="mt-8 grid grid-cols-[minmax(0,1fr)] items-start gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)]">
          <div class="space-y-5 text-lg leading-relaxed text-ink/80">{c3.body.map((p) => <p>{p}</p>)}</div>
          <div class="art" data-reveal><StoryIllustration name="reading" class="w-full" /></div>
        </div>
        <div class="bridge">
          <p>{c3.bridge}</p>
          <svg viewBox="0 0 24 24" class="bridge-arrow" aria-hidden="true"><path d="M12 4v15M6 13l6 6 6-6" /></svg>
        </div>
      </section>

      <!-- Chapter 4 -->
      <section id={c4.id} data-chapter aria-labelledby={`${c4.id}-title`} class="chapter">
        <header class="chapter-head">
          <span class="numeral" aria-hidden="true">{c4.n}</span>
          <div>
            <p class="eyebrow flex flex-wrap items-center gap-3 text-accent">{c4.kicker} <span class="sample-badge">{ui.provisional}</span></p>
            <h2 id={`${c4.id}-title`} class="display mt-2 text-[2rem] text-ink md:text-[2.6rem]">{c4.title}</h2>
          </div>
        </header>
        <p class="mt-6 text-lg font-semibold text-ink/80">{c4.body[0]}</p>
        <ol class="mt-6 grid gap-4 xl:grid-cols-3" role="list">
          {
            c4.answers.map((a, i) => (
              <li class="flex flex-col rounded-card bg-surface p-6" data-reveal>
                <div class="bubble bubble--paper flex items-start gap-3">
                  <span class="bubble-n flex-none" aria-hidden="true">{i + 1}</span>
                  <p class="pt-1 text-[0.95rem] leading-snug font-semibold text-ink"><span class="sr-only">{c4.answerLabels.worry}: </span>{a.worry}</p>
                </div>
                <h3 class="mt-5 text-xl leading-tight font-extrabold text-ink"><span class="sr-only">{c4.answerLabels.answer}: </span>{a.verdict}</h3>
                <p class="mt-3 flex flex-wrap items-baseline gap-x-2">
                  <span class="text-4xl font-extrabold tracking-tight text-accent">{a.stat.value}</span>
                  <span class="text-sm font-semibold text-ink/70">{a.stat.label}</span>
                </p>
                <p class="mt-3 text-[0.95rem] leading-relaxed text-ink/75">{a.body}</p>
              </li>
            ))
          }
        </ol>
        <p class="mt-6 max-w-3xl leading-relaxed text-ink/75">{c4.countries}</p>
        <div class="mt-8 rounded-card bg-accent p-3 text-on-accent md:p-4" data-reveal>
          <div class="flex flex-wrap items-end justify-between gap-6 px-4 pt-5 pb-6 md:px-7 md:pt-6">
            <div>
              <p class="eyebrow flex flex-wrap items-center gap-3 text-on-accent/75">
                {c4.short}
                <span class="sample-badge !border-on-accent/50 !text-on-accent/80">{ui.provisional}</span>
              </p>
              <h3 class="mt-3 text-2xl font-extrabold md:text-3xl">{c4.chartTitle}</h3>
            </div>
            <dl class="flex items-end gap-4 md:gap-5">
              <div>
                <dt class="max-w-[9rem] text-xs leading-snug font-semibold text-on-accent/70">{c4.headline.baseLabel}</dt>
                <dd class="mt-1 text-2xl font-extrabold text-on-accent/80 md:text-3xl">{c4.headline.base}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold text-on-accent/70">{c4.headline.effectLabel}</dt>
                <dd class="mt-1 flex items-center gap-3 text-4xl font-extrabold md:text-5xl">
                  {c4.headline.effect}
                  <span class="rounded-full bg-highlight px-3 py-1 text-sm text-ink">{c4.headline.change}</span>
                </dd>
              </div>
            </dl>
          </div>
          <div class="rounded-[calc(var(--t-radius)-10px)] bg-paper p-5 text-ink md:p-9" data-reveal-chart>
            <EffectSizeChart results={s.case.results} lang={lang} compact />
          </div>
        </div>
        <p class="mt-5">
          <a href={s.case.href} class="inline-flex items-center gap-2 font-semibold text-ink underline decoration-highlight decoration-2 underline-offset-[6px] hover:decoration-accent">
            {s.case.linkLabel} <span aria-hidden="true">→</span>
          </a>
        </p>
        <div class="bridge">
          <p>{c4.bridge}</p>
          <svg viewBox="0 0 24 24" class="bridge-arrow" aria-hidden="true"><path d="M12 4v15M6 13l6 6 6-6" /></svg>
        </div>
      </section>

      <!-- Chapter 5 -->
      <section id={c5.id} data-chapter aria-labelledby={`${c5.id}-title`} class="chapter !pb-16 md:!pb-20">
        <header class="chapter-head">
          <span class="numeral" aria-hidden="true">{c5.n}</span>
          <div>
            <p class="eyebrow text-accent">{c5.kicker}</p>
            <h2 id={`${c5.id}-title`} class="display mt-2 text-[2rem] text-ink md:text-[2.6rem]">{c5.title}</h2>
          </div>
        </header>
        <div class="mt-8 grid grid-cols-[minmax(0,1fr)] items-start gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)]">
          <div>
            <div class="space-y-5 text-lg leading-relaxed text-ink/80">{c5.body.map((p) => <p>{p}</p>)}</div>
            <ul class="mt-5 space-y-2.5" role="list">
              {
                c5.recommendations.map((r) => (
                  <li class="flex items-start gap-3 font-semibold text-ink">
                    <svg viewBox="0 0 24 24" class="mt-0.5 h-6 w-6 flex-none" aria-hidden="true">
                      <circle cx="12" cy="12" r="11" fill="var(--t-accent)" />
                      <path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="var(--t-on-accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    {r}
                  </li>
                ))
              }
            </ul>
            <p class="mt-5 leading-relaxed text-ink/75">{c5.after}</p>
          </div>
          <div class="grid justify-items-center gap-6">
            <div class="art" data-reveal><StoryIllustration name="platform" class="w-full" /></div>
            <aside class="w-full rounded-card border-2 border-dashed border-line p-5 md:p-6" aria-labelledby={`${c5.id}-limits`}>
              <h3 id={`${c5.id}-limits`} class="text-lg font-extrabold text-ink">{c5.limits.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-ink/80">{c5.limits.body}</p>
            </aside>
          </div>
        </div>
        <p class="mt-8 flex items-start gap-2 border-t border-line pt-4 text-xs leading-relaxed text-muted">
          <span class="sample-badge mt-0.5">{ui.provisional}</span>
          <span>{hero.note} {c5.funding}</span>
        </p>
      </section>
    </div>
  </div>

  <!-- The turn -->
  <section aria-labelledby="turn-title" class="pb-12 md:pb-16">
    <div class="mx-3 rounded-card bg-accent text-on-accent">
      <div class="wrap py-10 md:py-14">
        <div class="max-w-3xl">
          <p class="eyebrow text-on-accent/70">{turn.eyebrow}</p>
          <h2 id="turn-title" class="display mt-4 text-[2.2rem] md:text-[3.4rem]">{turn.title}</h2>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-on-accent/85">{turn.lede}</p>
        </div>
        <h3 class="mt-10 text-xl font-extrabold md:mt-12">{turn.servicesTitle}</h3>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {
            turn.services.map((sv) => (
              <li>
                <a href={sv.href} class="group flex h-full items-start justify-between gap-4 rounded-[20px] bg-on-accent/10 px-5 py-4 transition-colors hover:bg-on-accent/20">
                  <span>
                    <span class="eyebrow block text-on-accent/70">{sv.service}</span>
                    <span class="mt-1.5 block leading-snug font-bold">{sv.question}</span>
                  </span>
                  <span aria-hidden="true" class="mt-5 text-lg transition-transform group-hover:translate-x-1">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="wrap">
      <article class="mt-12 grid gap-8 rounded-card bg-surface p-6 md:mt-12 md:p-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-12" aria-labelledby="second-title">
        <div>
          <p class="eyebrow text-accent">{second.eyebrow}</p>
          <h3 id="second-title" class="display mt-3 text-[1.75rem] text-ink md:text-[2.3rem]">{second.question}</h3>
          <p class="mt-4 font-bold text-ink">{second.title}</p>
          <p class="mt-1 text-sm text-muted">{second.meta}</p>
          <a href={second.cta.href} rel="noopener" class="btn btn-primary mt-6 !px-6">{second.cta.label} <span aria-hidden="true">→</span></a>
        </div>
        <div>
          <h4 class="text-sm font-extrabold tracking-wide text-ink uppercase">{second.highlightsTitle}</h4>
          <ul class="mt-3 space-y-2.5" role="list">
            {
              second.highlights.map((h) => (
                <li class="rounded-[18px] rounded-bl-[4px] bg-paper px-4 py-3 text-[0.95rem] leading-snug text-ink">{h}</li>
              ))
            }
          </ul>
          <div class="mt-4 flex flex-col items-center justify-center gap-2 rounded-[18px] border-2 border-dashed border-ink/25 px-4 py-4 text-center">
            <span class="sample-badge">{second.pending}</span>
            <p class="text-sm text-muted">{second.pendingNote}</p>
          </div>
        </div>
      </article>

      <div class="mt-12">
        <h3 class="text-lg font-extrabold text-ink md:text-xl">{turn.partnersTitle}</h3>
        <PartnerGrid variant="strip" class="mt-6" />
        <div class="mt-8 flex flex-wrap items-center gap-2 border-t border-line pt-6">
          <p class="eyebrow mr-2 text-muted">{turn.euTitle}</p>
          {
            turn.euProjects.map((p) => (
              <a href={p.href} class="inline-flex items-center gap-2 rounded-full bg-surface px-4 py-2 text-sm font-bold text-ink hover:bg-accent-soft">
                {p.name}
                {p.programme && <span class="font-medium text-muted">{p.programme}</span>}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- The invitation -->
  <section class="wrap pb-12 md:pb-16" aria-labelledby="invite-title">
    <div class="grid items-center gap-8 rounded-card bg-surface px-6 py-10 sm:px-10 md:grid-cols-[minmax(0,1fr)_auto] md:px-14 md:py-14">
      <div>
        <p class="eyebrow text-accent">{invite.eyebrow}</p>
        <h2 id="invite-title" class="display mt-4 text-[2.4rem] text-ink md:text-6xl">{invite.title}</h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink/80">{invite.body}</p>
        <p class="eyebrow mt-8 text-muted">{invite.examplesLabel}</p>
        <ul class="mt-3 flex flex-wrap gap-2" role="list">
          {invite.examples.map((e) => <li class="rounded-[18px] rounded-bl-[4px] bg-paper px-4 py-2.5 text-[0.95rem] font-semibold text-ink">{e}</li>)}
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={invite.cta.href} class="btn btn-primary !px-6">{invite.cta.label}</a>
          <a href={invite.email.href} class="font-semibold text-ink underline decoration-highlight decoration-2 underline-offset-[6px] hover:decoration-accent">{invite.email.label}</a>
        </div>
      </div>
      <Illustration name="plane" class="mx-auto hidden w-56 md:block md:w-64" />
    </div>
  </section>
</Base>

<style>
  .chapter {
    scroll-margin-top: 4rem;
    padding-block: 2.5rem 0.25rem;
    border-top: 1px solid var(--t-line);
  }
  .chapter:first-child {
    border-top: 0;
    padding-top: 2.5rem;
  }
  @media (width >= 64rem) {
    .chapter {
      padding-top: 3.25rem;
    }
    .chapter:first-child {
      padding-top: 3.5rem;
    }
  }
  .chapter-head {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
  }
  .numeral {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 999px;
    background: var(--t-highlight);
    border: 2.5px solid var(--t-ink);
    font-family: var(--t-font-display);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--t-ink);
  }
  @media (width >= 48rem) {
    .chapter-head {
      gap: 1.5rem;
    }
    .numeral {
      width: 4.4rem;
      height: 4.4rem;
      font-size: 2rem;
    }
  }
  .art {
    border-radius: var(--t-radius);
    background: var(--t-surface);
    padding: 0.9rem;
    max-width: 15rem;
    width: 100%;
    justify-self: center;
  }
  @media (width >= 48rem) {
    .art {
      max-width: 26rem;
      padding: 1.25rem;
    }
  }

  /* Speech bubbles: the three worries, asked in chapter 1 and answered in chapter 4. */
  .bubble {
    position: relative;
    padding: 0.9rem 1.1rem 1rem;
    border-radius: 24px;
    background: var(--t-accent-soft);
    margin-bottom: 14px;
  }
  .bubble::after {
    content: '';
    position: absolute;
    left: 30px;
    bottom: -13px;
    width: 26px;
    height: 14px;
    background: inherit;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
  .bubble--paper {
    background: var(--t-paper);
  }
  .bubble-n {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--t-accent);
    color: var(--t-on-accent);
    font-weight: 800;
    font-size: 0.9rem;
  }
  .pull {
    max-width: 24ch;
  }

  /* The thread from one chapter to the next. */
  .bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin: 2rem auto 2rem;
    max-width: 34rem;
    text-align: center;
