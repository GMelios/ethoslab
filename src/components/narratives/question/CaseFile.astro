---
/**
 * Direction C: the evaluation "case file" that travels with the story.
 * Each chapter shows what the file has gathered so far (carried over, small)
 * and what this chapter adds (new, as stat tiles), so the numbers build up.
 * Extra content (a grid, a chart) goes in the default slot.
 */
import type { Fact } from '../../../data/narratives/question';

interface Props {
  path: string;
  badge: string;
  fresh?: Fact[];
  carried?: Fact[];
  freshLabel: string;
  carriedLabel: string;
  class?: string;
}
const { path, badge, fresh = [], carried = [], freshLabel, carriedLabel, class: className = '' } = Astro.props;
---

<div class:list={['overflow-hidden rounded-card border border-line bg-paper shadow-[0_24px_60px_-28px_rgb(11_18_32/0.28)]', className]}>
  <div class="flex items-center gap-2 border-b border-line px-4 py-3">
    <span class="h-2.5 w-2.5 flex-none rounded-full bg-line"></span><span class="h-2.5 w-2.5 flex-none rounded-full bg-line"></span><span class="h-2.5 w-2.5 flex-none rounded-full bg-line"></span>
    <span class="ml-2 min-w-0 truncate font-label text-[0.7rem] text-muted">{path}</span>
    <span class="sample-badge ml-auto">{badge}</span>
  </div>
  <div class="p-4 sm:p-5 md:p-6">
    {
      carried.length > 0 && (
        <div class="mb-5 hidden sm:block">
          <p class="font-label text-[0.62rem] tracking-wide text-muted uppercase">{carriedLabel}</p>
          <ul class="mt-2 flex flex-wrap gap-1.5" role="list">
            {carried.map((f) => (
              <li class="rounded-control border border-line bg-surface px-2 py-0.5 text-[0.72rem] leading-snug" title={f.label}>
                <strong class="font-semibold text-ink">{f.value}</strong>
                <span class="sr-only">{' '}{f.label}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      fresh.length > 0 && (
        <div>
          {freshLabel && <p class="mb-2 font-label text-[0.62rem] tracking-wide text-accent uppercase">{freshLabel}</p>}
          <dl class:list={['grid gap-2.5 sm:gap-3', fresh.length === 1 ? 'grid-cols-1' : fresh.length === 3 ? 'grid-cols-2 sm:grid-cols-3' : 'grid-cols-2']}>
            {fresh.map((f) => (
              <div class="flex flex-col rounded-control bg-accent-soft p-3 sm:p-3.5" data-reveal>
                <dt class="order-2 mt-1 text-[0.8rem] leading-snug text-muted">{f.label}</dt>
                <dd class="order-1 text-xl font-semibold tracking-tight text-accent sm:text-2xl">{f.value}</dd>
                {f.note && <dd class="order-3 mt-1.5 font-label text-[0.62rem] leading-snug text-muted">{f.note}</dd>}
              </div>
            ))}
          </dl>
        </div>
      )
    }
    <slot />
  </div>
</div>
