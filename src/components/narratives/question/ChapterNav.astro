---
/**
 * Chapter progress for the "Follow one question" story.
 * Without JavaScript it is a plain list of in-page links. With it, the chapter
 * in view is marked aria-current="step" and earlier ones data-done.
 *   rail: vertical, for a sticky side column (B, desktop)
 *   bar:  horizontal segments, for a sticky top strip (C, and B on phones)
 */
import type { ChapterBase } from '../../../data/narratives/question';

interface Props {
  chapters: Pick<ChapterBase, 'id' | 'n' | 'short'>[];
  label: string;
  variant: 'rail' | 'bar';
  class?: string;
}
const { chapters, label, variant, class: className = '' } = Astro.props;
---

<nav aria-label={label} class:list={['qnav', `qnav--${variant}`, className]} style={`--qnav-count:${chapters.length}`} data-qnav>
  <ol role="list">
    {
      chapters.map((c) => (
        <li>
          <a href={`#${c.id}`} data-qnav-link={c.id}>
            <span class="qnav-n" aria-hidden="true">{String(c.n).padStart(2, '0')}</span>
            <span class="qnav-t" aria-hidden="true">{c.short}</span>
            <span class="sr-only">{c.short}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .qnav ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .qnav a {
    display: flex;
    color: var(--t-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .qnav a:hover,
  .qnav a[aria-current] {
    color: var(--t-ink);
  }
  .qnav-n {
    font-family: var(--t-font-label);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  /* ---- rail --------------------------------------------------------------- */
  .qnav--rail ol {
    position: relative;
    display: grid;
    gap: 0.35rem;
  }
  .qnav--rail ol::before {
    content: '';
    position: absolute;
    top: 1.1rem;
    bottom: 1.1rem;
    left: calc(1.1rem - 1px);
    border-left: 2px dotted color-mix(in oklab, var(--t-ink), transparent 55%);
  }
  .qnav--rail a {
    position: relative;
    align-items: center;
    gap: 0.75rem;
    padding: 0.2rem 0;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.25;
  }
  .qnav--rail .qnav-n {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    border: 2px solid color-mix(in oklab, var(--t-ink), transparent 55%);
    background: var(--t-paper);
    font-family: var(--t-font-body);
    font-size: 0.78rem;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .qnav--rail a[data-done] .qnav-n {
    border-color: var(--t-accent);
    background: var(--t-accent-soft);
    color: var(--t-accent);
  }
  .qnav--rail a[aria-current] .qnav-n {
    border-color: var(--t-accent);
    background: var(--t-accent);
    color: var(--t-on-accent);
  }

  /* ---- bar ---------------------------------------------------------------- */
  .qnav--bar ol {
    display: grid;
    grid-template-columns: repeat(var(--qnav-count, 5), minmax(0, 1fr));
    gap: 0.4rem;
  }
  .qnav--bar a {
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.55rem 0 0.6rem;
    font-size: 0.78rem;
    line-height: 1.2;
    border-top: 3px solid var(--t-line);
    transition: border-color 0.25s, color 0.2s;
  }
  .qnav--bar a[data-done] {
    border-top-color: color-mix(in oklab, var(--t-accent), var(--t-paper) 55%);
  }
  .qnav--bar a[aria-current] {
    border-top-color: var(--t-accent);
  }
  .qnav--bar a[aria-current] .qnav-n {
    color: var(--t-accent);
  }
  .qnav--bar .qnav-n {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }
  .qnav--bar .qnav-t {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
  }
  @media (width < 48rem) {
    .qnav--bar .qnav-t {
      display: none;
    }
  }
</style>

<script>
  // Highlight the chapter in view. One observer for every nav on the page.
  const navs = document.querySelectorAll<HTMLElement>('[data-qnav]');
  const sections = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
  if (navs.length && sections.length && 'IntersectionObserver' in window) {
    const ids = sections.map((s) => s.id);
    const mark = (id: string | null) => {
      const at = id ? ids.indexOf(id) : -1;
      navs.forEach((nav) =>
        nav.querySelectorAll<HTMLAnchorElement>('[data-qnav-link]').forEach((a) => {
          const i = ids.indexOf(a.dataset.qnavLink ?? '');
          if (i === at) a.setAttribute('aria-current', 'step');
          else a.removeAttribute('aria-current');
          a.toggleAttribute('data-done', at > -1 && i < at);
        }),
      );
    };
    const visible = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
        // The last chapter whose band crosses the reading line wins.
        mark(ids.filter((id) => visible.has(id)).pop() ?? null);
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
