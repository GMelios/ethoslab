---
/**
 * Review aid, not part of the design.
 * - On a direction page (/a, /b, /c and the narrative variants /b/<story>, /c/<story>)
 *   the first group switches direction and the second switches story, keeping the other.
 * - Anywhere else the direction buttons re-skin the current page via ?theme=,
 *   which Base.astro remembers for later pages.
 */
import type { Direction } from '../data/site';
import { stories } from '../data/stories';

interface Props {
  /** Set on direction pages. */
  direction?: Direction;
}
const { direction } = Astro.props;
const options: { id: Direction; label: string }[] = [
  { id: 'a', label: 'Editorial' },
  { id: 'b', label: 'Warm' },
  { id: 'c', label: 'Data' },
];
const current = Astro.url.pathname.match(/^\/[bc]\/([a-z-]+)\/?$/)?.[1] ?? '';
const hasStories = direction === 'b' || direction === 'c';
const directionHref = (id: Direction) => (id !== 'a' && current ? `/${id}/${current}` : `/${id}`);
---

<aside
  aria-label="Prototype switcher"
  class="fixed bottom-3 left-1/2 z-50 flex max-w-[calc(100vw-1rem)] -translate-x-1/2 items-center gap-1 rounded-full bg-[#111]/90 p-1 pl-3 font-[system-ui] text-[11px] text-white shadow-lg backdrop-blur print:hidden"
  data-proto-bar
>
  <span class="hidden pr-1 font-semibold tracking-wide text-white/60 uppercase md:inline">Prototype</span>
  {
    options.map((o) => (
      <a
        href={direction ? directionHref(o.id) : `?theme=${o.id}`}
        data-proto-option={o.id}
        aria-current={direction === o.id ? 'page' : undefined}
        class="rounded-full px-2.5 py-1.5 font-medium text-white/80 hover:bg-white/15 aria-[current]:bg-white aria-[current]:text-[#111]"
      >
        <span class="font-bold uppercase">{o.id}</span>
        <span class="hidden lg:inline"> {o.label}</span>
      </a>
    ))
  }
  {
    hasStories && (
      <>
        <span class="mx-1 h-4 w-px bg-white/25" aria-hidden="true" />
        <span class="hidden pr-1 font-semibold tracking-wide text-white/60 uppercase md:inline">Story</span>
        {stories.map((s) => (
          <a
            href={s.id ? `/${direction}/${s.id}` : `/${direction}`}
            aria-current={current === s.id ? 'page' : undefined}
            title={s.description}
            class="rounded-full px-2.5 py-1.5 font-medium whitespace-nowrap text-white/80 hover:bg-white/15 aria-[current]:bg-white aria-[current]:text-[#111]"
          >
            <span class="sm:hidden">{s.short}</span>
            <span class="hidden sm:inline">{s.label}</span>
          </a>
        ))}
      </>
    )
  }
  <span class="hidden items-center gap-1 theme-b:inline-flex" data-palette-group>
    <span class="mx-1 h-4 w-px bg-white/25" aria-hidden="true"></span>
    <span class="hidden pr-1 font-semibold tracking-wide text-white/60 uppercase md:inline">Colours</span>
    {
      [
        { id: 'brand', label: 'Logo', swatch: 'linear-gradient(90deg,#f1592a 50%,#0f75bb 50%)', title: 'Orange and blue from the Ethos Lab logo' },
        { id: 'aegean', label: 'Aegean', swatch: 'linear-gradient(90deg,#0e4a6e 50%,#d4613a 50%)', title: 'Sea blue, marble and terracotta' },
        { id: 'figure', label: 'Black-figure', swatch: 'linear-gradient(90deg,#17110d 50%,#c9582a 50%)', title: 'Black glaze on fired clay' },
        { id: 'olive', label: 'Olive', swatch: 'linear-gradient(90deg,#3e4e1e 50%,#e3a81b 50%)', title: 'Olive and saffron' },
        { id: 'midnight', label: 'Midnight', swatch: 'linear-gradient(90deg,#0e1726 50%,#f2b84b 50%)', title: 'Night blue and marigold' },
      ].map((p) => (
        <a href={`?palette=${p.id}`} data-palette-option={p.id} title={p.title} class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1.5 font-medium text-white/80 hover:bg-white/15 aria-[current]:bg-white aria-[current]:text-[#111]">
          <span class="h-2.5 w-2.5 rounded-full" style={`background:${p.swatch}`} aria-hidden="true" />
          <span class="hidden xl:inline">{p.label}</span>
          <span class="sr-only xl:hidden">{p.label}</span>
        </a>
      ))
    }
  </span>
  <a href="/review" class="rounded-full px-2.5 py-1.5 font-medium text-white/60 hover:bg-white/15 hover:text-white" title="All variants">
    <span aria-hidden="true">▦</span><span class="sr-only">All variants</span>
  </a>
</aside>

<script>
  // Mark the active option on inner pages, and point "home" links at the
  // direction being reviewed so the logo doesn't jump back to the default.
  const theme = document.documentElement.dataset.theme;
  const bar = document.querySelector('[data-proto-bar]');
  const palette = document.documentElement.dataset.palette;
  bar?.querySelector(`[data-palette-option="${palette}"]`)?.setAttribute('aria-current', 'true');
  if (bar && !bar.querySelector('[data-proto-option][aria-current]')) {
    bar.querySelector(`[data-proto-option="${theme}"]`)?.setAttribute('aria-current', 'true');
  }
  if (!document.documentElement.hasAttribute('data-theme-forced') && theme) {
    document.querySelectorAll<HTMLAnchorElement>('[data-home-link]').forEach((a) => {
      if (a.getAttribute('href') === '/') a.href = `/${theme}`;
    });
  }
</script>
