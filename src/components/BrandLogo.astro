---
/**
 * The Ethos Lab logo, inlined from the brand kit in src/assets/brand/svg (Claude Design
 * export, October 2026). Shapes are grouped as .logo-primary (orange) and
 * .logo-secondary (navy, or white on dark), and their fills are mapped to --logo-a and
 * --logo-b so each background can set its own colours (see --t-logo-* in global.css).
 *
 * Per the brand README, the small-mark lockups are the ones for headers and anything
 * under 96px tall; the full-mark lockups are for large brand moments.
 */
import horizontalSmall from '../assets/brand/svg/ethos-lab-horizontal-small-light.svg?raw';
import horizontal from '../assets/brand/svg/ethos-lab-horizontal-light.svg?raw';
import stackedSmall from '../assets/brand/svg/ethos-lab-stacked-small-light.svg?raw';
import markSmall from '../assets/brand/svg/ethos-lab-mark-small-light.svg?raw';
import mark from '../assets/brand/svg/ethos-lab-mark-light.svg?raw';

interface Props {
  variant?: 'horizontal' | 'horizontal-large' | 'stacked' | 'mark' | 'mark-large';
  class?: string;
  title?: string;
}
const { variant = 'horizontal', class: className = '', title = 'Ethos Lab' } = Astro.props;

const source = { horizontal: horizontalSmall, 'horizontal-large': horizontal, stacked: stackedSmall, mark: markSmall, 'mark-large': mark }[variant];

// Keep the artwork, drop the content-credentials metadata and fixed pixel size,
// and point the two brand fills at CSS variables.
const svg = source
  .replace(/<metadata>[\s\S]*?<\/metadata>/, '')
  .replace(/\s(width|height)="\d+"/g, '')
  .replace(/xmlns:c2pa="[^"]*"/, '')
  .replace(/aria-label="[^"]*"/, `aria-label="${title}"`)
  .replace('<svg ', `<svg class="brand-logo ${className}" `)
  .replace(/fill="#F1592A"/gi, 'fill="var(--logo-a)"')
  .replace(/fill="#0B1631"/gi, 'fill="var(--logo-b)"');
---

<Fragment set:html={svg} />

<style is:global>
  .brand-logo {
    --logo-a: var(--t-logo-a, #f1592a);
    --logo-b: var(--t-logo-b, #0b1631);
    display: block;
    height: 100%;
    width: auto;
  }
</style>
