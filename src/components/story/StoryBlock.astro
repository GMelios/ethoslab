---
/** Renders one block of a research story. See src/lib/story.ts for the block types. */
import EffectSizeChart from '../EffectSizeChart.astro';
import type { StoryBlock } from '../../lib/story';
import type { Locale } from '../../i18n/config';

interface Props {
  block: StoryBlock;
  lang: Locale;
}
const { block: b, lang } = Astro.props;
---

{b.type === 'text' && <div class="space-y-4 text-lg leading-relaxed text-ink/85">{b.paras.map((p) => <p>{p}</p>)}</div>}

{b.type === 'pull' && <blockquote class="display border-l-4 border-ember pl-6 text-2xl text-ink md:text-3xl">{b.text}</blockquote>}

{
  b.type === 'list' && (
    <div class:list={[b.boxed && 'rounded-card bg-mist p-7']}>
      {b.title && <p class="eyebrow text-ink">{b.title}</p>}
      {b.numbered ? (
        <ol class:list={['space-y-3', b.title && 'mt-5']}>
          {b.items.map((it, i) => (
            <li class:list={['flex gap-4', !b.boxed && 'rounded-card bg-mist p-4']}>
              <span class="display text-2xl text-ember">{i + 1}</span>
              <span class="pt-1 leading-snug font-medium text-ink">{it}</span>
            </li>
          ))}
        </ol>
      ) : (
        <ul class:list={['space-y-3', b.title && 'mt-4']}>
          {b.items.map((it) => (
            <li class="flex gap-3 text-ink">
              <span class="mt-[0.7em] h-0.5 w-4 shrink-0 bg-ember" aria-hidden="true" />
              {it}
            </li>
          ))}
        </ul>
      )}
    </div>
  )
}

{
  b.type === 'cards' && (
    <div>
      {b.title && <p class="eyebrow mb-5 text-ink">{b.title}</p>}
      <ul class="grid gap-4 md:grid-cols-3" role="list">
        {b.items.map((c) => (
          <li class:list={['rounded-card border-t-4 bg-paper p-7', c.accent ? 'border-ember' : 'border-line']}>
            {c.eyebrow && <p class="eyebrow text-muted">{c.eyebrow}</p>}
            <h3 class="mt-3 text-xl font-semibold text-ink">{c.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{c.body}</p>
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  b.type === 'facts' && (
    <dl class="grid grid-cols-2 gap-6">
      {b.items.map((f) => (
        <div class="border-l-2 border-ember pl-4">
          <dt class="sr-only">{f.label}</dt>
          <dd>
            <span class="display block text-3xl text-ink md:text-4xl">{f.value}</span>
            <span class="mt-1 block text-sm leading-snug text-muted">{f.label}</span>
          </dd>
        </div>
      ))}
    </dl>
  )
}

{
  b.type === 'callout' && (
    <div class="rounded-card bg-midnight p-7 text-white">
      <p class="eyebrow text-[#f1592a]">{b.title}</p>
      <p class="mt-3 leading-relaxed text-white/80">{b.body}</p>
    </div>
  )
}

{
  b.type === 'steps' && (
    <div>
      {b.title && <p class="eyebrow text-ink">{b.title}</p>}
      <ol class="mt-5 divide-y divide-line border-y border-line">
        {b.rows.map((r, i) => (
          <li class="grid grid-cols-[2.5rem_7rem_1fr] items-baseline gap-3 py-4">
            <span class="display text-xl text-ember">{i + 1}</span>
            <span class="font-semibold text-ink">{r.label}</span>
            <span class="text-muted">{r.detail}</span>
          </li>
        ))}
      </ol>
    </div>
  )
}

{
  b.type === 'answers' && (
    <ol class="space-y-4">
      {b.items.map((a) => (
        <li class="grid gap-6 rounded-card bg-paper p-7 md:grid-cols-12 md:p-8">
          <div class="md:col-span-4">
            <p class="eyebrow text-muted">{b.labels.worry}</p>
            <p class="mt-2 text-lg leading-snug font-medium text-ink">{a.worry}</p>
          </div>
          <div class="md:col-span-5">
            <p class="eyebrow text-muted">{b.labels.answer}</p>
            <p class="display mt-2 text-2xl text-display-accent">{a.verdict}</p>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-ink/85">{a.body}</p>
          </div>
          <div class="border-l-2 border-ember pl-5 md:col-span-3">
            <p class="display text-5xl text-ink">{a.stat.value}</p>
            <p class="mt-2 text-sm leading-snug text-muted">{a.stat.label}</p>
          </div>
        </li>
      ))}
    </ol>
  )
}

{
  b.type === 'chart' && (
    <div class="rounded-card bg-paper p-6 md:p-8">
      {b.title && <p class="eyebrow text-ink">{b.title}</p>}
      <EffectSizeChart results={b.results} lang={lang} class="mt-4" />
    </div>
  )
}

{
  b.type === 'charts' && (
    <div>
      {b.title && <p class="eyebrow text-ink">{b.title}</p>}
      <div class="mt-4 grid gap-6 lg:grid-cols-2">
        {b.results.map((r) => (
          <div class="rounded-card bg-paper p-6">
            <EffectSizeChart results={r} lang={lang} compact />
          </div>
        ))}
      </div>
    </div>
  )
}

{b.type === 'note' && <p class="max-w-3xl leading-relaxed text-muted">{b.text}</p>}
