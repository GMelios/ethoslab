---
/** A list with tick marks, for "What you receive" style lists. */
interface Props {
  items: readonly string[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

<ul class:list={['grid gap-3 sm:grid-cols-2', className]}>
  {
    items.map((item) => (
      <li class="flex gap-3 text-lg leading-snug text-ink">
        <svg viewBox="0 0 20 20" class="mt-1 h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {item}
      </li>
    ))
  }
</ul>
