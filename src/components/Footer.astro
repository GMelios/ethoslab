---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
import { useTranslations } from '../i18n/ui';
import { localePath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-auto bg-inverse text-on-inverse theme-b:mx-3 theme-b:mb-3 theme-b:rounded-card">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo inverse class="h-10" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-on-inverse/75 theme-b:hidden">
        Experiments and causal evaluation for public bodies, funders and research consortia across Europe. Based in Athens.
      </p>
      <!-- Direction B uses the v1 homepage copy. -->
      <p class="mt-4 hidden max-w-sm text-sm leading-relaxed text-on-inverse/75 theme-b:block">
        Ethos Lab is a behavioural research and impact evaluation company. We help organisations across Europe understand how people behave, test what changes it, and prove what worked. Based in Athens.
      </p>
    </div>

    <nav aria-label="Footer" class="md:col-span-3">
      <h2 class="eyebrow text-on-inverse/60">Navigate</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {nav.map((item) => <li><a class="hover:underline" href={localePath(lang, item.path)}>{t(item.key)}</a></li>)}
        <li><a class="hover:underline" href={localePath(lang, '/contact/')}>{t('nav.contact')}</a></li>
      </ul>
    </nav>

    <div class="text-sm md:col-span-4">
      <h2 class="eyebrow text-on-inverse/60">{t('nav.contact')}</h2>
      <address class="mt-4 space-y-3 not-italic leading-relaxed">
        <p><span class="text-on-inverse/60">{t('footer.offices')}:</span> {site.offices.street}, {site.offices.postcode} {site.offices.city}</p>
        <p><span class="text-on-inverse/60">{t('footer.hq')}:</span> {site.registered.street}, {site.registered.city}</p>
        <p>
          <a class="hover:underline" href={`mailto:${site.email}`}>{site.email}</a><br />
          <a class="hover:underline" href={site.phoneHref}>{site.phone}</a>
        </p>
      </address>
      <ul class="mt-4 flex gap-4 text-sm">
        {site.social.map((s) => <li><a class="underline-offset-4 hover:underline" href={s.href} rel="noopener">{s.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-on-inverse/15">
    <div class="wrap flex flex-col gap-2 py-5 text-xs text-on-inverse/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Ethos Lab. {t('footer.rights')} {t('footer.registry')} {site.gemi}</p>
      <p class="flex gap-4">
        <a class="hover:underline" href={localePath(lang, '/legal/privacy-policy-gdpr/')}>{t('footer.privacy')}</a>
        <a class="hover:underline" href={localePath(lang, '/legal/terms-of-use/')}>{t('footer.terms')}</a>
      </p>
    </div>
  </div>
</footer>
