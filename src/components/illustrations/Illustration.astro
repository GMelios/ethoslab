---
/**
 * Hand-drawn style line illustrations for direction B. Monoline strokes in ink,
 * with fills from theme tokens (accent-soft, highlight, accent, paper) so they
 * recolour with the theme. Decorative: always aria-hidden.
 */
interface Props {
  name: 'hero' | 'ministry' | 'town' | 'seedling' | 'network' | 'listen' | 'test' | 'explain' | 'plane';
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---

{
  name === 'hero' && (
    <svg viewBox="0 0 480 440" class:list={['ill', className]} aria-hidden="true">
      <path class="f-soft no-stroke" d="M86 318c-40-52-30-150 30-196 58-45 150-62 224-30 70 30 110 104 92 176-18 74-94 116-180 118-74 2-128-20-166-68z" />
      <circle class="f-sun" cx="398" cy="78" r="30" />
      <path d="M398 30v-12M398 138v-12M350 78h-12M458 78h-12M364 44l-8-8M440 120l-8-8M432 44l8-8M356 120l8-8" />
      <!-- stand -->
      <path class="f-paper" d="M196 402h88l-12-26h-64z" />
      <path d="M180 404h120" />
      <path d="M240 376V146" />
      <circle class="f-accent" cx="240" cy="136" r="10" />
      <!-- beam, tilted: B is heavier -->
      <path d="M104 118L376 160" stroke-width="3.5" />
      <!-- left pan (A) -->
      <path d="M104 118L66 206M104 118l40 88" />
      <path class="f-paper" d="M56 206h98c-6 22-26 34-49 34s-43-12-49-34z" />
      <g transform="rotate(-6 106 186)">
        <rect class="f-paper" x="80" y="164" width="52" height="38" rx="4" />
        <path d="M80 168l26 18 26-18" />
        <text x="106" y="158" class="ill-label">A</text>
      </g>
      <!-- right pan (B) -->
      <path d="M376 160l-38 88M376 160l40 88" />
      <path class="f-paper" d="M328 248h98c-6 22-26 34-49 34s-43-12-49-34z" />
      <g transform="rotate(4 378 226)">
        <rect class="f-sun" x="350" y="204" width="54" height="40" rx="4" />
        <path d="M350 208l27 19 27-19" />
        <text x="377" y="198" class="ill-label">B</text>
      </g>
      <circle class="f-accent" cx="420" cy="196" r="15" />
      <path d="M413 196l5 5 10-10" stroke="var(--t-on-accent)" />
      <!-- sparkles -->
      <path class="f-sun" d="M322 196l4 10 10 4-10 4-4 10-4-10-10-4 10-4z" />
      <path class="f-sun" d="M444 262l3 7 7 3-7 3-3 7-3-7-7-3 7-3z" />
      <!-- magnifier -->
      <circle class="f-paper" cx="118" cy="330" r="34" />
      <path d="M142 354l34 34" stroke-width="7" />
      <path d="M102 338l10-12 10 8 12-18" />
      <!-- seedling -->
      <path d="M338 404c0-26 0-40 2-56" />
      <path class="f-soft" d="M340 360c-20 2-32-8-34-24 18-2 32 8 34 24zM340 348c4-20 18-30 36-28-2 18-16 28-36 28z" />
      <path d="M318 404h46" />
    </svg>
  )
}
{
  name === 'ministry' && (
    <svg viewBox="0 0 160 120" class:list={['ill', className]} aria-hidden="true">
      <circle class="f-sun no-stroke" cx="120" cy="30" r="18" />
      <path class="f-paper" d="M30 48L80 20l50 28z" />
      <path class="f-soft" d="M34 48h92v10H34z" />
      <path d="M44 58v38M64 58v38M96 58v38M116 58v38" />
      <path class="f-paper" d="M28 96h104v8H28zM22 104h116v8H22z" />
      <circle class="f-accent no-stroke" cx="80" cy="37" r="4" />
    </svg>
  )
}
{
  name === 'town' && (
    <svg viewBox="0 0 160 120" class:list={['ill', className]} aria-hidden="true">
      <path class="f-soft no-stroke" d="M20 104c10-26 40-36 66-30 26 6 44 4 58-8v38z" />
      <path class="f-paper" d="M26 104V66l22-18 22 18v38z" />
      <path class="f-sun" d="M70 104V54l26-22 26 22v50z" />
      <path d="M40 104V84h16v20M88 70h16v14H88z" />
      <circle class="f-paper" cx="136" cy="70" r="14" />
      <path d="M136 84v20M14 104h136" />
    </svg>
  )
}
{
  name === 'seedling' && (
    <svg viewBox="0 0 160 120" class:list={['ill', className]} aria-hidden="true">
      <path class="f-accent no-stroke" d="M80 30c-6-10-22-8-22 4 0 10 14 18 22 24 8-6 22-14 22-24 0-12-16-14-22-4z" />
      <path d="M80 104V70" />
      <path class="f-soft" d="M80 80c-20 2-30-8-32-22 18-2 30 8 32 22zM80 74c4-18 16-26 32-24-2 16-14 24-32 24z" />
      <path class="f-sun" d="M56 104h48l-6 12H62z" />
      <path d="M50 104h60" />
    </svg>
  )
}
{
  name === 'network' && (
    <svg viewBox="0 0 160 120" class:list={['ill', className]} aria-hidden="true">
      <g class="f-sun no-stroke">
        {Array.from({ length: 12 }, (_, i) => {
          const a = (i / 12) * Math.PI * 2;
          return <circle cx={80 + Math.cos(a) * 48} cy={60 + Math.sin(a) * 48} r="3.2" />;
        })}
      </g>
      <path d="M58 46l44-4M58 46l14 34M102 42l-30 38M102 42l8 32M72 80l38-6" />
      <circle class="f-accent" cx="58" cy="46" r="9" />
      <circle class="f-paper" cx="102" cy="42" r="9" />
      <circle class="f-soft" cx="72" cy="80" r="9" />
      <circle class="f-paper" cx="110" cy="74" r="7" />
    </svg>
  )
}
{
  name === 'listen' && (
    <svg viewBox="0 0 160 120" class:list={['ill', className]} aria-hidden="true">
      <path class="f-soft" d="M28 26h70a10 10 0 0 1 10 10v28a10 10 0 0 1-10 10H56l-16 14v-14H28a10 10 0 0 1-10-10V36a10 10 0 0 1 10-10z" />
      <path class="f-paper" d="M76 52h54a10 10 0 0 1 10 10v24a10 10 0 0 1-10 10h-8v12l-14-12H76a10 10 0 0 1-10-10V62a10 10 0 0 1 10-10z" />
      <path d="M36 42h50M36 56h32M82 70h44M82 82h28" />
    </svg>
  )
}
{
  name === 'test' && (
    <svg viewBox="0 0 160 120" class:list={['ill', className]} aria-hidden="true">
      <rect class="f-paper" x="20" y="24" width="52" height="72" rx="8" transform="rotate(-5 46 60)" />
      <rect class="f-sun" x="88" y="24" width="52" height="72" rx="8" transform="rotate(5 114 60)" />
      <text x="46" y="68" class="ill-label ill-label--big">A</text>
      <text x="114" y="68" class="ill-label ill-label--big">B</text>
      <circle class="f-accent" cx="136" cy="26" r="12" />
      <path d="M131 26l4 4 7-8" stroke="var(--t-on-accent)" />
    </svg>
  )
}
{
  name === 'explain' && (
    <svg viewBox="0 0 160 120" class:list={['ill', className]} aria-hidden="true">
      <path class="f-paper" d="M40 12h64l20 20v78H40z" />
      <path d="M104 12v20h20" />
      <path d="M56 92V40M56 92h54" />
      <path d="M68 62h28M68 76h36M68 48h20" stroke="var(--t-line)" stroke-width="7" />
      <circle class="f-accent" cx="82" cy="48" r="4.5" />
      <circle class="f-accent" cx="86" cy="62" r="4.5" />
      <circle class="f-accent" cx="92" cy="76" r="4.5" />
      <path class="f-sun" d="M128 86l3 7 7 3-7 3-3 7-3-7-7-3 7-3z" />
    </svg>
  )
}
{
  name === 'plane' && (
    <svg viewBox="0 0 240 160" class:list={['ill', className]} aria-hidden="true">
      <path d="M20 132c30-6 52-30 44-50-8-18-34-8-26 10 10 22 60 18 94-12" stroke-dasharray="2 9" />
      <path class="f-paper" d="M132 80l92-52-34 100-24-30z" />
      <path class="f-soft" d="M166 98l58-70-68 64z" />
      <path d="M166 98l-6 28 20-20" />
    </svg>
  )
}

<style>
  .ill {
    fill: none;
    stroke: var(--t-ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  .ill :global(.no-stroke) {
    stroke: none;
  }
  .f-soft {
    fill: var(--t-accent-soft);
  }
  .f-sun {
    fill: var(--t-highlight);
  }
  .f-accent {
    fill: var(--t-accent);
  }
  .f-paper {
    fill: var(--t-paper);
  }
  .ill-label {
    fill: var(--t-ink);
    stroke: none;
    font-family: var(--t-font-display);
    font-weight: 800;
    font-size: 22px;
    text-anchor: middle;
  }
  .ill-label--big {
    font-size: 30px;
  }
</style>
