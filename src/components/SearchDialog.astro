---
/**
 * Site search. Pagefind indexes the built pages after `astro build` (see the build
 * script in package.json) and writes dist/pagefind/. The UI script is loaded the first
 * time the dialog opens, so pages carry no search weight until someone searches.
 * In `astro dev` there is no index, and the dialog says so.
 */
import { useTranslations } from '../i18n/ui';
import { withBase } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<dialog
  id="site-search"
  class="m-0 h-dvh max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-midnight/70 backdrop:backdrop-blur-sm"
  aria-label={t('nav.search')}
  data-pagefind-base={withBase('/pagefind/')}
  data-placeholder={t('nav.searchPlaceholder')}
>
  <div class="mx-auto mt-[8vh] w-[min(46rem,calc(100%-2rem))] rounded-card bg-white p-5 shadow-2xl md:p-7">
    <div class="flex items-center justify-between gap-4">
      <p class="eyebrow text-muted">{t('nav.search')}</p>
      <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-control text-ink hover:bg-mist" data-search-close>
        <span class="sr-only">{t('nav.close')}</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <div id="search-ui" class="mt-3 max-h-[65vh] overflow-y-auto"></div>
    <p class="mt-3 hidden text-sm text-muted" data-search-unavailable>Search is built with the site. Run <code>npm run build</code> and <code>npm run preview</code> to try it locally.</p>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('site-search') as HTMLDialogElement | null;
  let loaded: Promise<void> | null = null;

  function load() {
    if (!dialog) return Promise.resolve();
    const base = dialog.dataset.pagefindBase!;
    loaded ??= new Promise<void>((resolve, reject) => {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = `${base}pagefind-ui.css`;
      document.head.append(css);
      const s = document.createElement('script');
      s.src = `${base}pagefind-ui.js`;
      s.onload = () => {
        // @ts-expect-error PagefindUI is a global from pagefind-ui.js
        new window.PagefindUI({
          element: '#search-ui',
          showSubResults: true,
          showImages: false,
          resetStyles: false,
          translations: { placeholder: dialog.dataset.placeholder },
        });
        resolve();
      };
      s.onerror = () => reject(new Error('no index'));
      document.head.append(s);
    });
    return loaded;
  }

  function open() {
    if (!dialog) return;
    dialog.showModal();
    load()
      .then(() => dialog.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.focus())
      .catch(() => dialog.querySelector('[data-search-unavailable]')?.classList.remove('hidden'));
  }

  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
  dialog?.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
  // Clicking the backdrop closes the dialog.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      open();
    }
  });
</script>

<style is:global>
  /* Pagefind UI in the site's tokens. */
  #search-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: #1f55c8;
    --pagefind-ui-text: #0b1631;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #d9e0ec;
    --pagefind-ui-tag: #eef2f8;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-font: "Commissioner Variable", system-ui, sans-serif;
  }
  #search-ui mark {
    background: #ffd9cb;
    color: inherit;
  }
</style>
