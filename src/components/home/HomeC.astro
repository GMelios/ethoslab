---
/**
 * Direction C: data-forward (in the spirit of focaldata.com).
 * White and electric blue, mono labels, proof numbers up front, partner logos,
 * and live charts where other sites would put product screenshots.
 */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import EffectSizeChart from '../EffectSizeChart.astro';
import WorkCard from '../WorkCard.astro';
import PartnerGrid from '../PartnerGrid.astro';
import { getWork, getResearch, RESEARCH_TYPES, formatDate } from '../../lib/content';
import { getLocalized, localePath } from '../../i18n/utils';
import { useTranslations } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import { proof } from '../../data/site';

interface Props {
  lang: Locale;
  homeHref?: string;
}
const { lang, homeHref } = Astro.props;
const t = useTranslations(lang);
const work = await getWork(lang);
const bySlug = (s: string) => work.find((w) => w.slug === s);
const letters = bySlug('benefit-letters-trial');
const subsidy = bySlug('youth-hiring-subsidy');
const trust = bySlug('trust-local-government');
const cases = work.filter((w) => w.data.headline).slice(0, 3);
const research = (await getResearch(lang, { realFirst: true })).slice(0, 4);
const newest = research.find((r) => !r.data.placeholder) ?? research[0];
const rwi = (await getLocalized('products', lang)).find((p) => p.slug === 'reframing-welfare-index');

// Hero dashboard figures, derived from the letters trial so they stay consistent.
const primary = letters?.data.results?.effects.find((e) => e.label.includes('SMS'));
const control = primary?.controlMean;
const treated = control !== undefined && primary ? control + primary.estimate : undefined;

const capabilities = [
  {
    eyebrow: 'Experiments',
    title: 'Randomised trials and survey experiments',
    body: 'Field trials inside real administrative processes, and experiments fielded in several countries at once. Power calculations, pre-analysis plans and balance checks come as standard.',
    link: '/what-we-do/#trials',
    entry: trust,
    groups: ['All five countries'],
  },
  {
    eyebrow: 'Evaluation',
    title: 'Quasi-experimental evaluation on administrative data',
    body: 'When a policy cannot be randomised, we use rollouts, thresholds and rule changes to build a credible comparison, with modern estimators and honest inference.',
    link: '/what-we-do/#quasi',
    entry: subsidy,
    groups: ['Eligible workers, aged 18 to 24'],
  },
];
---

<Base title="Ethos Lab" description="Causal evidence for European public policy: randomised trials, evaluation and survey experiments." lang={lang} theme="c" path="/" homeHref={homeHref}>
  {
    newest && (
      <a slot="before-header" href={newest.data.url ?? localePath(lang, '/research/')} class="block bg-inverse text-on-inverse">
        <span class="wrap flex items-center justify-center gap-3 py-2.5 text-center text-sm">
          <span class="rounded bg-on-inverse px-1.5 py-0.5 font-label text-[0.65rem] font-bold tracking-wider text-inverse uppercase">New</span>
          <span class="line-clamp-2 sm:truncate">
            {RESEARCH_TYPES[newest.data.type]}: {newest.data.title}
          </span>
          <span aria-hidden="true">→</span>
        </span>
      </a>
    )
  }

  <!-- Hero -->
  <section class="overflow-hidden">
    <div class="wrap grid grid-cols-[minmax(0,1fr)] items-center gap-14 pt-14 pb-16 md:pt-20 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:pb-24">
      <div>
        <p class="eyebrow text-accent">Causal evidence for public policy</p>
        <h1 class="display mt-5 text-[2.8rem] text-ink sm:text-6xl lg:text-[4.1rem]">
          Measure the <span class="text-accent">effect</span>, not just the trend.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
          Randomised trials, quasi-experimental evaluation and multi-country survey experiments for European governments and funders. Transparent, reproducible, and always reported with confidence intervals.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href={localePath(lang, '/contact/')} class="btn btn-primary">{t('cta.talk')}</a>
          <a href={localePath(lang, '/work/')} class="btn text-ink hover:text-accent">See the evidence <span aria-hidden="true">→</span></a>
        </div>
      </div>

      {
        letters?.data.results && (
          <div class="relative">
            <div class="absolute -inset-x-10 -inset-y-8 -z-10 rounded-[2rem] bg-[radial-gradient(60%_60%_at_60%_40%,var(--t-accent-soft),transparent)]" aria-hidden="true" />
            <div class="rounded-card border border-line bg-paper shadow-[0_24px_60px_-24px_rgb(11_18_32/0.25)]">
              <div class="flex items-center gap-2 border-b border-line px-4 py-3">
                <span class="h-2.5 w-2.5 rounded-full bg-line" /><span class="h-2.5 w-2.5 rounded-full bg-line" /><span class="h-2.5 w-2.5 rounded-full bg-line" />
                <span class="ml-3 truncate font-label text-[0.7rem] text-muted">evaluation / benefit-take-up / results</span>
                {letters.data.illustrative && <span class="sample-badge ml-auto">Illustrative</span>}
              </div>
              <div class="p-5 md:p-6">
                <div class="grid grid-cols-3 gap-3">
                  <div class="rounded-control bg-surface p-2.5 sm:p-3">
                    <p class="font-label text-[0.62rem] tracking-wide text-muted uppercase">Control</p>
                    <p class="mt-1 text-lg font-semibold sm:text-2xl text-ink">{control?.toFixed(1)}%</p>
                  </div>
                  <div class="rounded-control bg-accent-soft p-2.5 sm:p-3">
                    <p class="font-label text-[0.62rem] tracking-wide text-muted uppercase">Letter + SMS</p>
                    <p class="mt-1 text-lg font-semibold sm:text-2xl text-accent">{treated?.toFixed(1)}%</p>
                  </div>
                  <div class="rounded-control bg-surface p-2.5 sm:p-3">
                    <p class="font-label text-[0.62rem] tracking-wide text-muted uppercase">Randomised</p>
                    <p class="mt-1 text-lg font-semibold sm:text-2xl text-ink">36,000</p>
                  </div>
                </div>
                <div class="mt-5">
                  <EffectSizeChart results={letters.data.results} lang={lang} groups={['Applied within 60 days', 'Approved within 90 days']} compact />
                </div>
              </div>
            </div>
            {
              letters.data.preregistration && (
                <p class="absolute -bottom-5 left-4 flex items-center gap-2 rounded-full border border-line bg-paper px-3.5 py-2 text-xs font-medium text-ink shadow-md sm:left-8">
                  <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 text-accent" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 8.5l3 3 7-7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  Pre-registered · {letters.data.preregistration.registry}
                </p>
              )
            }
          </div>
        )
      }
    </div>
  </section>

  <!-- Logos -->
  <section class="border-y border-line bg-surface/60" aria-labelledby="logos-heading">
    <div class="wrap py-12">
      <h2 id="logos-heading" class="text-center font-label text-xs font-semibold tracking-[0.12em] text-muted uppercase">
        Trusted by public bodies, universities and civil society across Europe
      </h2>
      <PartnerGrid variant="strip" class="mt-8" />
    </div>
  </section>

  <!-- Proof numbers -->
  <section class="wrap py-16 md:py-24" aria-labelledby="proof-heading">
    <h2 id="proof-heading" class="sr-only">Ethos Lab in numbers</h2>
    <dl class="grid grid-cols-1 gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        proof.map((p) => (
          <div class="flex flex-col bg-paper p-7">
            <dt class="order-2 mt-3 text-[0.95rem] leading-snug text-muted">{p.label}</dt>
            <dd class="order-1 font-display text-5xl font-semibold tracking-tight text-ink md:text-6xl">{p.value}</dd>
            <dd class="order-3 mt-4">{p.placeholder ? <span class="sample-badge">Sample figure</span> : <span class="font-label text-[0.65rem] text-muted uppercase">Source: {p.source}</span>}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Capabilities -->
  <section class="wrap space-y-20 pb-20 md:space-y-28 md:pb-28" aria-label="What we do">
    {
      capabilities.map((c, i) => (
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
          <div class:list={[i % 2 === 1 && 'lg:order-2']}>
            <p class="eyebrow text-accent">{c.eyebrow}</p>
            <h2 class="display mt-4 text-3xl text-ink md:text-[2.6rem]">{c.title}</h2>
            <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted">{c.body}</p>
            <a href={localePath(lang, c.link)} class="mt-6 inline-flex items-center gap-2 font-semibold text-ink hover:text-accent">
              Explore <span aria-hidden="true">›</span>
            </a>
          </div>
          {c.entry?.data.results && (
            <div class="rounded-card border border-line bg-paper p-5 shadow-[0_18px_40px_-24px_rgb(11_18_32/0.2)] md:p-7">
              <EffectSizeChart results={c.entry.data.results} lang={lang} groups={c.groups} compact />
              <p class="mt-4 flex flex-wrap items-center gap-2 border-t border-line pt-4 text-xs text-muted">
                From: <a class="font-medium text-ink hover:text-accent" href={localePath(lang, `/work/${c.entry.slug}/`)}>{c.entry.data.title}</a>
                {c.entry.data.illustrative && <span class="sample-badge">Illustrative</span>}
                {c.entry.data.provisional && <span class="sample-badge" title={c.entry.data.provisional}>Provisional</span>}
              </p>
            </div>
          )}
        </div>
      ))
    }
    {
      rwi && (
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
          <div>
            <p class="eyebrow text-accent">Data products</p>
            <h2 class="display mt-4 text-3xl text-ink md:text-[2.6rem]">{rwi.data.title}</h2>
            <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted">{rwi.data.summary}</p>
            <a href={localePath(lang, '/products/')} class="mt-6 inline-flex items-center gap-2 font-semibold text-ink hover:text-accent">
              Explore <span aria-hidden="true">›</span>
            </a>
          </div>
          {rwi.data.cover && (
            <div class="overflow-hidden rounded-card border border-line shadow-[0_18px_40px_-24px_rgb(11_18_32/0.2)]">
              <Image src={rwi.data.cover} alt={`${rwi.data.title} interface`} widths={[600, 1100]} sizes="(min-width: 1024px) 560px, 92vw" class="w-full" />
            </div>
          )}
        </div>
      )
    }
  </section>

  <!-- Case studies -->
  <section class="border-t border-line bg-surface/60" aria-labelledby="cases-heading">
    <div class="wrap py-16 md:py-24">
      <div class="flex items-end justify-between gap-6">
        <div>
          <p class="eyebrow text-accent">Case studies</p>
          <h2 id="cases-heading" class="display mt-4 text-3xl text-ink md:text-[2.6rem]">Results, with the uncertainty shown</h2>
        </div>
        <a href={localePath(lang, '/work/')} class="hidden shrink-0 font-semibold text-ink hover:text-accent sm:inline">All work ›</a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {cases.map((w) => <WorkCard entry={w} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- Research -->
  <section class="wrap py-16 md:py-24" aria-labelledby="reports-heading">
    <div class="flex items-end justify-between gap-6">
      <h2 id="reports-heading" class="display text-3xl text-ink md:text-[2.6rem]">Reports and papers</h2>
      <a href={localePath(lang, '/research/')} class="shrink-0 font-semibold text-ink hover:text-accent">All research ›</a>
    </div>
    <ul class="mt-8 divide-y divide-line border-y border-line" role="list">
      {
        research.map((r) => (
          <li class="group relative grid gap-1 py-5 md:grid-cols-[10rem_1fr_auto] md:items-center md:gap-6">
            <span class="font-label text-xs tracking-wide text-accent uppercase">{RESEARCH_TYPES[r.data.type]}</span>
            <span class="font-medium text-ink group-hover:text-accent">
              {r.data.url ? <a href={r.data.url} class="after:absolute after:inset-0" rel="noopener">{r.data.title}</a> : r.data.title}
              {r.data.placeholder && <span class="sample-badge ml-2 align-middle">Sample</span>}
            </span>
            <span class="font-label text-xs text-muted">{formatDate(r.data.date, lang, { month: 'short', year: 'numeric' })}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- CTA -->
  <section class="wrap pb-16 md:pb-24" aria-labelledby="cta-heading">
    <div class="relative overflow-hidden rounded-card bg-inverse px-8 py-14 text-on-inverse md:px-14 md:py-20">
      <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-accent/40 blur-3xl" aria-hidden="true" />
      <p class="eyebrow text-on-inverse/60">Start here</p>
      <h2 id="cta-heading" class="display mt-4 max-w-2xl text-3xl md:text-5xl">Get a design, a power calculation and a price within a week.</h2>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={localePath(lang, '/contact/')} class="btn btn-primary">{t('cta.talk')}</a>
        <a href={localePath(lang, '/what-we-do/')} class="btn border border-on-inverse/30 text-on-inverse hover:border-on-inverse">How we work</a>
      </div>
    </div>
  </section>
</Base>
