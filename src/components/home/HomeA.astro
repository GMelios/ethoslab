---
/**
 * Direction A: editorial and research-led (in the spirit of J-PAL, More in Common).
 * Serif display type, rules instead of boxes, evidence shown before claims.
 */
import Base from '../../layouts/Base.astro';
import EffectSizeChart from '../EffectSizeChart.astro';
import ResearchItem from '../ResearchItem.astro';
import CtaBand from '../CtaBand.astro';
import { getWork, getResearch, sectorLabel } from '../../lib/content';
import { localePath } from '../../i18n/utils';
import { useTranslations } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import { services, standards } from '../../data/services';
import { partners, methods } from '../../data/site';

interface Props {
  lang: Locale;
  homeHref?: string;
}
const { lang, homeHref } = Astro.props;
const t = useTranslations(lang);
const work = await getWork(lang);
const caseStudies = work.filter((w) => w.data.results);
const lead = caseStudies[0];
const research = (await getResearch(lang, { realFirst: true })).slice(0, 3);
const projects = work.filter((w) => !w.data.results && w.data.featured).slice(0, 3);
---

<Base title="Ethos Lab" description="Randomised trials and causal evaluation for European public policy." lang={lang} theme="a" path="/" homeHref={homeHref}>
  <!-- Hero -->
  <section class="border-b border-line">
    <div class="wrap grid gap-12 py-14 md:py-20 lg:grid-cols-12 lg:gap-16 lg:py-24">
      <div class="lg:col-span-7">
        <p class="eyebrow text-accent">Causal evidence for European public policy</p>
        <h1 class="display mt-6 text-[2.75rem] text-ink sm:text-6xl lg:text-[4.6rem]">Know what works before you scale it.</h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-muted md:text-xl">
          We design randomised trials and quasi-experimental evaluations for governments, agencies and foundations across Europe. Academic methods, every analytic choice reported, delivered on a policy timetable.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={localePath(lang, '/work/')} class="btn btn-primary">{t('cta.seeWork')}</a>
          <a href={localePath(lang, '/research/')} class="btn btn-ghost">{t('cta.readResearch')}</a>
        </div>
      </div>

      {
        lead?.data.results && (
          <aside class="lg:col-span-5 lg:border-l lg:border-line lg:pl-12" aria-labelledby="finding-heading">
            <p class="eyebrow flex items-center gap-3 text-muted">
              Latest evaluation {lead.data.illustrative && <span class="sample-badge">Illustrative</span>}
              {lead.data.provisional && <span class="sample-badge" title={lead.data.provisional}>Provisional</span>}
            </p>
            <h2 id="finding-heading" class="display mt-4 text-2xl !leading-snug text-ink">
              <a href={localePath(lang, `/work/${lead.slug}/`)} class="hover:underline hover:decoration-1 hover:underline-offset-4">{lead.data.title}</a>
            </h2>
            <div class="mt-7 border-t border-line pt-6">
              <EffectSizeChart results={lead.data.results} lang={lang} groups={[lead.data.results.effects[0].group!]} compact />
            </div>
            <a href={localePath(lang, `/work/${lead.slug}/`)} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline">
              Read the evaluation <span aria-hidden="true">→</span>
            </a>
          </aside>
        )
      }
    </div>
  </section>

  <!-- Mission -->
  <section class="wrap py-20 md:py-28" aria-label="Mission">
    <p class="display mx-auto max-w-4xl text-center text-[1.75rem] !leading-[1.3] !font-normal text-ink md:text-[2.4rem]">
      Every year, European governments spend billions on programmes that have never been tested. Some work, some do nothing, and a few do harm.{' '}
      <span class="text-accent">We exist to tell the difference, and to say so plainly.</span>
    </p>
  </section>

  <!-- Selected evaluations -->
  <section class="border-t border-line" aria-labelledby="evaluations-heading">
    <div class="wrap py-16 md:py-20">
      <div class="flex items-end justify-between gap-6">
        <h2 id="evaluations-heading" class="display text-3xl text-ink md:text-4xl">Selected evaluations</h2>
        <a href={localePath(lang, '/work/')} class="hidden shrink-0 text-sm font-semibold text-accent hover:underline sm:inline">All work →</a>
      </div>
      <div class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          caseStudies.slice(0, 3).map((c) => (
            <article class="group relative border-t-2 border-ink pt-6">
              <p class="eyebrow text-accent">{sectorLabel(c.data.sectors[0], lang)}</p>
              {c.data.headline && (
                <p class="mt-5 font-body text-5xl font-semibold tracking-tight text-ink">{c.data.headline.value}</p>
              )}
              {c.data.headline && <p class="mt-2 text-sm leading-snug text-muted">{c.data.headline.label}</p>}
              <h3 class="display mt-6 text-xl !leading-snug text-ink">
                <a href={localePath(lang, `/work/${c.slug}/`)} class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">
                  {c.data.title}
                </a>
              </h3>
              <p class="mt-4 flex flex-wrap items-center gap-2 text-xs text-muted">
                {c.data.design}
                {c.data.illustrative && <span class="sample-badge">Illustrative</span>}
                {c.data.provisional && <span class="sample-badge" title={c.data.provisional}>Provisional</span>}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What we do -->
  <section class="border-t border-line bg-surface/70" aria-labelledby="services-heading">
    <div class="wrap grid gap-12 py-16 md:py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow text-accent">{t('nav.whatWeDo')}</p>
        <h2 id="services-heading" class="display mt-4 text-3xl text-ink md:text-4xl">One question, asked rigorously: did it work?</h2>
        <a href={localePath(lang, '/what-we-do/')} class="btn btn-ghost mt-8">How we work</a>
      </div>
      <ol class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8">
        {
          services.map((s, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-2 border-t border-line py-6">
              <span class="font-display text-lg text-accent">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-lg font-semibold text-ink">
                  <a href={localePath(lang, `/what-we-do/#${s.id}`)} class="hover:underline hover:underline-offset-4">{s.title}</a>
                </h3>
                <p class="mt-1.5 text-[0.95rem] leading-relaxed text-muted">{s.short}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Standards -->
  <section class="bg-inverse text-on-inverse" aria-labelledby="standards-heading">
    <div class="wrap py-16 md:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-on-inverse/60">Our standards</p>
          <h2 id="standards-heading" class="display mt-4 text-3xl md:text-5xl">The rules of a peer-reviewed journal, applied to policy work.</h2>
        </div>
        <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:col-span-7">
          {
            standards.map((s) => (
              <div class="border-t border-on-inverse/25 pt-4">
                <dt class="text-lg font-semibold">{s.title}</dt>
                <dd class="mt-2 leading-relaxed text-on-inverse/75">{s.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <p class="mt-14 border-t border-on-inverse/25 pt-6 text-sm leading-loose text-on-inverse/70">
        <span class="eyebrow mr-3 text-on-inverse/50">Methods</span>
        {methods.join(' · ')}
      </p>
    </div>
  </section>

  <!-- Research -->
  <section aria-labelledby="research-heading">
    <div class="wrap py-16 md:py-20">
      <div class="flex items-end justify-between gap-6 border-b-2 border-ink pb-4">
        <h2 id="research-heading" class="display text-3xl text-ink md:text-4xl">Latest research</h2>
        <a href={localePath(lang, '/research/')} class="shrink-0 text-sm font-semibold text-accent hover:underline">All research →</a>
      </div>
      <div class="grid gap-10 pt-8 md:grid-cols-3 md:gap-8">
        {research.map((r) => <ResearchItem entry={r} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- Current projects -->
  {
    projects.length > 0 && (
      <section class="border-t border-line" aria-labelledby="projects-heading">
        <div class="wrap grid gap-10 py-16 md:py-20 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <h2 id="projects-heading" class="display text-3xl text-ink md:text-4xl">In European research consortia</h2>
            <p class="mt-4 leading-relaxed text-muted">We lead evaluation and evidence work in Horizon Europe and Erasmus+ projects.</p>
          </div>
          <ul class="divide-y divide-line border-y border-line lg:col-span-8">
            {projects.map((p) => (
              <li class="group relative grid gap-2 py-5 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-6">
                <div>
                  <h3 class="font-display text-xl text-ink group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">
                    <a href={localePath(lang, `/work/${p.slug}/`)} class="after:absolute after:inset-0">{p.data.title}</a>
                  </h3>
                  <p class="mt-1 line-clamp-2 text-sm text-muted">{p.data.summary}</p>
                </div>
                <p class="eyebrow text-muted">{p.data.programmes?.filter((x) => !['EU-funded', 'Public policy'].includes(x)).join(', ')}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Partners as an editorial list -->
  <section class="border-t border-line" aria-labelledby="partners-heading">
    <div class="wrap py-16 md:py-20">
      <h2 id="partners-heading" class="eyebrow text-muted">We have worked with</h2>
      <p class="display mt-6 max-w-5xl text-2xl !font-normal !leading-normal text-ink/85 md:text-[1.75rem]">
        {partners.map((p, i) => <>{p.name}{i < partners.length - 1 && <><span class="text-accent" aria-hidden="true">&nbsp;·</span>{' '}</>}</>)}
      </p>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
