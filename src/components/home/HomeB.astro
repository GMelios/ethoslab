---
/**
 * Direction B: warm and illustrated (in the spirit of lorefully.com).
 * Cream and plum, monoline drawings, rounded cards and pill buttons,
 * plain-language copy that leads with people rather than methods.
 *
 * Copy: "Ethos Lab homepage copy (v2)", built around two products, Ethos Test and
 * Ethos Evaluation (src/data/offer.ts). Everything tagged "Placeholder" is a [TODO]
 * in that brief: replace it with real, permissioned content before launch.
 */
import Base from '../../layouts/Base.astro';
import Illustration from '../illustrations/Illustration.astro';
import Placeholder from '../Placeholder.astro';
import { products, closingCta } from '../../data/offer';
import { localePath } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  lang: Locale;
  homeHref?: string;
}
const { lang, homeHref } = Astro.props;

const loop = [
  { ill: 'test', title: 'Test', body: 'Before you commit the budget, find the version that works with the people it is meant for.' },
  { ill: 'plane', title: 'Launch', body: 'Roll out with confidence, knowing what to expect.' },
  { ill: 'explain', title: 'Evaluate', body: 'Prove the impact at scale, and learn what to improve next time.' },
] as const;

const reasons: { title: string; body: string; todo?: string }[] = [
  { title: 'We answer the causal question.', body: 'Most reporting says what happened. We establish what caused it.' },
  {
    title: 'Research-grade methods.',
    body: 'Our work is led by researchers who teach causal inference and publish in leading peer-reviewed journals.',
    todo: 'Confirm wording and whether to name universities',
  },
  { title: 'Senior people, start to finish.', body: 'The people who design your study are the people who deliver it.' },
  { title: 'Evidence that stands up to scrutiny.', body: 'We have no stake in any programme’s success, only in getting the answer right.' },
];

const audiences = [
  { ill: 'ministry', title: 'Ministries and agencies', body: 'Test a reform on a small scale before national rollout, then evaluate it.' },
  { ill: 'town', title: 'Cities and regions', body: 'Find which services and communications change behaviour, and prove it to funders.' },
  { ill: 'company', title: 'Companies', body: 'Test messages, products and ESG initiatives before launch, and measure real impact after.' },
  { ill: 'seedling', title: 'Foundations and NGOs', body: 'Show funders what your programme achieved, with evidence you can stand behind.' },
  { ill: 'network', title: 'EU research consortia', body: 'We design and deliver the testing and evaluation work packages.' },
] as const;

const link = 'inline-flex items-center gap-2 font-semibold text-ink underline decoration-2 decoration-highlight underline-offset-[6px] hover:decoration-accent';
---

<Base
  title="Ethos Lab | Know before. Prove after."
  rawTitle
  description="Ethos Lab tests ideas with real people before launch and evaluates what worked after. For governments, organisations and research consortia across Europe."
  lang={lang}
  theme="b"
  path="/"
  homeHref={homeHref}
>
  <!-- Hero -->
  <section class="wrap grid items-center gap-10 pt-12 pb-16 md:pt-20 lg:grid-cols-2 lg:gap-6 lg:pb-20">
    <div>
      <h1 class="display text-[2.9rem] text-ink sm:text-6xl lg:text-[4.4rem]">
        Know before.
        <span class="block text-display-accent">Prove after.</span>
      </h1>
      <p class="mt-7 max-w-lg text-lg leading-relaxed text-ink/80">
        We test your ideas with real people before you launch them, and prove whether they worked afterwards. For governments, organisations and research consortia across Europe.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href={localePath(lang, '/contact/')} class="btn btn-primary !px-6">Talk to us</a>
        {products.map((p) => <a href={localePath(lang, p.path)} class={link}>{p.name} <span aria-hidden="true">→</span></a>)}
      </div>
    </div>
    <Illustration name="hero" class="mx-auto w-full max-w-[34rem]" />
  </section>

  <!-- Two products -->
  <section class="wrap pb-16 md:pb-24" aria-label="Ethos Test and Ethos Evaluation">
    <div class="grid gap-5 md:grid-cols-2">
      {
        products.map((p) => (
          <article class="flex flex-col gap-6 rounded-card bg-surface p-7 md:row-span-7 md:grid md:grid-rows-subgrid md:gap-y-6 md:p-10">
            <header class="flex items-start justify-between gap-6">
              <div>
                <h2 class="display text-3xl text-ink md:text-[2.6rem]">{p.name}</h2>
                <p class="display mt-2 text-2xl text-display-accent md:text-3xl">{p.tagline}</p>
              </div>
              <Illustration name={p.illustration} class="h-20 w-auto shrink-0 md:h-24" />
            </header>
            <div>
              <p class="eyebrow text-accent">For</p>
              <p class="mt-1.5 leading-relaxed text-ink/80">{p.for}</p>
            </div>
            <div>
              <p class="eyebrow text-accent">Typical questions</p>
              <p class="relative mt-3 rounded-2xl border-2 border-ink bg-paper px-5 py-4 leading-snug font-bold text-balance text-ink">
                “{p.questions}”
                <svg class="absolute -bottom-[12px] left-7 h-[14px] w-[16px]" viewBox="0 0 16 14" aria-hidden="true">
                  <path d="M1 0v12L15 0" fill="var(--t-paper)" stroke="var(--t-ink)" stroke-width="2" stroke-linejoin="round" />
                </svg>
              </p>
            </div>
            <div class="md:pt-2">
              <p class="eyebrow text-accent">What we do</p>
              <p class="mt-1.5 leading-relaxed text-ink/80">{p.weDo}</p>
            </div>
            <div>
              <p class="eyebrow text-accent">You receive</p>
              <p class="mt-1.5 leading-snug font-semibold text-ink">{p.youReceive}</p>
            </div>
            <dl class="flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-5">
              {p.todos.map((t) => (
                <div>
                  <dt class="eyebrow text-accent">{t.label}</dt>
                  <dd class="mt-1.5"><Placeholder note={t.note} /></dd>
                </div>
              ))}
            </dl>
            <a href={localePath(lang, p.path)} class="btn btn-primary self-start !px-6 md:justify-self-start">
              Explore {p.name} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
    <p class="mx-auto mt-10 max-w-3xl text-center text-lg leading-relaxed text-ink/80">
      Not sure which you need? Tell us the decision you face and we will tell you honestly.
      <a href={localePath(lang, '/contact/')} class={`${link} ml-1`}>Talk to us</a>
    </p>
  </section>

  <!-- How they fit together -->
  <section class="bg-surface theme-b:mx-3 theme-b:rounded-card" aria-labelledby="loop-heading">
    <div class="wrap py-16 md:py-24">
      <h2 id="loop-heading" class="display mx-auto max-w-2xl text-center text-3xl text-ink md:text-[2.6rem]">Test. Launch. Evaluate.</h2>
      <ol class="relative mt-14 grid gap-12 md:grid-cols-3 md:gap-8">
        <svg class="pointer-events-none absolute top-14 right-[16%] left-[16%] hidden h-8 md:block" viewBox="0 0 600 30" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 15C100 3 200 3 300 15S500 27 600 15" fill="none" stroke="var(--t-ink)" stroke-width="2" stroke-dasharray="2 9" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        </svg>
        {
          loop.map((s, i) => (
            <li class="relative text-center">
              <div class="mx-auto flex h-36 w-36 items-center justify-center rounded-full bg-paper">
                <Illustration name={s.ill} class="h-24 w-auto" />
              </div>
              <p class="mt-6 text-sm font-bold text-accent">Step {i + 1}</p>
              <h3 class="mt-1 text-2xl font-extrabold text-ink">{s.title}</h3>
              <p class="mx-auto mt-3 max-w-xs leading-relaxed text-ink/75">{s.body}</p>
            </li>
          ))
        }
      </ol>
      <!-- The return path closes the loop: what you learn from evaluating feeds the next test. -->
      <div class="relative mt-10 md:mt-6">
        <svg class="pointer-events-none absolute inset-y-0 right-[16%] left-[16%] hidden md:block" viewBox="0 0 600 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M600 0C600 70 570 94 500 94H100C30 94 0 70 0 0" fill="none" stroke="var(--t-ink)" stroke-width="2" stroke-dasharray="2 9" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        </svg>
        <svg class="pointer-events-none absolute top-0 left-[16%] hidden h-3 w-4 -translate-x-1/2 -translate-y-1 md:block" viewBox="0 0 16 12" aria-hidden="true">
          <path d="M2 10l6-8 6 8" fill="none" stroke="var(--t-ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <p class="relative mx-auto max-w-xl text-center text-lg leading-snug font-bold text-ink md:px-6 md:pt-5 md:pb-12 md:text-xl">
          Many of our clients use both, so every decision is informed before and proven after.
        </p>
      </div>
    </div>
  </section>

  <!-- Why Ethos Lab -->
  <section class="wrap py-16 md:py-24" aria-labelledby="why-heading">
    <div class="rounded-card bg-accent px-7 py-12 text-on-accent md:px-14 md:py-16">
      <h2 id="why-heading" class="display max-w-2xl text-3xl md:text-[2.6rem]">Why organisations choose us</h2>
      <ul class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2">
        {
          reasons.map((r, i) => (
            <li class="border-t border-on-accent/25 pt-6">
              <p class="text-sm font-bold text-on-accent/60">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-2 text-xl leading-snug font-bold">{r.title}</h3>
              <p class="mt-2 leading-relaxed text-on-accent/80">{r.body}</p>
              {r.todo && <Placeholder note={r.todo} onAccent class="mt-3" />}
            </li>
          ))
        }
      </ul>
      <p class="mt-12 border-t border-on-accent/25 pt-6 leading-relaxed text-on-accent/80">
        We also partner with larger consultancies and implementers as their specialist for testing and impact evaluation.
      </p>
    </div>
  </section>

  <!-- Who we work with -->
  <section class="wrap pb-16 md:pb-24" aria-labelledby="audiences-heading">
    <h2 id="audiences-heading" class="display max-w-3xl text-3xl text-ink md:text-[2.6rem]">Who uses Ethos Test and Ethos Evaluation</h2>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {
        audiences.map((a) => (
          <li class="flex flex-col rounded-card bg-surface p-6">
            <h3 class="text-lg leading-snug font-bold text-ink">{a.title}</h3>
            <Illustration name={a.ill} class="my-6 h-24 w-auto self-center" />
            <p class="mt-auto text-[0.95rem] leading-relaxed text-ink/75">{a.body}</p>
          </li>
        ))
      }
    </ul>
    <Placeholder block note="Logo strip of real clients and partners, with permission" class="mt-10">
      <ul class="mt-6 grid grid-cols-3 gap-4 sm:grid-cols-6" aria-hidden="true">
        {Array.from({ length: 6 }, () => <li class="h-10 rounded-full bg-surface" />)}
      </ul>
    </Placeholder>
  </section>

  <!-- Proof -->
  <section class="wrap pb-16 md:pb-24" aria-labelledby="proof-heading">
    <h2 id="proof-heading" class="display text-3xl text-ink md:text-[2.6rem]">Recent work</h2>
    <p class="mt-4"><Placeholder note="Three real engagements, ideally at least one of each product" /></p>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {
        [1, 2, 3].map(() => (
          <article class="flex flex-col overflow-hidden rounded-card bg-surface">
            <div class="bg-accent px-6 pt-6 pb-5 text-on-accent">
              <p class="text-2xl font-semibold tracking-tight text-balance opacity-60">Headline number ± uncertainty</p>
              <p class="mt-1 text-sm leading-snug opacity-80">One line on what the result means</p>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="flex flex-wrap items-center gap-3">
                <span class="rounded-full border-2 border-dashed border-line px-3 py-0.5 text-xs font-semibold text-ink/60">Ethos Test or Ethos Evaluation</span>
                <span class="eyebrow text-accent">Client type</span>
              </p>
              <h3 class="mt-3 text-xl leading-snug font-semibold text-ink/60">The client’s question, in one line and in their words</h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">What we did, in one sentence</p>
              <div class="mt-auto flex flex-wrap items-center gap-2 pt-5 text-xs text-muted">
                <span>Year</span>
                <span class="sample-badge">Placeholder</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <figure class="mx-auto mt-16 max-w-4xl text-center md:mt-20">
      <svg viewBox="0 0 48 36" class="mx-auto h-10 w-auto text-accent" fill="currentColor" aria-hidden="true"><path d="M0 36V22C0 9 7 2 20 0l2 5c-7 2-10 7-10 13h9v18zm26 0V22C26 9 33 2 46 0l2 5c-7 2-10 7-10 13h9v18z" /></svg>
      <blockquote class="display mt-6 text-2xl !font-bold !leading-snug text-ink/40 md:text-4xl">One real client quote</blockquote>
      <figcaption class="mt-6 flex flex-wrap items-center justify-center gap-3 text-ink/70">
        Attributed by role and organisation type <span class="sample-badge">Placeholder</span>
      </figcaption>
    </figure>

    <p class="mt-12 text-center">
      <a href={localePath(lang, '/work/')} class={link}>All our work <span aria-hidden="true">→</span></a>
    </p>
  </section>

  <!-- Beyond the two products -->
  <section class="wrap pb-16 md:pb-24" aria-label="Beyond the two products">
    <div class="flex flex-col gap-6 rounded-card border-2 border-line p-7 md:flex-row md:items-center md:justify-between md:gap-12 md:p-10">
      <div class="max-w-2xl">
        <p class="text-lg leading-relaxed text-ink">
          We also train teams in behavioural testing and evaluation, and provide tools such as Experimentalist so you can run tests yourself.
        </p>
        <Placeholder note="Confirm how Experimentalist relates to Ethos Test" class="mt-3" />
      </div>
      <a href={localePath(lang, '/what-we-do/')} class={`${link} shrink-0`}>See everything we do <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- CTA -->
  <section class="wrap pb-16 md:pb-20" aria-labelledby="cta-heading">
    <div class="grid items-center gap-8 rounded-card bg-surface px-8 py-12 md:grid-cols-[1fr_auto] md:px-14">
      <div>
        <h2 id="cta-heading" class="display text-3xl text-ink md:text-5xl">{closingCta.title}</h2>
        <p class="mt-4 max-w-xl text-lg text-ink/75">{closingCta.body}</p>
        <a href={localePath(lang, '/contact/')} class="btn btn-primary mt-8 !px-6">{closingCta.button}</a>
      </div>
      <Illustration name="listen" class="w-48 md:w-64" />
    </div>
  </section>
</Base>
