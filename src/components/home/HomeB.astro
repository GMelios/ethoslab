---
/**
 * Direction B: warm and illustrated (in the spirit of lorefully.com).
 * Cream and plum, monoline drawings, rounded cards and pill buttons,
 * plain-language copy that leads with people rather than methods.
 *
 * Copy: "Ethos Lab homepage copy (v1)". Everything tagged "Placeholder" is a [TODO]
 * in that brief: replace it with real, permissioned content before launch.
 * Alternative hero headlines to try:
 *   What actually changes behaviour? We find out, and prove it.
 *   Less guessing about people. More evidence.
 */
import Base from '../../layouts/Base.astro';
import Illustration from '../illustrations/Illustration.astro';
import { localePath } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  lang: Locale;
  homeHref?: string;
}
const { lang, homeHref } = Astro.props;

const questions = [
  {
    question: 'Why aren’t people doing what we expected?',
    weDo: 'We diagnose the behavioural barriers using data, surveys and interviews.',
    youGet: 'A clear explanation of what is holding people back and where to act.',
  },
  {
    question: 'What should we do or say instead?',
    weDo: 'We design interventions, messages, choices and processes grounded in behavioural evidence.',
    youGet: 'Practical options, ready to test.',
  },
  {
    question: 'Will it work before we scale it?',
    weDo: 'We run experiments, pilots and message tests with real people.',
    youGet: 'A tested answer before you commit the budget.',
  },
  {
    question: 'Did it actually work?',
    weDo: 'We evaluate impact with rigorous causal methods, including on data you already hold.',
    youGet: 'Credible proof of the effect, for whom it worked, and why.',
  },
  {
    question: 'Can we do this ourselves?',
    weDo: 'We train teams, provide tools such as Experimentalist, and work embedded alongside you.',
    youGet: 'Lasting in-house capability.',
  },
];

const reasons: { title: string; body: string; todo?: string }[] = [
  {
    title: 'We answer the causal question.',
    body: 'Most evaluation reports what happened. We establish what caused it, so you know what to keep, fix or stop.',
  },
  {
    title: 'Research-grade methods.',
    body: 'Our work is led by researchers who teach causal inference and publish in leading peer-reviewed journals.',
    todo: 'Confirm wording and whether to name universities',
  },
  {
    title: 'Senior people, start to finish.',
    body: 'The people who design your study are the people who deliver it.',
  },
  {
    title: 'Evidence that stands up to scrutiny.',
    body: 'Our findings are built to withstand auditors, funders, the European Commission and the press. We have no stake in any programme’s success, only in getting the answer right.',
  },
];

const steps = [
  { ill: 'listen', title: 'Understand', body: 'We start with the decision you face and the people it affects, not with a method.' },
  { ill: 'test', title: 'Test', body: 'We compare what happens with and without your idea, fairly and in the real world.' },
  { ill: 'explain', title: 'Explain', body: 'You get a clear answer, how confident we are in it, and what to do next.' },
] as const;
---

<Base
  title="Ethos Lab | Evidence on how people behave, and what changes it"
  rawTitle
  description="Ethos Lab helps governments, organisations and research consortia understand how people actually behave, test what changes it, and prove what worked."
  lang={lang}
  theme="b"
  path="/"
  homeHref={homeHref}
>
  <!-- Hero -->
  <section class="wrap grid items-center gap-10 pt-12 pb-16 md:pt-20 lg:grid-cols-2 lg:gap-6 lg:pb-24">
    <div>
      <h1 class="display text-[2.9rem] text-ink sm:text-6xl lg:text-[4.1rem]">
        Decisions about people deserve
        <span class="block text-display-accent">evidence about people.</span>
      </h1>
      <p class="mt-7 max-w-lg text-lg leading-relaxed text-ink/80">
        We help governments, organisations and research consortia understand how people actually behave, test what changes it, and prove what worked.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href={localePath(lang, '/contact/')} class="btn btn-primary !px-6">Talk to us about your question</a>
        <a href="#how-we-help" class="inline-flex items-center gap-2 font-semibold text-ink underline decoration-2 decoration-highlight underline-offset-[6px] hover:decoration-accent">
          How we help <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <Illustration name="hero" class="mx-auto w-full max-w-[34rem]" />
  </section>

  <!-- The problem -->
  <section class="wrap pb-16 md:pb-24" aria-labelledby="problem-heading">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <p class="eyebrow text-accent">Why we exist</p>
        <h2 id="problem-heading" class="display mt-4 text-3xl text-ink md:text-[2.6rem]">Most decisions about people rest on assumptions.</h2>
      </div>
      <div class="lg:col-span-7 lg:pt-9">
        <p class="text-lg leading-relaxed text-ink/80">
          Policies, programmes, services and campaigns are designed around how people are expected to behave. Then they are judged on what was delivered: budgets spent, people reached, satisfaction scores. What rarely gets answered is the question that matters: did it change anything, and why?
        </p>
        <p class="mt-6 text-xl leading-snug font-bold text-ink md:text-2xl">
          We replace assumptions with evidence about real behaviour, and we measure what actually made the difference.
        </p>
      </div>
    </div>
  </section>

  <!-- What clients come to us for -->
  <section id="how-we-help" class="wrap scroll-mt-6 pb-16 md:pb-24" aria-labelledby="questions-heading">
    <div class="max-w-2xl">
      <h2 id="questions-heading" class="display text-3xl text-ink md:text-[2.6rem]">Bring us your question</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink/75">Every engagement starts with a question you need answered. These are the ones we hear most.</p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        questions.map((c) => (
          <article class="flex flex-col rounded-card bg-surface p-6 md:p-7">
            <h3 class="relative rounded-2xl border-2 border-ink bg-paper px-5 py-4 text-lg leading-snug font-bold text-balance text-ink">
              “{c.question}”
              <svg class="absolute -bottom-[12px] left-7 h-[14px] w-[16px]" viewBox="0 0 16 14" aria-hidden="true">
                <path d="M1 0v12L15 0" fill="var(--t-paper)" stroke="var(--t-ink)" stroke-width="2" stroke-linejoin="round" />
              </svg>
            </h3>
            <dl class="mt-8 flex flex-1 flex-col gap-5">
              <div>
                <dt class="eyebrow text-accent">What we do</dt>
                <dd class="mt-1.5 text-[0.95rem] leading-relaxed text-ink/75">{c.weDo}</dd>
              </div>
              <div class="mt-auto border-t border-line pt-4">
                <dt class="eyebrow text-accent">You get</dt>
                <dd class="mt-1.5 leading-snug font-semibold text-ink">{c.youGet}</dd>
              </div>
            </dl>
          </article>
        ))
      }
      <a href={localePath(lang, '/what-we-do/')} class="group flex min-h-48 flex-col justify-between rounded-card bg-accent p-6 text-on-accent md:p-7">
        <span class="display text-3xl md:text-[2.2rem]">See how we work</span>
        <span aria-hidden="true" class="flex h-14 w-14 items-center justify-center self-end rounded-full bg-on-accent text-2xl text-accent transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </section>

  <!-- Why Ethos Lab -->
  <section class="wrap pb-16 md:pb-24" aria-labelledby="why-heading">
    <div class="rounded-card bg-accent px-7 py-12 text-on-accent md:px-14 md:py-16">
      <h2 id="why-heading" class="display max-w-2xl text-3xl md:text-[2.6rem]">Why organisations choose us</h2>
      <ul class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2">
        {
          reasons.map((r, i) => (
            <li class="border-t border-on-accent/25 pt-6">
              <p class="text-sm font-bold text-on-accent/60">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-2 text-xl leading-snug font-bold">{r.title}</h3>
              <p class="mt-2 leading-relaxed text-on-accent/80">{r.body}</p>
              {r.todo && (
                <p class="mt-3 flex flex-wrap items-center gap-2 text-xs text-on-accent/70">
                  <span class="sample-badge !border-on-accent/50 !text-on-accent/80">Placeholder</span>
                  {r.todo}
                </p>
              )}
            </li>
          ))
        }
      </ul>
      <p class="mt-12 border-t border-on-accent/25 pt-6 leading-relaxed text-on-accent/80">
        We also work alongside larger consultancies and implementers as their specialist partner for behavioural research and impact evaluation.
      </p>
    </div>
  </section>

  <!-- How we work -->
  <section class="bg-surface theme-b:mx-3 theme-b:rounded-card" aria-labelledby="how-heading">
    <div class="wrap py-16 md:py-24">
      <h2 id="how-heading" class="display mx-auto max-w-2xl text-center text-3xl text-ink md:text-[2.6rem]">From question to answer in three steps</h2>
      <ol class="relative mt-14 grid gap-12 md:grid-cols-3 md:gap-8">
        <svg class="pointer-events-none absolute top-14 right-[16%] left-[16%] hidden h-8 md:block" viewBox="0 0 600 30" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 15C100 3 200 3 300 15S500 27 600 15" fill="none" stroke="var(--t-ink)" stroke-width="2" stroke-dasharray="2 9" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        </svg>
        {
          steps.map((s, i) => (
            <li class="relative text-center">
              <div class="mx-auto flex h-36 w-36 items-center justify-center rounded-full bg-paper">
                <Illustration name={s.ill} class="h-24 w-auto" />
              </div>
              <p class="mt-6 text-sm font-bold text-accent">Step {i + 1}</p>
              <h3 class="mt-1 text-2xl font-extrabold text-ink">{s.title}</h3>
              <p class="mx-auto mt-3 max-w-xs leading-relaxed text-ink/75">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Who we work with -->
  <section class="wrap py-16 md:py-24" aria-labelledby="audiences-heading">
    <div class="grid gap-6 lg:grid-cols-12 lg:gap-12">
      <h2 id="audiences-heading" class="display text-3xl text-ink md:text-[2.6rem] lg:col-span-5">Who we work with</h2>
      <p class="text-lg leading-relaxed text-ink/80 lg:col-span-7">
        Ministries and public agencies, cities and regions, companies, foundations and NGOs, and European research consortia. Our work spans democracy and governance, economy and labour, education, environment and sustainability, transport, and technology.
      </p>
    </div>
    <div class="mt-10 rounded-card border-2 border-dashed border-line p-6 md:p-8">
      <p class="flex flex-wrap items-center gap-2 text-sm text-muted">
        <span class="sample-badge">Placeholder</span>
        Logo strip of real clients and partners, with permission
      </p>
      <ul class="mt-6 grid grid-cols-3 gap-4 sm:grid-cols-6" aria-hidden="true">
        {Array.from({ length: 6 }, () => <li class="h-10 rounded-full bg-surface" />)}
      </ul>
    </div>
  </section>

  <!-- Proof -->
  <section class="wrap pb-16 md:pb-24" aria-labelledby="proof-heading">
    <h2 id="proof-heading" class="display text-3xl text-ink md:text-[2.6rem]">Recent work</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        [1, 2, 3].map(() => (
          <article class="flex flex-col overflow-hidden rounded-card bg-surface">
            <div class="bg-accent px-6 pt-6 pb-5 text-on-accent">
              <p class="text-2xl font-semibold tracking-tight text-balance opacity-60">Headline number ± uncertainty</p>
              <p class="mt-1 text-sm leading-snug opacity-80">One line on what the result means</p>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="eyebrow text-accent">Client type</p>
              <h3 class="mt-3 text-xl leading-snug font-semibold text-ink/60">The client’s question, in one line and in their words</h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">What we did, in one sentence, with the method in plain words</p>
              <div class="mt-auto flex flex-wrap items-center gap-2 pt-5 text-xs text-muted">
                <span>Year</span>
                <span class="sample-badge">Placeholder</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <figure class="mx-auto mt-16 max-w-4xl text-center md:mt-20">
      <svg viewBox="0 0 48 36" class="mx-auto h-10 w-auto text-accent" fill="currentColor" aria-hidden="true"><path d="M0 36V22C0 9 7 2 20 0l2 5c-7 2-10 7-10 13h9v18zm26 0V22C26 9 33 2 46 0l2 5c-7 2-10 7-10 13h9v18z" /></svg>
      <blockquote class="display mt-6 text-2xl !font-bold !leading-snug text-ink/40 md:text-4xl">
        One real client quote
      </blockquote>
      <figcaption class="mt-6 flex flex-wrap items-center justify-center gap-3 text-ink/70">
        Attributed by role and organisation type <span class="sample-badge">Placeholder</span>
      </figcaption>
    </figure>

    <p class="mt-12 text-center">
      <a href={localePath(lang, '/work/')} class="inline-flex items-center gap-2 font-semibold text-ink underline decoration-2 decoration-highlight underline-offset-[6px] hover:decoration-accent">
        All our work <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>

  <!-- CTA -->
  <section class="wrap pb-16 md:pb-20" aria-labelledby="cta-heading">
    <div class="grid items-center gap-8 rounded-card bg-surface px-8 py-12 md:grid-cols-[1fr_auto] md:px-14">
      <div>
        <h2 id="cta-heading" class="display text-3xl text-ink md:text-5xl">Have a question about people you need answered?</h2>
        <p class="mt-4 max-w-xl text-lg text-ink/75">Tell us what you are trying to find out. We will reply within two working days with an honest view of whether and how we can help.</p>
        <a href={localePath(lang, '/contact/')} class="btn btn-primary mt-8 !px-6">Start a conversation</a>
      </div>
      <Illustration name="plane" class="w-56 md:w-72" />
    </div>
  </section>
</Base>
