---
/**
 * Homepage. Each section sits on its own band (midnight, white, mist, deep blue,
 * orange) so the page reads as a sequence of distinct chapters.
 *
 * Copy: the hero, the two engagements and the closing call to action are from
 * "Ethos Lab homepage copy (v2)". Services, products, projects, domains, figures and
 * insights come from the current ethoslab.gr and the Room Wisdom pitch deck.
 */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Ribbons from '../Ribbons.astro';
import PartnerGrid from '../PartnerGrid.astro';
import WorkCard from '../WorkCard.astro';
import CtaBand from '../CtaBand.astro';
import { products as engagements } from '../../data/offer';
import { stages, domains, methodIntro } from '../../data/ethos';
import { events } from '../../data/events';
import { partners, site } from '../../data/site';
import { getLocalized, localePath } from '../../i18n/utils';
import { getWork, getResearch, formatDate, RESEARCH_TYPES } from '../../lib/content';
import type { Locale } from '../../i18n/config';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const productEntries = (await getLocalized('products', lang)).sort((a, b) => a.data.order - b.data.order);
const work = await getWork(lang);
// Prefer the larger, better-documented projects; fall back to whatever is listed first.
const preferred = ['multipod', 'benefits', 'heal'];
const selected = [...preferred.map((s) => work.find((w) => w.slug === s)).filter((w) => w !== undefined), ...work.filter((w) => !preferred.includes(w.slug))].slice(0, 3);
const papers = (await getResearch(lang)).filter((r) => !r.data.placeholder).slice(0, 1);

const figures = [
  { value: String(site.founded), label: 'Founded in Athens to bring academic methods to policy' },
  { value: String(work.length), label: 'Projects with public bodies, universities and companies' },
  { value: String(partners.length), label: 'Partner institutions across Europe and beyond' },
  { value: '228', label: 'European regions in the Reframing Welfare Index' },
  { value: '24', label: 'Official EU languages Room Wisdom analyses' },
];
const productHref = (slug: string) => localePath(lang, `/products/${slug}/`);
---

<Base
  title="Ethos Lab | Know before. Prove after."
  rawTitle
  description="Ethos Lab tests ideas with real people before launch and evaluates what worked after. For governments, organisations and research consortia across Europe."
  lang={lang}
  path="/"
>
  <!-- Hero -->
  <section class="band-midnight relative flex flex-col overflow-hidden">
    <div class="grid-dots pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_30%_40%,black,transparent_75%)]" aria-hidden="true"></div>
    <div class="pointer-events-none relative order-last h-52 sm:h-72 lg:absolute lg:inset-y-0 lg:right-0 lg:h-auto lg:w-[56%] lg:[mask-image:linear-gradient(90deg,transparent,black_38%)]">
      <Ribbons class="absolute inset-0 h-full w-full lg:top-[14%] lg:h-[72%]" />
    </div>
    <div class="wrap relative pt-16 pb-10 md:pt-24 lg:pt-28 lg:pb-32">
      <p class="eyebrow flex items-center gap-3 text-display-accent"><span class="h-0.5 w-8 bg-ember" aria-hidden="true"></span>Behavioural science and causal evidence</p>
      <h1 class="display h-hero mt-6 text-ink">
        Know before.
        <span class="block text-display-accent">Prove after.</span>
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-muted md:text-xl lg:max-w-[34rem]">
        We test your ideas with real people before you launch them, and prove whether they worked afterwards. For governments, organisations and research consortia across Europe.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href={localePath(lang, '/contact/')} class="btn btn-primary !px-6">Talk to us <span aria-hidden="true">→</span></a>
        <a href={localePath(lang, '/services/')} class="btn btn-ghost !px-6">Explore our services</a>
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="band-white border-b border-line" aria-labelledby="partners-heading">
    <div class="wrap py-12 md:py-14">
      <h2 id="partners-heading" class="eyebrow text-center text-muted">Partners and clients include</h2>
      <PartnerGrid variant="strip" class="mt-8" />
    </div>
  </section>

  <!-- The ETHOS method -->
  <section id="method" class="band-mist" aria-labelledby="method-heading">
    <div class="wrap py-20 md:py-28">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="eyebrow text-display-accent">How we work</p>
          <h2 id="method-heading" class="display h-section mt-4 text-ink">One method. It is also our name.</h2>
        </div>
        <p class="text-lg leading-relaxed text-muted lg:col-span-6">{methodIntro}</p>
      </div>

      <div class="mt-14 grid gap-3 lg:grid-cols-5">
        <!-- Brackets: which engagement covers which stages. -->
        {
          engagements.map((e) => (
            <a
              href={localePath(lang, e.path)}
              class:list={[
                'group hidden items-center gap-3 border-t-2 pt-3 text-sm font-semibold lg:flex',
                e.id === 'test' ? 'col-span-3 border-ink' : 'col-span-2 border-ember',
              ]}
            >
              <span class="text-ink group-hover:underline">{e.name}</span>
              <span class="text-muted">{e.tagline}</span>
            </a>
          ))
        }
        {
          stages.map((s) => (
            <article class="relative flex flex-col overflow-hidden rounded-card bg-paper p-6 lg:min-h-[19rem]">
              <p class="display text-[5.5rem] leading-none text-ember" aria-hidden="true">{s.letter}</p>
              <h3 class="mt-4 text-xl font-semibold text-ink">{s.name}</h3>
              <p class="mt-2 leading-relaxed text-muted">{s.line}</p>
              <p class="mt-auto pt-5 text-xs font-semibold text-muted lg:hidden">{s.engagement === 'test' ? 'Ethos Test' : 'Ethos Evaluation'}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-10"><a href={localePath(lang, '/services/')} class="link-arrow">See every stage in detail <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- Two engagements -->
  <section class="band-white" aria-label="Ethos Test and Ethos Evaluation">
    <div class="wrap grid gap-6 py-20 md:grid-cols-2 md:py-28">
      {
        engagements.map((e) => (
          <article class="group relative flex flex-col border-t-4 pt-8 first:border-ink last:border-ember">
            <p class="eyebrow text-muted">{e.stages}</p>
            <h2 class="display h-section mt-3 text-ink">{e.name}</h2>
            <p class="display mt-2 text-2xl text-display-accent md:text-3xl">{e.tagline}</p>
            <dl class="mt-8 space-y-5">
              <div>
                <dt class="eyebrow text-ink">For</dt>
                <dd class="mt-1.5 leading-relaxed text-muted">{e.for}</dd>
              </div>
              <div>
                <dt class="eyebrow text-ink">Typical questions</dt>
                <dd class="mt-1.5 text-lg leading-snug font-medium text-ink">“{e.questions}”</dd>
              </div>
              <div>
                <dt class="eyebrow text-ink">You receive</dt>
                <dd class="mt-1.5 leading-relaxed text-muted">{e.youReceive}</dd>
              </div>
            </dl>
            <a href={localePath(lang, e.path)} class="link-arrow mt-8 self-start after:absolute after:inset-0">Explore {e.name} <span aria-hidden="true">→</span></a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Products -->
  <section class="band-deep relative overflow-hidden" aria-labelledby="products-heading">
    <div class="grid-dots pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="wrap relative py-20 md:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow text-display-accent">Our products</p>
          <h2 id="products-heading" class="display h-section mt-4 max-w-2xl text-ink">Tools built on data we can defend</h2>
        </div>
        <a href={localePath(lang, '/products/')} class="link-arrow">All products <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {
          productEntries.map((p) => (
            <article class="group relative flex flex-col overflow-hidden rounded-card bg-white/[0.06] ring-1 ring-white/10 transition hover:bg-white/[0.09]">
              <div class:list={['flex aspect-[16/8] items-center justify-center overflow-hidden', p.slug === 'room-wisdom' ? 'bg-[#f6f5f1]' : 'bg-white']}>
                {p.data.cover && <Image src={p.data.cover} alt="" widths={[600, 1100]} sizes="(min-width: 1024px) 600px, 92vw" class:list={['h-full w-full', p.slug === 'room-wisdom' ? 'object-cover' : 'object-cover object-top']} />}
              </div>
              <div class="flex flex-1 flex-col p-7 md:p-9">
                <p class="eyebrow flex items-center gap-3 text-display-accent">
                  {p.data.kicker}
                  <span class="rounded-full border border-line px-2 py-0.5 text-[0.62rem] tracking-[0.1em] text-muted">{p.data.status === 'pilot' ? 'Pilot' : p.data.status === 'live' ? 'Live' : 'In development'}</span>
                </p>
                <h3 class="display mt-3 text-3xl text-ink md:text-4xl">
                  <a href={productHref(p.slug)} class="after:absolute after:inset-0">{p.data.title}</a>
                </h3>
                <p class="mt-4 leading-relaxed text-muted">{p.data.summary}</p>
                <span class="link-arrow mt-auto self-start pt-7">Discover {p.data.title} <span aria-hidden="true">→</span></span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Selected projects -->
  <section class="band-white" aria-labelledby="projects-heading">
    <div class="wrap py-20 md:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow text-display-accent">Selected projects</p>
          <h2 id="projects-heading" class="display h-section mt-4 max-w-2xl text-ink">Evidence in practice</h2>
        </div>
        <a href={localePath(lang, '/work/')} class="link-arrow">All {work.length} projects <span aria-hidden="true">→</span></a>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-3" role="list">
        {selected.map((w) => <li><WorkCard entry={w} lang={lang} /></li>)}
      </ul>
    </div>
  </section>

  <!-- Figures -->
  <section class="band-midnight relative overflow-hidden" aria-label="Ethos Lab in figures">
    <div class="wrap relative grid grid-cols-2 gap-x-6 gap-y-12 py-16 md:grid-cols-5 md:py-20">
      {
        figures.map((f) => (
          <div class="border-l-2 border-ember pl-5">
            <p class="display text-5xl text-ink md:text-6xl">{f.value}</p>
            <p class="mt-3 text-sm leading-snug text-muted">{f.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Domains -->
  <section id="domains" class="band-mist" aria-labelledby="domains-heading">
    <div class="wrap py-20 md:py-28">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow text-display-accent">Where we work</p>
          <h2 id="domains-heading" class="display h-section mt-4 text-ink">One method, applied across policy</h2>
        </div>
        <p class="text-lg leading-relaxed text-muted lg:col-span-5">Our domains span economics, behavioural science and advanced analytics, for governments, international organisations and businesses.</p>
      </div>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          domains.map((d) => (
            <li class="group duotone relative flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-card sm:aspect-[4/4.4]">
              <Image src={d.image} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
              <div class="relative z-10 p-6 text-white">
                <span class="mb-4 block h-0.5 w-8 bg-ember transition-all group-hover:w-14" aria-hidden="true" />
                <h3 class="text-xl leading-snug font-semibold">
                  <a href={`${localePath(lang, '/work/')}?sector=${d.sector}`} class="after:absolute after:inset-0">{d.name}</a>
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-white/80">{d.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Insights -->
  <section class="band-white" aria-labelledby="insights-heading">
    <div class="wrap py-20 md:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow text-display-accent">Insights</p>
          <h2 id="insights-heading" class="display h-section mt-4 text-ink">Research and events</h2>
        </div>
        <a href={localePath(lang, '/insights/')} class="link-arrow">All insights <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {
          papers.map((r) => (
            <article class="group relative flex flex-col rounded-card border border-line p-8 transition hover:border-ink md:p-10">
              <p class="eyebrow text-muted">{RESEARCH_TYPES[r.data.type]} · {formatDate(r.data.date, lang)}</p>
              <h3 class="display mt-4 text-2xl text-ink md:text-3xl">
                <a href={r.data.url ?? localePath(lang, '/insights/')} class="after:absolute after:inset-0" rel={r.data.url ? 'noopener' : undefined}>{r.data.title}</a>
              </h3>
              <p class="mt-3 text-sm text-muted">{r.data.authors.join(', ')}{r.data.venue && ` · ${r.data.venue}`}</p>
              <p class="mt-5 leading-relaxed text-ink/85">{r.data.summary}</p>
              <span class="link-arrow mt-auto self-start pt-7">Read the paper <span aria-hidden="true">→</span></span>
            </article>
          ))
        }
        {
          events.slice(0, 1).map((e) => (
            <article class="band-midnight group relative flex flex-col overflow-hidden rounded-card p-8 md:p-10">
              <Ribbons class="pointer-events-none absolute inset-x-0 bottom-0 h-14 w-full opacity-40" seed={21} layers={5} />
              <p class="eyebrow relative text-muted">Event · {e.dateLabel}</p>
              <h3 class="display relative mt-4 text-2xl text-ink md:text-3xl">
                <a href={localePath(lang, '/insights/#events')} class="after:absolute after:inset-0">{e.title}</a>
              </h3>
              <p class="relative mt-3 text-sm text-muted">{e.place}</p>
              <p class="relative mt-5 leading-relaxed text-ink/85">{e.summary}</p>
              <span class="link-arrow relative mt-auto mb-12 self-start pt-7">About the event <span aria-hidden="true">→</span></span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
