---
/**
 * Homepage. Each section sits on its own band (midnight, white, mist, deep blue,
 * orange) so the page reads as a sequence of distinct chapters.
 *
 * Copy: the headline and second line were agreed with George (October 2026); the three
 * services are in src/data/offer.ts. Products, projects, domains, figures and insights
 * come from the current ethoslab.gr, the RWI atlas and the Room Wisdom pitch deck. News:
 * src/content/posts/.
 */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Ribbons from '../Ribbons.astro';
import PartnerGrid from '../PartnerGrid.astro';
import CtaBand from '../CtaBand.astro';
import Placeholder from '../Placeholder.astro';
import { services } from '../../data/offer';
import { domains } from '../../data/ethos';
import { getLocalized, localePath } from '../../i18n/utils';
import { getNews, newsDate } from '../../lib/news';
import type { Locale } from '../../i18n/config';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const productEntries = (await getLocalized('products', lang)).sort((a, b) => a.data.order - b.data.order);
const allNews = await getNews(lang);
const bip = allNews.find((p) => p.url.includes('bip-greece'));
const news = allNews.filter((p) => p !== bip).slice(0, 4);

const productHref = (slug: string) => localePath(lang, `/products/${slug}/`);
---

<Base
  title="Ethos Lab | What works, for whom, and why"
  rawTitle
  description="Research, data and tools for the decisions that matter. Ethos Lab is an independent research firm in Athens working with governments, international organisations and businesses across Europe."
  lang={lang}
  path="/"
>
  <!-- Hero -->
  <section class="band-midnight relative flex flex-col overflow-hidden">
    <div class="grid-dots pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_30%_40%,black,transparent_75%)]" aria-hidden="true"></div>
    <div class="pointer-events-none relative order-last h-52 sm:h-72 lg:absolute lg:inset-y-0 lg:right-0 lg:h-auto lg:w-[56%] lg:[mask-image:linear-gradient(90deg,transparent,black_38%)]">
      <Ribbons class="absolute inset-0 h-full w-full lg:top-[14%] lg:h-[72%]" />
    </div>
    <div class="wrap relative pt-16 pb-10 md:pt-24 lg:pt-28 lg:pb-32">
      <p class="eyebrow flex items-center gap-3 text-display-accent"><span class="h-0.5 w-8 bg-ember" aria-hidden="true"></span>The question behind every decision</p>
      <h1 class="display h-hero mt-6 text-ink">
        <span class="block">What works,</span>
        <span class="block">for whom,</span>
        <span class="block text-display-accent">and why.</span>
      </h1>
      <p class="mt-8 max-w-xl text-xl leading-snug font-medium text-balance text-ink md:text-2xl lg:max-w-[34rem]">Research, data and tools for the decisions that matter.</p>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted lg:max-w-[34rem]">
        We help governments, international organisations and businesses understand problems, test options and measure what changed, to the standards of academic research.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href={localePath(lang, '/contact/')} class="btn btn-primary !px-6">Talk to us <span aria-hidden="true">→</span></a>
        <a href={localePath(lang, '/services/')} class="btn btn-ghost !px-6">Explore our services</a>
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="band-white border-b border-line" aria-labelledby="partners-heading">
    <div class="wrap py-12 md:py-14">
      <h2 id="partners-heading" class="eyebrow text-center text-muted">Partners and clients include</h2>
      <PartnerGrid variant="strip" class="mt-8" />
    </div>
  </section>

  <!-- What we do: the three services -->
  <section id="services" class="band-mist" aria-labelledby="services-heading">
    <div class="wrap py-20 md:py-28">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="eyebrow text-display-accent">What we do</p>
          <h2 id="services-heading" class="display h-section mt-4 text-ink">Clear answers at every stage of a decision</h2>
        </div>
        <p class="text-lg leading-relaxed text-muted lg:col-span-6">Weighing your options, judging a programme that is already running, or deciding how far to take something that works? Bring us in at any point, for a single question or for the whole journey.</p>
      </div>
      <ol class="mt-14 grid gap-4 lg:grid-cols-3">
        {
          services.map((sv, i) => (
            <li class="group relative flex flex-col rounded-card bg-paper p-8 ring-1 ring-transparent transition hover:ring-ink md:p-9">
              <p class="display text-5xl text-ember" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="display mt-6 text-3xl text-ink">
                <a href={localePath(lang, sv.path)} class="after:absolute after:inset-0">{sv.name}</a>
              </h3>
              <p class="mt-3 text-lg leading-snug text-ink">{sv.short}</p>
              <p class="mt-5 leading-relaxed text-muted">“{sv.question}”</p>
              <ul class="mt-6 space-y-2 border-t border-line pt-5">
                {sv.youReceive.map((r) => <li class="flex gap-3 text-sm text-ink"><span class="mt-[0.6em] h-0.5 w-3 shrink-0 bg-ember" aria-hidden="true" />{r}</li>)}
              </ul>
              <span class="link-arrow mt-auto self-start pt-7">Explore {sv.name} <span aria-hidden="true">→</span></span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Products -->
  <section class="band-deep relative overflow-hidden" aria-labelledby="products-heading">
    <div class="grid-dots pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="wrap relative py-20 md:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow text-display-accent">Our products</p>
          <h2 id="products-heading" class="display h-section mt-4 max-w-2xl text-ink">Tools built on data we can defend</h2>
        </div>
        <a href={localePath(lang, '/products/')} class="link-arrow">All products <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          productEntries.map((p) => (
            <article class="group relative flex flex-col overflow-hidden rounded-card bg-white/[0.06] ring-1 ring-white/10 transition hover:bg-white/[0.09]">
              <div class:list={['relative flex aspect-[16/9] items-center justify-center overflow-hidden', p.slug === 'room-wisdom' ? 'bg-[#f6f5f1]' : p.data.cover ? 'bg-white' : 'bg-midnight']}>
                {p.data.cover ? (
                  <Image src={p.data.cover} alt="" widths={[500, 1000]} sizes="(min-width: 1024px) 400px, 92vw" class:list={['h-full w-full', p.slug === 'room-wisdom' ? 'object-cover' : 'object-cover object-top']} />
                ) : (
                  <Ribbons class="absolute inset-0 h-full w-full opacity-70" seed={11} layers={5} />
                )}
              </div>
              <div class="flex flex-1 flex-col p-7 md:p-9">
                <p class="eyebrow flex items-center gap-3 text-display-accent">
                  {p.data.kicker}
                  {p.data.status && <span class="rounded-full border border-line px-2 py-0.5 text-[0.62rem] tracking-[0.1em] text-muted">{p.data.status === 'pilot' ? 'Pilot' : p.data.status === 'live' ? 'Live' : 'In development'}</span>}
                </p>
                <h3 class="display mt-3 text-3xl text-ink md:text-4xl">
                  <a href={productHref(p.slug)} class="after:absolute after:inset-0">{p.data.title}</a>
                </h3>
                <p class="mt-4 leading-relaxed text-muted">{p.data.summary}</p>
                {p.data.placeholder && <Placeholder note="Product description to confirm" onAccent class="relative z-10 mt-4" />}
                <span class="link-arrow mt-auto self-start pt-7">Discover {p.data.title} <span aria-hidden="true">→</span></span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Domains -->
  <section id="domains" class="band-mist" aria-labelledby="domains-heading">
    <div class="wrap py-20 md:py-28">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow text-display-accent">Where we work</p>
          <h2 id="domains-heading" class="display h-section mt-4 text-ink">One method, applied across policy</h2>
        </div>
        <p class="text-lg leading-relaxed text-muted lg:col-span-5">Our domains span economics, behavioural science and advanced analytics, for governments, international organisations and businesses.</p>
      </div>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          domains.map((d) => (
            <li class="group duotone relative flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-card sm:aspect-[4/4.4]">
              <Image src={d.image} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
              <div class="relative z-10 p-6 text-white">
                <span class="mb-4 block h-0.5 w-8 bg-ember transition-all group-hover:w-14" aria-hidden="true" />
                <h3 class="text-xl leading-snug font-semibold">
                  <a href={`${localePath(lang, '/work/')}?sector=${d.sector}`} class="after:absolute after:inset-0">{d.name}</a>
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-white/80">{d.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Highlights: the BiP Greece network and recent news -->
  <section class="band-white" aria-labelledby="highlights-heading">
    <div class="wrap py-20 md:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow text-display-accent">Highlights</p>
          <h2 id="highlights-heading" class="display h-section mt-4 text-ink">What is happening at Ethos Lab</h2>
        </div>
        <a href={localePath(lang, '/insights/news/')} class="link-arrow">All news <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-12">
        <article class="band-midnight group relative flex flex-col overflow-hidden rounded-card p-8 md:p-10 lg:col-span-7">
          <Ribbons class="pointer-events-none absolute inset-x-0 bottom-0 h-16 w-full opacity-40" seed={21} layers={5} />
          <p class="eyebrow relative text-display-accent">Network</p>
          <h3 class="display relative mt-4 text-3xl text-ink md:text-4xl">
            <a href={localePath(lang, `/insights/news/${bip?.url ?? ''}/`)} class="after:absolute after:inset-0">Behavioural Insights for Policy Greece Network</a>
          </h3>
          <p class="relative mt-5 max-w-xl leading-relaxed text-muted">With the ETERON Institute, we bring Behavioural Insights for Policy to Greece: a network that takes behavioural public policy beyond the countries where it is already established, connecting researchers, public servants and practitioners.</p>
          <p class="relative mt-4 max-w-xl leading-relaxed text-muted">Its first Greek workshop, in Athens on 26 and 27 February 2026, featured keynotes from Professor Ralph Hertwig (Max Planck Institute for Human Development) and Eva Koromilas (OECD Observatory of Public Sector Innovation).</p>
          <span class="link-arrow relative mt-auto mb-10 self-start pt-8">About the workshop <span aria-hidden="true">→</span></span>
        </article>
        <div class="lg:col-span-5">
          <p class="eyebrow text-muted">Recent news</p>
          <ul class="mt-4 divide-y divide-line border-y border-line" role="list">
            {
              news.map((p) => (
                <li class="group relative py-6">
                  <p class="text-sm text-muted"><time datetime={p.data.date}>{newsDate(p.when, lang)}</time></p>
                  <h3 class="mt-1.5 text-lg leading-snug font-semibold text-ink">
                    <a href={localePath(lang, `/insights/news/${p.url}/`)} class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-ember group-hover:decoration-2 group-hover:underline-offset-4">{p.data.title}</a>
                  </h3>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
