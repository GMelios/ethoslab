---
/** Insights > News: news and blog posts from src/content/posts/. */
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import CtaBand from '../../../../components/CtaBand.astro';
import { localeParams, localePath } from '../../../../i18n/utils';
import { useTranslations } from '../../../../i18n/ui';
import type { Locale } from '../../../../i18n/config';
import { getNews, newsDate } from '../../../../lib/news';

export const getStaticPaths = localeParams;
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
const posts = await getNews(lang);
---

<Base title={t('nav.news')} description="News, events and blog posts from Ethos Lab." lang={lang} path="/insights/news/">
  <PageHero eyebrow={t('nav.insights')} title="News" intro="Events, project milestones, new papers and notes from our work." crumbs={[{ label: t('nav.insights'), href: localePath(lang, '/insights/') }]} />

  <section class="band-white">
    <div class="wrap py-16 md:py-20">
      <ul class="divide-y divide-line border-y border-line" role="list">
        {
          posts.map((p) => (
            <li class="group relative grid gap-4 py-8 md:grid-cols-12 md:gap-10">
              <p class="eyebrow text-muted md:col-span-3 md:pt-1.5">
                <time datetime={p.data.date}>{newsDate(p.when, lang)}</time>
                <span class="ml-2 rounded-full border border-line px-2 py-0.5 text-[0.62rem]">{p.data.kind === 'blog' ? 'Blog' : 'News'}</span>
              </p>
              <div class="md:col-span-9">
                <h2 class="display text-2xl text-ink md:text-3xl">
                  <a href={localePath(lang, `/insights/news/${p.url}/`)} class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-ember group-hover:decoration-2 group-hover:underline-offset-4">{p.data.title}</a>
                </h2>
                {p.data.summary && <p class="mt-3 max-w-3xl leading-relaxed text-muted">{p.data.summary}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
