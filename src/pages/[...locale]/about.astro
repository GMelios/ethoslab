---
/**
 * About us > Who we are. The story is condensed from "Our History" and the principles
 * from "How we work" on ethoslab.gr. The team has its own page (about/team.astro).
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import PartnerGrid from '../../components/PartnerGrid.astro';
import { localeParams, localePath } from '../../i18n/utils';
import { useTranslations } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import { principles } from '../../data/ethos';
import { site } from '../../data/site';

export const getStaticPaths = localeParams;
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

const story = [
  {
    year: String(site.founded),
    title: 'Founded to bridge academic rigour and real-world policy',
    body: 'Ethos Lab was established in Athens by Dr Georgios Melios and Nikolaos Melios to bring behavioural economics and econometric methods to European policy challenges. Cutting-edge research was not reaching the governments and businesses that needed it most, across Europe and the MENA region.',
  },
  {
    year: 'Early work',
    title: 'Welfare and evidence first',
    body: 'How do we measure social welfare beyond GDP? Which interventions actually reduce inequality? Our early projects combined econometric analysis with behavioural diagnosis, with businesses, government bodies and universities. We did not assume our approaches would succeed. We measured.',
  },
  {
    year: 'Tools',
    title: 'Building our own tools',
    body: 'We co-developed the Reframing Welfare Index with KMOP Policy Centre to measure welfare beyond GDP across Europe’s regions, and built Room Wisdom to turn group conversations into verified evidence.',
  },
  {
    year: 'Today',
    title: 'More than consulting: building capacity',
    body: 'A full-service research and innovation firm of econometricians, behavioural scientists, policy analysts and project managers. Alongside projects, we train policy teams in experimental methods so they keep using evidence long after an engagement ends.',
  },
];
---

<Base title={t('nav.whoWeAre')} description="Ethos Lab is a research and innovation firm in Athens, founded in 2019, working on behavioural science and causal evaluation across Europe." lang={lang} path="/about/">
  <PageHero
    eyebrow={t('nav.whoWeAre')}
    title="A specialised team, not a large consultancy"
    intro="We combine research excellence with implementation experience, so we can hold to academic standards while delivering practical answers to real-world challenges. Based in Athens, working across Europe and the MENA region."
  />

  <section class="band-white" aria-labelledby="belief-heading">
    <div class="wrap grid gap-10 py-20 md:py-24 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow text-display-accent">What drives us</p>
        <h2 id="belief-heading" class="display h-section mt-4 text-ink">Guesswork and good intentions are not enough</h2>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-ink/85 lg:col-span-7">
        <p>Evidence-based policy is not optional. With constrained budgets and complex social challenges, governments and businesses need to know what actually works, for whom, and why.</p>
        <p>Our founding principle is that good policy requires both an understanding of human behaviour and quantitative proof of what works. We are working towards a Europe where evidence is not an afterthought but the foundation.</p>
      </div>
    </div>
  </section>

  <section class="band-mist" aria-labelledby="story-heading">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow text-display-accent">Our story</p>
      <h2 id="story-heading" class="display h-section mt-4 text-ink">From research boutique to research and innovation firm</h2>
      <ol class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          story.map((s) => (
            <li class="relative rounded-card bg-paper p-7 pt-9">
              <span class="absolute top-0 left-7 h-1 w-10 bg-ember" aria-hidden="true" />
              <p class="display text-3xl text-display-accent">{s.year}</p>
              <h3 class="mt-3 text-lg leading-snug font-semibold text-ink">{s.title}</h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band-white" aria-labelledby="team-link-heading">
    <div class="wrap py-16 md:py-20">
      <a href={localePath(lang, '/about/team/')} class="group flex flex-col gap-6 rounded-card bg-mist p-8 ring-1 ring-transparent transition hover:ring-ink md:flex-row md:items-center md:justify-between md:p-12">
        <div>
          <p class="eyebrow text-display-accent">{t('nav.team')}</p>
          <h2 id="team-link-heading" class="display h-section mt-3 text-ink">Economists, behavioural scientists and data specialists</h2>
          <p class="mt-3 max-w-2xl text-lg text-muted">Meet the people who design and run our studies, from the first question to the final report.</p>
        </div>
        <span class="link-arrow shrink-0">Meet the team <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="band-midnight relative overflow-hidden" aria-labelledby="principles-heading">
    <div class="grid-dots pointer-events-none absolute inset-0 [mask-image:linear-gradient(90deg,transparent,black_70%)]" aria-hidden="true"></div>
    <div class="wrap relative py-20 md:py-24">
      <p class="eyebrow text-display-accent">How we work</p>
      <h2 id="principles-heading" class="display h-section mt-4 max-w-3xl text-ink">How we hold ourselves to account</h2>
      <dl class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          principles.map((p) => (
            <div class="border-t border-line pt-6">
              <dt class="text-lg font-semibold text-ink">{p.title}</dt>
              <dd class="mt-2 leading-relaxed text-muted">{p.body}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-12"><a href={localePath(lang, '/services/')} class="link-arrow">Our services <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="band-white" aria-labelledby="partners-heading">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow text-display-accent">Track record and partnerships</p>
      <h2 id="partners-heading" class="display h-section mt-4 text-ink">Who we have worked with</h2>
      <p class="mt-4 max-w-2xl text-lg text-muted">Public authorities, international and civil society organisations, academic institutions and private-sector partners: the whole quadruple helix.</p>
      <PartnerGrid class="mt-12" />
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
