---
/**
 * About us > Our team. Profiles come from the WordPress importer (portfolio items tagged
 * Team, Executive Team or Consultants). Group order follows seniority.
 */
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { getLocalized, localeParams, localePath } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/ui';
import type { Locale } from '../../../i18n/config';

export const getStaticPaths = localeParams;
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

// Team profiles come from the WordPress importer (portfolio items tagged Team,
// Executive Team or Consultants). Group order follows seniority.
const people = await getLocalized('people', lang);
const groups = ['Executive Team', 'Team', 'Consultants']
  .map((g) => ({
    name: g === 'Team' ? 'Researchers and analysts' : g === 'Executive Team' ? 'Leadership' : g,
    members: people
      .filter((p) => p.data.wpCategories?.includes(g))
      .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)),
  }))
  .filter((g) => g.members.length);
---

<Base title={t('nav.team')} description="The people behind Ethos Lab: economists, behavioural scientists, data analysts and consultants." lang={lang} path="/about/team/">
  <PageHero
    eyebrow={t('nav.team')}
    title="The people behind the evidence"
    intro="Economists, behavioural scientists, data analysts and consultants, working with universities and partners across Europe."
    crumbs={[{ label: t('nav.about'), href: localePath(lang, '/about/') }]}
  />

  <section class="band-white" aria-labelledby="team-heading">
    <div class="wrap py-20 md:py-24">
      <h2 id="team-heading" class="sr-only">The team</h2>
      {
        groups.map((g) => (
          <div class="mt-14">
            <h3 class="eyebrow border-b border-line pb-3 text-muted">{g.name}</h3>
            <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-5" role="list">
              {g.members.map((p) => (
                <li id={p.slug}>
                  <div class="aspect-[4/5] overflow-hidden rounded-card bg-mist">
                    {p.data.cover ? (
                      <Image src={p.data.cover} alt="" widths={[240, 480]} sizes="(min-width: 1024px) 220px, 45vw" class="h-full w-full object-cover grayscale transition duration-500 hover:grayscale-0" />
                    ) : null}
                  </div>
                  <p class="mt-4 font-semibold text-ink">{p.data.title}</p>
                  {p.data.role && <p class="mt-1 text-sm leading-snug text-muted">{p.data.role}</p>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>


  <CtaBand lang={lang} title="Want to work with us?" body="Tell us about your project, or write to us if you would like to join the team." button="Get in touch" />
</Base>
