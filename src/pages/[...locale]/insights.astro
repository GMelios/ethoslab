---
/**
 * Insights: research told as stories (src/data/stories/), then the latest news
 * (src/content/posts/). Projects have their own section at /work/.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { localeParams, localePath } from '../../i18n/utils';
import { useTranslations } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import { getStories } from '../../data/stories';
import { getNews, newsDate } from '../../lib/news';

export const getStaticPaths = localeParams;
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
const stories = await getStories(lang);
const news = (await getNews(lang)).slice(0, 4);
---

<Base title={t('nav.insights')} description="Our research, explained: what we asked, how we tested it and what we found. Plus news from Ethos Lab." lang={lang} path="/insights/">
  <PageHero
    eyebrow={t('nav.insights')}
    title="Research, explained"
    intro="What we asked, how we tested it, what we found, and what it means. Each study told in five short chapters, with the full paper a click away."
  >
    <nav aria-label="On this page" class="mt-10">
      <ul class="flex flex-wrap gap-3">
        <li><a href="#research" class="inline-flex items-center gap-2 rounded-control border border-line px-4 py-2 text-sm font-semibold text-ink hover:border-ink">Research <span class="text-muted tabular-nums">{stories.length}</span></a></li>
        <li><a href={localePath(lang, '/insights/news/')} class="inline-flex items-center gap-2 rounded-control border border-line px-4 py-2 text-sm font-semibold text-ink hover:border-ink">{t('nav.news')}</a></li>
      </ul>
    </nav>
  </PageHero>

  <section id="research" class="band-white scroll-mt-4" aria-labelledby="research-heading">
    <div class="wrap py-20 md:py-24">
      <h2 id="research-heading" class="sr-only">Research</h2>
      <ul class="grid gap-6 lg:grid-cols-2" role="list">
        {
          stories.map((s, i) => (
            <li class:list={['group relative flex flex-col overflow-hidden rounded-card p-8 md:p-10', i === 0 ? 'band-midnight' : 'bg-mist']}>
              <p class="eyebrow text-display-accent">{s.kind}</p>
              <h3 class="display mt-4 text-3xl text-ink md:text-4xl">
                <a href={localePath(lang, `/insights/${s.slug}/`)} class="after:absolute after:inset-0">{s.title}</a>
              </h3>
              <p class="mt-5 leading-relaxed text-muted">{s.summary}</p>
              <p class="mt-5 text-sm text-muted">
                <span class="text-ink">{s.paperTitle}</span> · {s.authors.join(', ')} · {s.dateLabel}
              </p>
              {s.status && <p class="mt-4"><span class="sample-badge">{s.status.badge}</span></p>}
              <div class="relative z-10 mt-auto flex flex-wrap items-center gap-5 pt-8">
                <span class="link-arrow">Read the story <span aria-hidden="true">→</span></span>
                {'href' in s.pdf && <a href={s.pdf.href} class="text-sm font-semibold text-ink underline underline-offset-4 hover:text-display-accent" target="_blank" rel="noopener">PDF</a>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band-mist" aria-labelledby="news-heading">
    <div class="wrap py-20 md:py-24">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow text-display-accent">{t('nav.news')}</p>
          <h2 id="news-heading" class="display h-section mt-4 text-ink">Recent news</h2>
        </div>
        <a href={localePath(lang, '/insights/news/')} class="link-arrow">All news <span aria-hidden="true">→</span></a>
      </div>
      <ul class="mt-10 grid gap-4 md:grid-cols-2" role="list">
        {
          news.map((p) => (
            <li class="group relative rounded-card bg-paper p-7 ring-1 ring-transparent transition hover:ring-ink">
              <p class="eyebrow text-muted"><time datetime={p.data.date}>{newsDate(p.when, lang)}</time></p>
              <h3 class="mt-3 text-xl leading-snug font-semibold text-ink">
                <a href={localePath(lang, `/insights/news/${p.url}/`)} class="after:absolute after:inset-0">{p.data.title}</a>
              </h3>
              {p.data.summary && <p class="mt-2 line-clamp-3 leading-relaxed text-muted">{p.data.summary}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
