---
/**
 * Services, told as the ETHOS method (Explore, Test, Hone, Optimise, Scale), sold as two
 * engagements (Ethos Test, Ethos Evaluation) and applied across eight domains.
 * Content: src/data/ethos.ts and src/data/offer.ts.
 */
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { localeParams, localePath } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/ui';
import type { Locale } from '../../../i18n/config';
import { stages, domains, principles, methodIntro } from '../../../data/ethos';
import { products as engagements } from '../../../data/offer';

export const getStaticPaths = localeParams;
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
const engagementOf = (id: 'test' | 'evaluation') => engagements.find((e) => e.id === id)!;
---

<Base
  title={t('nav.services')}
  description="The ETHOS method: Explore, Test, Hone, Optimise, Scale. Behavioural science and causal evaluation for governments, organisations and research consortia."
  lang={lang}
  path="/services/"
>
  <PageHero
    eyebrow={t('nav.services')}
    title="Evidence for every stage of a decision"
    intro="We combine research in economics and behavioural science with rigorous quantitative methods to help governments and businesses design better policies and measure real impact."
  >
    <nav aria-label="ETHOS stages" class="mt-12">
      <ol class="grid grid-cols-5 gap-2 sm:max-w-xl">
        {
          stages.map((s) => (
            <li>
              <a href={`#${s.id}`} class="group block rounded-card bg-white/[0.06] p-3 text-center ring-1 ring-white/10 transition hover:bg-ember hover:ring-ember sm:p-4">
                <span class="display block text-4xl text-display-accent transition group-hover:text-midnight sm:text-5xl">{s.letter}</span>
                <span class="mt-1 block text-[0.7rem] font-semibold text-muted transition group-hover:text-midnight sm:text-xs">{s.name}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </PageHero>

  <section id="method" class="band-white" aria-labelledby="method-heading">
    <div class="wrap grid gap-8 py-16 md:py-20 lg:grid-cols-12">
      <h2 id="method-heading" class="display text-3xl text-ink md:text-[2.6rem] lg:col-span-5">The ETHOS method</h2>
      <div class="lg:col-span-7">
        <p class="text-lg leading-relaxed text-ink/85 md:text-xl">{methodIntro}</p>
        <p class="mt-5 leading-relaxed text-muted">
          You can bring us in at any stage. Most clients start with one of two engagements: <a class="font-semibold text-accent underline underline-offset-4" href={localePath(lang, engagementOf('test').path)}>Ethos Test</a> covers the stages before launch, and <a class="font-semibold text-accent underline underline-offset-4" href={localePath(lang, engagementOf('evaluation').path)}>Ethos Evaluation</a> the stages after.
        </p>
      </div>
    </div>
  </section>

  {
    stages.map((s, i) => {
      const e = engagementOf(s.engagement);
      return (
        <section id={s.id} class:list={[i % 2 === 0 ? 'band-mist' : 'band-white', 'scroll-mt-4']} aria-labelledby={`${s.id}-heading`}>
          <div class="wrap grid gap-10 py-16 md:py-24 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <p class="display text-[7rem] leading-[0.8] text-ember md:text-[9rem]" aria-hidden="true">{s.letter}</p>
              <h2 id={`${s.id}-heading`} class="display mt-6 text-4xl text-ink">{s.name}</h2>
              <p class="mt-3 text-lg leading-snug text-muted">{s.line}</p>
              <a href={localePath(lang, e.path)} class="mt-6 inline-flex items-center gap-2 rounded-control border border-line bg-paper px-3 py-1.5 text-sm font-semibold text-ink hover:border-ink">
                Part of {e.name} <span aria-hidden="true">→</span>
              </a>
            </div>
            <div class="lg:col-span-8">
              <p class="display text-2xl text-ink md:text-3xl">“{s.question}”</p>
              <h3 class="eyebrow mt-10 text-display-accent">What we do</h3>
              <ul class="mt-4 space-y-3">
                {s.weDo.map((w) => (
                  <li class="flex gap-4 leading-relaxed text-ink/85">
                    <span class="mt-[0.7em] h-0.5 w-4 shrink-0 bg-ember" aria-hidden="true" />
                    {w}
                  </li>
                ))}
              </ul>
              <div class="mt-10 grid gap-8 md:grid-cols-2">
                <div>
                  <h3 class="eyebrow text-display-accent">Methods we draw on</h3>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {s.methods.map((m) => <li class="rounded-control bg-paper px-3 py-1.5 text-sm text-ink ring-1 ring-line">{m}</li>)}
                  </ul>
                </div>
                <div>
                  <h3 class="eyebrow text-display-accent">You receive</h3>
                  <ul class="mt-4 space-y-2">
                    {s.youReceive.map((r) => (
                      <li class="flex gap-3 text-ink">
                        <svg viewBox="0 0 20 20" class="mt-1 h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        {r}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="band-deep relative overflow-hidden" aria-labelledby="engagements-heading">
    <div class="grid-dots pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="wrap relative py-20 md:py-24">
      <p class="eyebrow text-display-accent">Two ways to start</p>
      <h2 id="engagements-heading" class="display mt-4 max-w-2xl text-4xl text-ink md:text-[3.2rem]">Know before. Prove after.</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          engagements.map((e) => (
            <article class="group relative flex flex-col rounded-card bg-white/[0.06] p-8 ring-1 ring-white/10 transition hover:bg-white/[0.1] md:p-10">
              <p class="eyebrow text-muted">{e.stages}</p>
              <h3 class="display mt-3 text-4xl text-ink">{e.name}</h3>
              <p class="display mt-1 text-2xl text-display-accent">{e.tagline}</p>
              <p class="mt-6 leading-relaxed text-muted">{e.for}</p>
              <p class="mt-4 font-medium text-ink">“{e.questions}”</p>
              <a href={localePath(lang, e.path)} class="link-arrow mt-auto self-start pt-8 after:absolute after:inset-0">Explore {e.name} <span aria-hidden="true">→</span></a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="domains" class="band-white scroll-mt-4" aria-labelledby="domains-heading">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow text-display-accent">Where we work</p>
      <h2 id="domains-heading" class="display mt-4 max-w-3xl text-4xl text-ink md:text-[3.2rem]">Eight domains, one standard of evidence</h2>
      <ul class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          domains.map((d) => (
            <li class="group relative">
              <div class="duotone aspect-[3/2] overflow-hidden rounded-card">
                <Image src={d.image} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
              </div>
              <h3 class="mt-5 text-lg font-semibold text-ink">
                <a href={`${localePath(lang, '/work/')}?sector=${d.sector}`} class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-ember group-hover:decoration-2 group-hover:underline-offset-4">{d.name}</a>
              </h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{d.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band-mist" aria-labelledby="principles-heading">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow text-display-accent">How we hold ourselves to account</p>
      <h2 id="principles-heading" class="display mt-4 max-w-3xl text-4xl text-ink md:text-[3.2rem]">Academic standards, applied to real deadlines</h2>
      <dl class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          principles.map((p, i) => (
            <div class="rounded-card bg-paper p-7">
              <p class="display text-2xl text-ember">{String(i + 1).padStart(2, '0')}</p>
              <dt class="mt-3 text-lg font-semibold text-ink">{p.title}</dt>
              <dd class="mt-2 leading-relaxed text-muted">{p.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
