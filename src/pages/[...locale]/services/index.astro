---
/**
 * Services, told the "Follow one question" way: one real study (the MultiPoD language
 * experiment) in five chapters, then the turn to our three services (Research & Design,
 * Evaluation & Impact, Scale up), the domains we work in, our principles, and an
 * invitation to bring a question.
 *
 * Story copy and every number: src/data/question.ts (asserts the claims against the
 * case-study data at build time). Services: src/data/offer.ts. Domains and principles:
 * src/data/ethos.ts.
 */
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import EffectSizeChart from '../../../components/EffectSizeChart.astro';
import { localeParams, localePath } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/ui';
import type { Locale } from '../../../i18n/config';
import { domains, principles } from '../../../data/ethos';
import { services } from '../../../data/offer';
import { getQuestionStory } from '../../../data/question';

export const getStaticPaths = localeParams;
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
const story = await getQuestionStory(lang);
const { hero, question, design, field, findings, decision, turn, invite } = story;
const provisionalNote = hero.note;
---

<Base
  title={t('nav.services')}
  description="How Ethos Lab works, told through one real study, and our three services: Research & Design, Evaluation & Impact, and Scale up."
  lang={lang}
  path="/services/"
>
  <!-- Hero -->
  <section class="band-midnight relative overflow-hidden">
    <div class="grid-dots pointer-events-none absolute inset-0 [mask-image:linear-gradient(90deg,transparent,black_60%)]" aria-hidden="true"></div>
    <div class="wrap relative grid gap-12 py-16 md:py-24 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="eyebrow flex items-center gap-3 text-display-accent"><span class="h-0.5 w-8 bg-ember" aria-hidden="true"></span>{hero.eyebrow}</p>
        <h1 class="display h-hero mt-5 text-ink">{hero.title}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">{hero.lede}</p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href={hero.primary.href} class="btn btn-primary">{hero.primary.label} <span aria-hidden="true">↓</span></a>
          <a href={hero.skip.href} class="btn btn-ghost">{hero.skip.label}</a>
        </div>
        <p class="mt-8 flex max-w-2xl items-start gap-3 text-sm leading-relaxed text-muted">
          <span class="sample-badge mt-0.5 shrink-0">{story.ui.provisional}</span>{provisionalNote}
        </p>
      </div>
      <nav aria-label={hero.contentsLabel} class="lg:col-span-4 lg:pt-12">
        <p class="eyebrow text-muted">{hero.contentsLabel}</p>
        <ol class="mt-5 space-y-2">
          {
            story.chapters.map((c) => (
              <li>
                <a href={`#${c.id}`} class="group flex items-center gap-4 rounded-card p-2 pr-4 transition hover:bg-white/[0.06]">
                  <span class="display flex h-10 w-10 shrink-0 items-center justify-center rounded-control bg-ember text-xl text-midnight">{c.n}</span>
                  <span>
                    <span class="block text-xs text-muted">{c.kicker}</span>
                    <span class="block font-semibold text-ink group-hover:underline">{c.short}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
        <dl class="mt-8 grid grid-cols-2 gap-6 border-t border-line pt-6">
          {hero.stats.map((s) => <div><dt class="sr-only">{s.label}</dt><dd><span class="display block text-4xl text-ink">{s.value}</span><span class="mt-1 block text-sm text-muted">{s.label}</span></dd></div>)}
        </dl>
      </nav>
    </div>
  </section>

  <!-- Chapter 1: the question -->
  <section id={question.id} class="band-white scroll-mt-4" aria-labelledby={`${question.id}-h`}>
    <div class="wrap grid gap-12 py-20 md:py-24 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow flex items-center gap-3 text-display-accent">{question.kicker}</p>
        <h2 id={`${question.id}-h`} class="display h-section mt-4 text-ink">{question.title}</h2>
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-ink/85">{question.body.map((p) => <p>{p}</p>)}</div>
        <blockquote class="display mt-10 border-l-4 border-ember pl-6 text-2xl text-ink md:text-3xl">{question.pull}</blockquote>
      </div>
      <aside class="lg:col-span-5">
        <div class="rounded-card bg-mist p-7">
          <p class="eyebrow text-ink">{question.worriesTitle}</p>
          <ol class="mt-5 space-y-4">
            {question.worries.map((w, i) => <li class="flex gap-4"><span class="display text-2xl text-ember">{i + 1}</span><span class="pt-1 leading-snug font-medium text-ink">{w}</span></li>)}
          </ol>
        </div>
        <dl class="mt-6 grid gap-4 sm:grid-cols-2">
          {question.facts.map((f) => <div class="border-t-2 border-ink pt-3"><dt class="sr-only">{f.label}</dt><dd><span class="block font-semibold text-ink">{f.value}</span><span class="mt-1 block text-sm text-muted">{f.label}</span></dd></div>)}
        </dl>
      </aside>
      <p class="text-lg leading-relaxed text-muted italic lg:col-span-12">{question.bridge}</p>
    </div>
  </section>

  <!-- Chapter 2: a fair test -->
  <section id={design.id} class="band-mist scroll-mt-4" aria-labelledby={`${design.id}-h`}>
    <div class="wrap py-20 md:py-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="eyebrow flex items-center gap-3 text-display-accent">{design.kicker}</p>
          <h2 id={`${design.id}-h`} class="display h-section mt-4 text-ink">{design.title}</h2>
          <div class="mt-6 space-y-4 text-lg leading-relaxed text-ink/85">{design.body.map((p) => <p>{p}</p>)}</div>
        </div>
        <figure class="lg:col-span-5" aria-label={design.flow.summary}>
          <div class="rounded-card bg-paper p-7">
            <p class="display text-5xl text-ink">{design.flow.surveyed.value}</p>
            <p class="mt-1 text-sm text-muted">{design.flow.surveyed.label}</p>
            <div class="my-4 ml-6 h-8 w-0.5 bg-line" aria-hidden="true"></div>
            <p class="display text-5xl text-ink">{design.flow.analysed.value}</p>
            <p class="mt-1 text-sm text-muted">{design.flow.analysed.label}</p>
            <p class="mt-5 inline-block rounded-full bg-ember px-3 py-1 text-xs font-bold tracking-wide text-midnight uppercase">{design.flow.draw}</p>
          </div>
        </figure>
      </div>
      <ul class="mt-12 grid gap-4 md:grid-cols-3" role="list">
        {
          design.arms.map((a, i) => (
            <li class:list={['rounded-card p-7', i === 0 ? 'bg-paper border-t-4 border-line' : 'bg-paper border-t-4 border-ember']}>
              <p class="eyebrow text-muted">{a.role}</p>
              <h3 class="mt-3 text-xl font-semibold text-ink">{a.name}</h3>
              <p class="mt-2 leading-relaxed text-muted">{a.detail}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="rounded-card bg-paper p-7">
          <p class="eyebrow text-ink">{design.measuresTitle}</p>
          <ul class="mt-4 space-y-3">
            {design.measures.map((m) => <li class="flex flex-wrap items-center gap-3 text-ink"><span class="mt-0.5 h-0.5 w-4 shrink-0 bg-ember" aria-hidden="true" />{m.label}{m.tag && <span class="rounded-full bg-mist px-2 py-0.5 text-xs font-semibold text-ink">{m.tag}</span>}</li>)}
          </ul>
        </div>
        <div class="rounded-card bg-midnight p-7 text-white">
          <p class="eyebrow text-[#f1592a]">{design.openBook.title}</p>
          <p class="mt-3 leading-relaxed text-white/80">{design.openBook.body}</p>
        </div>
      </div>
      <p class="mt-10 text-lg leading-relaxed text-muted italic">{design.bridge}</p>
    </div>
  </section>

  <!-- Chapter 3: into the field -->
  <section id={field.id} class="band-white scroll-mt-4" aria-labelledby={`${field.id}-h`}>
    <div class="wrap grid gap-12 py-20 md:py-24 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="eyebrow flex items-center gap-3 text-display-accent">{field.kicker}</p>
        <h2 id={`${field.id}-h`} class="display h-section mt-4 text-ink">{field.title}</h2>
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-ink/85">{field.body.map((p) => <p>{p}</p>)}</div>
      </div>
      <div class="lg:col-span-6">
        <p class="eyebrow text-ink">{field.steps.title}</p>
        <ol class="mt-5 divide-y divide-line border-y border-line">
          {field.steps.rows.map((r, i) => <li class="grid grid-cols-[2.5rem_6rem_1fr] items-baseline gap-3 py-4"><span class="display text-xl text-ember">{i + 1}</span><span class="font-semibold text-ink">{r.label}</span><span class="text-muted">{r.detail}</span></li>)}
        </ol>
        <dl class="mt-8 grid grid-cols-3 gap-4">
          {field.facts.map((f) => <div><dt class="sr-only">{f.label}</dt><dd><span class="display block text-4xl text-ink">{f.value}</span><span class="mt-1 block text-sm leading-snug text-muted">{f.label}</span></dd></div>)}
        </dl>
      </div>
      <p class="text-lg leading-relaxed text-muted italic lg:col-span-12">{field.bridge}</p>
    </div>
  </section>

  <!-- Chapter 4: what we found -->
  <section id={findings.id} class="band-mist scroll-mt-4" aria-labelledby={`${findings.id}-h`}>
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow flex flex-wrap items-center gap-3 text-display-accent">{findings.kicker} <span class="sample-badge">{story.ui.provisional}</span></p>
      <h2 id={`${findings.id}-h`} class="display h-section mt-4 text-ink">{findings.title}</h2>
      <p class="mt-4 text-lg text-muted">{findings.body[0]}</p>

      <ol class="mt-12 space-y-4">
        {
          findings.answers.map((a) => (
            <li class="grid gap-6 rounded-card bg-paper p-7 md:grid-cols-12 md:p-8">
              <div class="md:col-span-4">
                <p class="eyebrow text-muted">{findings.answerLabels.worry}</p>
                <p class="mt-2 text-lg leading-snug font-medium text-ink">{a.worry}</p>
              </div>
              <div class="md:col-span-5">
                <p class="eyebrow text-muted">{findings.answerLabels.answer}</p>
                <p class="display mt-2 text-2xl text-display-accent">{a.verdict}</p>
                <p class="mt-3 text-[0.95rem] leading-relaxed text-ink/85">{a.body}</p>
              </div>
              <div class="border-l-2 border-ember pl-5 md:col-span-3">
                <p class="display text-5xl text-ink">{a.stat.value}</p>
                <p class="mt-2 text-sm leading-snug text-muted">{a.stat.label}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mt-12 rounded-card bg-paper p-6 md:p-8">
        <p class="eyebrow text-ink">{findings.chartTitle}</p>
        <EffectSizeChart results={story.case.results} lang={lang} class="mt-4" />
      </div>
      <p class="eyebrow mt-10 text-ink">{findings.secondaryTitle}</p>
      <div class="mt-4 grid gap-6 lg:grid-cols-2">
        {story.case.secondary.map((r) => <div class="rounded-card bg-paper p-6"><EffectSizeChart results={r} lang={lang} compact /></div>)}
      </div>
      <p class="mt-8 max-w-3xl leading-relaxed text-muted">{findings.countries}</p>
      <p class="mt-10 text-lg leading-relaxed text-muted italic">{findings.bridge}</p>
    </div>
  </section>

  <!-- Chapter 5: what it means -->
  <section id={decision.id} class="band-white scroll-mt-4" aria-labelledby={`${decision.id}-h`}>
    <div class="wrap grid gap-12 py-20 md:py-24 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow flex items-center gap-3 text-display-accent">{decision.kicker}</p>
        <h2 id={`${decision.id}-h`} class="display h-section mt-4 text-ink">{decision.title}</h2>
        <p class="mt-6 text-lg leading-relaxed text-ink/85">{decision.body[0]}</p>
        <ol class="mt-6 space-y-3">
          {decision.recommendations.map((r, i) => <li class="flex gap-4 rounded-card bg-mist p-4"><span class="display text-2xl text-ember">{i + 1}</span><span class="pt-1 font-medium text-ink">{r}</span></li>)}
        </ol>
        <p class="mt-6 leading-relaxed text-muted">{decision.after}</p>
        <p class="mt-8 flex flex-wrap gap-6">
          <a href={story.case.href} class="link-arrow">{story.case.linkLabel} <span aria-hidden="true">→</span></a>
          {story.case.projectHref && <a href={story.case.projectHref} class="link-arrow">About MultiPoD <span aria-hidden="true">→</span></a>}
        </p>
      </div>
      <aside class="lg:col-span-5">
        <div class="rounded-card bg-midnight p-7 text-white">
          <p class="eyebrow text-[#f1592a]">{decision.limits.title}</p>
          <p class="mt-3 leading-relaxed text-white/80">{decision.limits.body}</p>
        </div>
        <p class="mt-5 text-sm text-muted">{decision.funding}</p>
      </aside>
    </div>
  </section>

  <!-- The turn: from one question to every question -->
  <section id="services" class="band-midnight relative scroll-mt-4 overflow-hidden" aria-labelledby="turn-heading">
    <div class="grid-dots pointer-events-none absolute inset-0 [mask-image:linear-gradient(90deg,transparent,black_70%)]" aria-hidden="true"></div>
    <div class="wrap relative py-20 md:py-28">
      <p class="eyebrow text-display-accent">{turn.eyebrow}</p>
      <h2 id="turn-heading" class="display h-section mt-4 max-w-4xl text-ink">{turn.title}</h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted md:text-xl">{turn.lede}</p>
      <p class="eyebrow mt-14 text-ink">{turn.servicesTitle}</p>
      <ol class="mt-6 grid gap-4 lg:grid-cols-3">
        {
          services.map((sv, i) => (
            <li class="group relative flex flex-col rounded-card bg-white/[0.06] p-7 ring-1 ring-white/10 transition hover:bg-white/[0.1] md:p-8">
              <p class="display text-4xl text-display-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="display mt-5 text-3xl text-ink">
                <a href={localePath(lang, sv.path)} class="after:absolute after:inset-0">{sv.name}</a>
              </h3>
              <p class="mt-3 leading-snug font-medium text-ink">“{sv.question}”</p>
              <p class="mt-4 leading-relaxed text-muted">{sv.intro}</p>
              <ul class="mt-6 flex flex-wrap gap-2">{sv.methods.slice(0, 4).map((m) => <li class="rounded-control bg-white/[0.08] px-2.5 py-1 text-xs text-ink">{m}</li>)}</ul>
              <span class="link-arrow mt-auto self-start pt-7">Explore {sv.name} <span aria-hidden="true">→</span></span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Domains -->
  <section id="domains" class="band-white scroll-mt-4" aria-labelledby="domains-heading">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow text-display-accent">Where we work</p>
      <h2 id="domains-heading" class="display h-section mt-4 max-w-3xl text-ink">Eight domains, one standard of evidence</h2>
      <ul class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          domains.map((d) => (
            <li class="group relative">
              <div class="duotone aspect-[3/2] overflow-hidden rounded-card">
                <Image src={d.image} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
              </div>
              <h3 class="mt-5 text-lg font-semibold text-ink">
                <a href={`${localePath(lang, '/work/')}?sector=${d.sector}`} class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-ember group-hover:decoration-2 group-hover:underline-offset-4">{d.name}</a>
              </h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{d.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Principles -->
  <section class="band-mist" aria-labelledby="principles-heading">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow text-display-accent">How we hold ourselves to account</p>
      <h2 id="principles-heading" class="display h-section mt-4 max-w-3xl text-ink">Academic standards, applied to real deadlines</h2>
      <dl class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          principles.map((p, i) => (
            <div class="rounded-card bg-paper p-7">
              <p class="display text-2xl text-ember">{String(i + 1).padStart(2, '0')}</p>
              <dt class="mt-3 text-lg font-semibold text-ink">{p.title}</dt>
              <dd class="mt-2 leading-relaxed text-muted">{p.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Your turn -->
  <section class="band-ember relative overflow-hidden" aria-labelledby="invite-heading">
    <div class="wrap relative grid gap-10 py-20 md:py-24 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow text-ink">{invite.eyebrow}</p>
        <h2 id="invite-heading" class="display h-section mt-4 text-ink">{invite.title}</h2>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/85">{invite.body}</p>
        <div class="mt-9 flex flex-wrap items-center gap-6">
          <a href={invite.cta.href} class="btn btn-primary !px-7">{invite.cta.label} <span aria-hidden="true">→</span></a>
          <a href={invite.email.href} class="font-semibold text-ink underline underline-offset-4">{invite.email.label}</a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <p class="eyebrow text-ink">{invite.examplesLabel}</p>
        <ul class="mt-5 space-y-3">
          {invite.examples.map((x) => <li class="rounded-card bg-white/90 px-5 py-4 font-medium text-midnight">“{x}”</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

