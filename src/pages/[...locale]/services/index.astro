---
/**
 * Our services: what makes evidence usable, the three services (src/data/offer.ts), a
 * worked example (the MultiPoD story under Insights), the domains we work in and our
 * principles (src/data/ethos.ts), and an invitation to bring a question.
 */
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { localeParams, localePath } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/ui';
import type { Locale } from '../../../i18n/config';
import { domains, principles } from '../../../data/ethos';
import { services } from '../../../data/offer';
import { site } from '../../../data/site';

export const getStaticPaths = localeParams;
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

const usable = [
  { title: 'A fair comparison', body: 'We compare like with like, so a difference in outcomes can be traced to what changed, not to who happened to be involved.' },
  { title: 'Every result on the table', body: 'We report every estimate we ran, including the ones nobody was hoping for.' },
  { title: 'An honest account of the limits', body: 'You learn what the evidence can tell you, and just as clearly, what it cannot.' },
];
const examples = ['Will a reminder cut missed appointments?', 'Did our training scheme get people into work?', 'Which message makes residents back a reform?'];
---

<Base title={t('nav.services')} description="Research & Design, Evaluation & Impact and Scale up: evidence you can act on, at every stage of a decision." lang={lang} path="/services/">
  <section class="band-midnight relative overflow-hidden">
    <div class="grid-dots pointer-events-none absolute inset-0 [mask-image:linear-gradient(90deg,transparent,black_60%)]" aria-hidden="true"></div>
    <div class="wrap relative py-16 md:py-24">
      <p class="eyebrow flex items-center gap-3 text-display-accent"><span class="h-0.5 w-8 bg-ember" aria-hidden="true"></span>{t('nav.services')}</p>
      <h1 class="display h-hero mt-5 max-w-4xl text-ink">Opinions are easy to find. <span class="text-display-accent">Evidence has to be built.</span></h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">Before a decision, after a launch, or when something that works is ready to grow, we find out what really works, for whom, and why, and tell you plainly what it means for your next move.</p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href="#services" class="btn btn-primary">Three ways we help <span aria-hidden="true">↓</span></a>
        <a href={localePath(lang, '/contact/')} class="btn btn-ghost">Talk to us</a>
      </div>
    </div>
  </section>

  <section class="band-white" aria-labelledby="usable-heading">
    <div class="wrap grid gap-12 py-20 md:py-24 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow text-display-accent">What makes evidence usable</p>
        <h2 id="usable-heading" class="display h-section mt-4 text-ink">Three things we never compromise on</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">Whatever the method, from a survey experiment to a decade of panel data, every answer we give rests on the same three foundations.</p>
      </div>
      <ol class="space-y-4 lg:col-span-7">
        {
          usable.map((u, i) => (
            <li class="flex gap-6 rounded-card bg-mist p-7">
              <span class="display text-4xl text-ember">{i + 1}</span>
              <div>
                <h3 class="text-xl font-semibold text-ink">{u.title}</h3>
                <p class="mt-2 leading-relaxed text-muted">{u.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="services" class="band-midnight relative scroll-mt-4 overflow-hidden" aria-labelledby="services-heading">
    <div class="grid-dots pointer-events-none absolute inset-0 [mask-image:linear-gradient(90deg,transparent,black_70%)]" aria-hidden="true"></div>
    <div class="wrap relative py-20 md:py-28">
      <p class="eyebrow text-display-accent">Three ways we help</p>
      <h2 id="services-heading" class="display h-section mt-4 max-w-3xl text-ink">Bring us the question, at whatever stage it arrives</h2>
      <ol class="mt-12 grid gap-4 lg:grid-cols-3">
        {
          services.map((sv, i) => (
            <li class="group relative flex flex-col rounded-card bg-white/[0.06] p-7 ring-1 ring-white/10 transition hover:bg-white/[0.1] md:p-8">
              <p class="display text-4xl text-display-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="display mt-5 text-3xl text-ink">
                <a href={localePath(lang, sv.path)} class="after:absolute after:inset-0">{sv.name}</a>
              </h3>
              <p class="mt-3 text-lg leading-snug font-medium text-ink">{sv.short}</p>
              <p class="mt-4 leading-relaxed text-muted">{sv.intro}</p>
              <p class="mt-5 text-sm leading-relaxed text-ink/80"><span class="eyebrow mr-2 text-muted">Ask us</span>“{sv.question}”</p>
              <ul class="mt-6 flex flex-wrap gap-2">{sv.methods.slice(0, 4).map((m) => <li class="rounded-control bg-white/[0.08] px-2.5 py-1 text-xs text-ink">{m}</li>)}</ul>
              <span class="link-arrow mt-auto self-start pt-7">Explore {sv.name} <span aria-hidden="true">→</span></span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band-white" aria-labelledby="example-heading">
    <div class="wrap py-16 md:py-20">
      <a href={localePath(lang, '/insights/second-language-politics/')} class="group grid gap-6 rounded-card bg-mist p-8 ring-1 ring-transparent transition hover:ring-ink md:grid-cols-12 md:items-center md:p-12">
        <div class="md:col-span-8">
          <p class="eyebrow text-display-accent">See it in action</p>
          <h2 id="example-heading" class="display h-section mt-3 text-ink">One study, from first question to recommendations</h2>
          <p class="mt-3 max-w-2xl text-lg text-muted">Follow our seven-country experiment for the Horizon Europe project MultiPoD, chapter by chapter: what we asked, how we tested it, what we found, and what we advised.</p>
        </div>
        <span class="link-arrow md:col-span-4 md:justify-self-end">Read the story <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section id="domains" class="band-mist scroll-mt-4" aria-labelledby="domains-heading">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow text-display-accent">Where we work</p>
      <h2 id="domains-heading" class="display h-section mt-4 max-w-3xl text-ink">Eight domains, one standard of evidence</h2>
      <ul class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          domains.map((d) => (
            <li class="group relative">
              <div class="duotone aspect-[3/2] overflow-hidden rounded-card">
                <Image src={d.image} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
              </div>
              <h3 class="mt-5 text-lg font-semibold text-ink">
                <a href={`${localePath(lang, '/work/')}?sector=${d.sector}`} class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-ember group-hover:decoration-2 group-hover:underline-offset-4">{d.name}</a>
              </h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{d.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band-white" aria-labelledby="principles-heading">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow text-display-accent">How we hold ourselves to account</p>
      <h2 id="principles-heading" class="display h-section mt-4 max-w-3xl text-ink">Academic standards, applied to real deadlines</h2>
      <dl class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          principles.map((p, i) => (
            <div class="rounded-card bg-mist p-7">
              <p class="display text-2xl text-ember">{String(i + 1).padStart(2, '0')}</p>
              <dt class="mt-3 text-lg font-semibold text-ink">{p.title}</dt>
              <dd class="mt-2 leading-relaxed text-muted">{p.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="band-ember relative overflow-hidden" aria-labelledby="invite-heading">
    <div class="wrap relative grid gap-10 py-20 md:py-24 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow text-ink">Your turn</p>
        <h2 id="invite-heading" class="display h-section mt-4 text-ink">What is your question?</h2>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/85">The best time to plan a test is before a rollout, while there is still a choice about who gets what, and when. Tell us what you are deciding. We will reply within two working days with an honest view of what we could find out.</p>
        <div class="mt-9 flex flex-wrap items-center gap-6">
          <a href={localePath(lang, '/contact/')} class="btn btn-primary !px-7">Tell us your question <span aria-hidden="true">→</span></a>
          <a href={`mailto:${site.email}`} class="font-semibold text-ink underline underline-offset-4">Or email {site.email}</a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <p class="eyebrow text-ink">It might sound like</p>
        <ul class="mt-5 space-y-3">{examples.map((x) => <li class="rounded-card bg-white/90 px-5 py-4 font-medium text-midnight">“{x}”</li>)}</ul>
      </div>
    </div>
  </section>
</Base>
