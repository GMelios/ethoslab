---
/**
 * What we do: the five questions clients bring us (moved here from homepage B in copy v2).
 * The two questions that match a product link to its page.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { localeParams, localePath } from '../../i18n/utils';
import { useTranslations } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import { productById, closingCta, type Product } from '../../data/offer';

export const getStaticPaths = localeParams;
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

const questions: { question: string; weDo: string; youGet: string; product?: Product }[] = [
  {
    question: 'Why aren’t people doing what we expected?',
    weDo: 'We diagnose the behavioural barriers using data, surveys and interviews.',
    youGet: 'A clear explanation of what is holding people back and where to act.',
  },
  {
    question: 'What should we do or say instead?',
    weDo: 'We design interventions, messages, choices and processes grounded in behavioural evidence.',
    youGet: 'Practical options, ready to test.',
  },
  {
    question: 'Will it work before we scale it?',
    weDo: 'We run experiments, pilots and message tests with real people.',
    youGet: 'A tested answer before you commit the budget.',
    product: productById('test'),
  },
  {
    question: 'Did it actually work?',
    weDo: 'We evaluate impact with rigorous causal methods, including on data you already hold.',
    youGet: 'Credible proof of the effect, for whom it worked, and why.',
    product: productById('evaluation'),
  },
  {
    question: 'Can we do this ourselves?',
    weDo: 'We train teams, provide tools such as Experimentalist, and work embedded alongside you.',
    youGet: 'Lasting in-house capability.',
  },
];
---

<Base title={t('nav.whatWeDo')} description="Every engagement starts with a question you need answered. These are the ones we hear most." lang={lang} path="/what-we-do/">
  <PageHero eyebrow={t('nav.whatWeDo')} title="Bring us your question" intro="Every engagement starts with a question you need answered. These are the ones we hear most." />

  <section class="wrap py-14 md:py-20" aria-label="The questions we answer">
    <!-- Six columns so the last two cards sit centred under the first three. -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
      {
        questions.map((c, i) => (
          <article class:list={['flex flex-col rounded-card bg-surface p-6 md:p-7 lg:col-span-2', i === 3 && 'lg:col-start-2', i === 4 && 'sm:max-lg:col-span-2']}>
            <h2 class="relative rounded-2xl border-2 border-ink bg-paper px-5 py-4 text-lg leading-snug font-bold text-balance text-ink">
              “{c.question}”
              <svg class="absolute -bottom-[12px] left-7 h-[14px] w-[16px]" viewBox="0 0 16 14" aria-hidden="true">
                <path d="M1 0v12L15 0" fill="var(--t-paper)" stroke="var(--t-ink)" stroke-width="2" stroke-linejoin="round" />
              </svg>
            </h2>
            <dl class="mt-8 flex flex-1 flex-col gap-5">
              <div>
                <dt class="eyebrow text-accent">What we do</dt>
                <dd class="mt-1.5 text-[0.95rem] leading-relaxed text-pretty text-ink/75">{c.weDo}</dd>
              </div>
              <div class="mt-auto border-t border-line pt-4">
                <dt class="eyebrow text-accent">You get</dt>
                <dd class="mt-1.5 leading-snug font-semibold text-ink">{c.youGet}</dd>
              </div>
            </dl>
            {c.product && (
              <a
                href={localePath(lang, c.product.path)}
                class="mt-5 inline-flex items-center gap-2 self-start font-semibold text-ink underline decoration-2 decoration-highlight underline-offset-[6px] hover:decoration-accent"
              >
                {c.product.name} <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand lang={lang} {...closingCta} />
</Base>
