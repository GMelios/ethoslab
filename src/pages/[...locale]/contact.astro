---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { localeParams } from '../../i18n/utils';
import { useTranslations } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import { site } from '../../data/site';

export const getStaticPaths = localeParams;
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
const topics = ['Research & Design', 'Evaluation & Impact', 'Scale up', 'Partnering on an EU proposal', 'Reframing Welfare Index', 'Room Wisdom', 'Something else'];
const field = 'mt-2 block w-full rounded-control border border-line bg-white px-4 py-3 text-ink placeholder:text-muted/70 focus:border-ink focus:outline-none';
---

<Base title={t('nav.contact')} description="Contact Ethos Lab in Athens." lang={lang} path="/contact/">
  <PageHero eyebrow={t('nav.contact')} title="Tell us what you need to know" intro="A short description of the decision you face is enough to start. We reply within two working days." />

  <div class="wrap grid gap-14 py-14 md:py-20 lg:grid-cols-12">
    <form class="space-y-6 lg:col-span-7" action={`mailto:${site.email}`} method="post" enctype="text/plain" data-mail-form data-email={site.email}>
      <p class="rounded-card bg-mist px-4 py-3 text-sm text-muted" role="note">
        Sending opens your email app with the message ready to go to {site.email}.
      </p>
      <div class="grid gap-6 sm:grid-cols-2">
        <label class="block text-sm font-medium text-ink">Name<input class={field} name="name" autocomplete="name" required /></label>
        <label class="block text-sm font-medium text-ink">Organisation<input class={field} name="organisation" autocomplete="organization" /></label>
      </div>
      <label class="block text-sm font-medium text-ink">Email<input class={field} type="email" name="email" autocomplete="email" required /></label>
      <fieldset>
        <legend class="text-sm font-medium text-ink">What is it about?</legend>
        <div class="mt-3 flex flex-wrap gap-2">
          {
            topics.map((topic, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="topic" value={topic} class="peer sr-only" checked={i === 0} />
                <span class="inline-block rounded-control border border-line px-3.5 py-2 text-sm text-ink peer-checked:border-ink peer-checked:bg-ink peer-checked:text-paper peer-focus-visible:outline-2 peer-focus-visible:outline-accent">{topic}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <label class="block text-sm font-medium text-ink">
        The question, the decision it informs, and your timeline
        <textarea class={`${field} min-h-40`} name="message" rows="6" required></textarea>
      </label>
      <button type="submit" class="btn btn-primary">Write the email <span aria-hidden="true">→</span></button>
    </form>

    <aside class="space-y-10 lg:col-span-5">
      <div>
        <h2 class="eyebrow text-muted">Write or call</h2>
        <p class="mt-4 text-2xl text-ink"><a class="underline decoration-line underline-offset-4 hover:decoration-ink" href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="mt-2 text-lg text-ink"><a class="hover:underline" href={site.phoneHref}>{site.phone}</a></p>
      </div>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-1">
        <div>
          <h2 class="eyebrow text-muted">{t('footer.offices')}</h2>
          <address class="mt-4 not-italic leading-relaxed text-ink">{site.offices.street}<br />{site.offices.postcode} {site.offices.city}<br />{site.offices.country}</address>
        </div>
        <div>
          <h2 class="eyebrow text-muted">{t('footer.hq')}</h2>
          <address class="mt-4 not-italic leading-relaxed text-ink">{site.registered.street}<br />{site.registered.city}<br />{site.registered.country}</address>
          <p class="mt-2 text-sm text-muted">{t('footer.registry')} {site.gemi}</p>
        </div>
      </div>
      <div class="rounded-card bg-surface p-6">
        <h2 class="font-semibold text-ink">What happens next</h2>
        <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-muted">
          <li>A researcher reads your message and replies within two working days.</li>
          <li>We arrange a 30 minute call to understand the decision and the data.</li>
          <li>You receive a short note on which designs could answer the question, and what each would cost.</li>
        </ol>
      </div>
    </aside>
  </div>
</Base>

<script>
  // No backend on GitHub Pages: compose the message as an email instead.
  const form = document.querySelector<HTMLFormElement>('[data-mail-form]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) ?? '').trim();
    const subject = `${get('topic')}: enquiry from ${get('name')}${get('organisation') ? `, ${get('organisation')}` : ''}`;
    const body = `${get('message')}\n\n${get('name')}\n${get('organisation')}\n${get('email')}`;
    location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
