---
/**
 * Case study template, shared by hand-written case studies and projects imported
 * from WordPress. Sections render only when the entry has the data for them:
 * headline figure, effect-size chart (results), at-a-glance facts, cover image.
 */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import EffectSizeChart from '../../../components/EffectSizeChart.astro';
import WorkCard from '../../../components/WorkCard.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { DEFAULT_LOCALE, PUBLISHED_LOCALES, type Locale } from '../../../i18n/config';
import { localePath, type Localised } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/ui';
import { getWork, sectorLabel } from '../../../lib/content';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of PUBLISHED_LOCALES) {
    const work = await getWork(lang);
    for (const entry of work) {
      const related = work
        .filter((w) => w.slug !== entry.slug && w.data.sectors.some((s) => entry.data.sectors.includes(s)))
        .slice(0, 3);
      paths.push({ params: { locale: lang === DEFAULT_LOCALE ? undefined : lang, slug: entry.slug }, props: { lang, entry, related } });
    }
  }
  return paths;
}

interface Props {
  lang: Locale;
  entry: Localised<'projects'>;
  related: Localised<'projects'>[];
}
const { lang, entry, related } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;
const { Content } = await render(entry);

const facts = [
  { label: t('case.partner'), value: d.partner },
  { label: t('case.countries'), value: d.countries?.join(', ') },
  { label: t('case.years'), value: d.years },
  { label: t('case.design'), value: d.design },
  { label: t('case.sample'), value: d.sample },
  { label: t('case.programme'), value: d.programmes?.filter((p) => p !== 'Public policy').join(', ') },
  { label: t('case.prereg'), value: d.preregistration ? `${d.preregistration.registry}, ${d.preregistration.id}` : undefined },
].filter((f) => f.value);
---

<Base title={d.title} description={d.summary} lang={lang} path={`/work/${entry.slug}/`}>
  <article>
    <header class="band-midnight relative overflow-hidden">
      <div class="grid-dots pointer-events-none absolute inset-0 [mask-image:linear-gradient(90deg,transparent,black_60%)]" aria-hidden="true"></div>
      <div class="wrap relative pt-8 pb-12 md:pt-10 md:pb-16">
        <nav aria-label="Breadcrumb" class="text-sm text-muted">
          <a href={localePath(lang, '/work/')} class="hover:text-ink hover:underline">{t('nav.work')}</a>
          <span aria-hidden="true" class="px-1.5">/</span>
          <a href={localePath(lang, `/work/?sector=${d.sectors[0]}`)} class="hover:text-ink hover:underline">{sectorLabel(d.sectors[0], lang)}</a>
        </nav>

        <div class="mt-8 grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-8">
            <ul class="flex flex-wrap gap-x-4 gap-y-1" aria-label={t('case.sectors')}>
              {d.sectors.map((s) => <li class="eyebrow text-display-accent">{sectorLabel(s, lang)}</li>)}
            </ul>
            <h1 class="display h-hero mt-4 text-ink">{d.title}</h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">{d.summary}</p>
          </div>

          <aside class="lg:col-span-4 lg:pt-2">
            {
              d.cover && !d.results && (
                <div class="mb-6 flex aspect-[4/3] items-center justify-center rounded-card bg-white p-8">
                  <Image src={d.cover} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 360px, 90vw" class="max-h-full w-auto object-contain" />
                </div>
              )
            }
            {
              facts.length > 0 && (
                <div class="rounded-card bg-surface p-6 ring-1 ring-line">
                  <h2 class="eyebrow text-muted">{t('case.atAGlance')}</h2>
                  <dl class="mt-4 space-y-3 text-sm">
                    {facts.map((f) => (
                      <div class="grid grid-cols-[7.5rem_1fr] gap-3">
                        <dt class="text-muted">{f.label}</dt>
                        <dd class="text-ink">{f.value}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )
            }
          </aside>
        </div>
      </div>
    </header>

    {
      d.illustrative && (
        <div class="wrap mt-8">
          <p class="flex items-start gap-3 rounded-card border border-dashed border-ink/40 px-5 py-4 text-sm text-ink" role="note">
            <span class="sample-badge mt-0.5">Illustrative</span>
            <span>{t('case.illustrative')}</span>
          </p>
        </div>
      )
    }

    {
      d.provisional && (
        <div class="wrap mt-8">
          <p class="flex items-start gap-3 rounded-card border border-line bg-surface px-5 py-4 text-sm text-ink" role="note">
            <span class="sample-badge mt-0.5">Provisional</span>
            <span>{d.provisional}</span>
          </p>
        </div>
      )
    }

    {
      d.results && (
        <section class="wrap py-12 md:py-16" aria-labelledby="results-heading">
          <h2 id="results-heading" class="eyebrow text-muted">{t('case.results')}</h2>
          <div class="mt-6 grid gap-10 lg:grid-cols-12">
            {d.headline && (
              <div class="lg:col-span-3">
                <p class="font-body text-6xl font-semibold tracking-tight text-ink md:text-7xl">{d.headline.value}</p>
                <p class="mt-3 max-w-xs text-base leading-snug text-muted">{d.headline.label}</p>
              </div>
            )}
            <div class:list={['rounded-card border border-line bg-paper p-5 md:p-8', d.headline ? 'lg:col-span-9' : 'lg:col-span-12', 'theme-b:border-0 theme-b:bg-surface']}>
              <EffectSizeChart results={d.results} lang={lang} />
            </div>
          </div>
          {d.secondaryResults.length > 0 && (
            <div class="mt-8 grid gap-6 lg:grid-cols-2">
              {d.secondaryResults.map((r) => (
                <div class="rounded-card border border-line bg-paper p-5 md:p-7 theme-b:border-0 theme-b:bg-surface">
                  <EffectSizeChart results={r} lang={lang} />
                </div>
              ))}
            </div>
          )}
        </section>
      )
    }

    <section class:list={['wrap pb-8', !d.results && 'pt-12']}>
      <div class="prose prose-lg prose-site max-w-3xl">
        <Content />
      </div>
      {
        d.wpUrl && (
          <p class="mt-10 max-w-3xl border-t border-line pt-4 text-sm text-muted">
            {t('case.legacy')} <a class="underline underline-offset-4 hover:text-ink" href={d.wpUrl} rel="noopener">View the original page</a>.
          </p>
        )
      }
    </section>

    {
      related.length > 0 && (
        <section class="band-mist mt-8" aria-labelledby="related-heading">
          <div class="wrap py-14">
            <h2 id="related-heading" class="display h-section text-ink">{t('case.related')}</h2>
            <div class="mt-8 grid gap-6 md:grid-cols-3">
              {related.map((r) => <WorkCard entry={r} lang={lang} headingLevel="h3" />)}
            </div>
          </div>
        </section>
      )
    }
  </article>
  <CtaBand lang={lang} />
</Base>
