---
/** Review hub: every homepage variant in one place. Not in the sitemap. */
import Base from '../layouts/Base.astro';
import { stories } from '../data/stories';

const directions = [
  { id: 'b', name: 'B · Warm and illustrated' },
  { id: 'c', name: 'C · Data-forward' },
];
---

<Base title="Review homepage variants" lang="en" theme="a" homeHref="/review">
  <section class="wrap py-14 md:py-20">
    <p class="eyebrow text-accent">Prototype review</p>
    <h1 class="display mt-4 text-4xl text-ink md:text-5xl">Homepage variants</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
      Each story uses identical copy in both designs, so you can judge the narrative and the design separately. Direction A (editorial) is kept at
      <a class="text-accent underline underline-offset-4" href="/a">/a</a> for reference.
    </p>

    <div class="mt-12 overflow-x-auto">
      <table class="w-full min-w-[40rem] border-collapse text-left">
        <thead>
          <tr class="border-b-2 border-ink">
            <th scope="col" class="py-3 pr-6 font-semibold">Story</th>
            {directions.map((d) => <th scope="col" class="py-3 pr-6 font-semibold">{d.name}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            stories.map((s) => (
              <tr class="border-b border-line align-top">
                <th scope="row" class="py-5 pr-6 font-normal">
                  <span class="block font-semibold text-ink">{s.label}</span>
                  <span class="mt-1 block text-sm text-muted">{s.description}</span>
                </th>
                {directions.map((d) => {
                  const href = s.id ? `/${d.id}/${s.id}` : `/${d.id}`;
                  return (
                    <td class="py-5 pr-6">
                      <a class="font-medium text-accent underline underline-offset-4" href={href}>{href}</a>
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>
