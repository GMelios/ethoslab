  "clear": [
    {
      "asset": "Horizontal lockups",
      "rule": "X = 0.5 × logo height (the cap height of ETHOS)",
      "example": "32px tall logo → 16px clear space"
    },
    {
      "asset": "Stacked lockups",
      "rule": "X = 0.19 × logo height (the cap height of ETHOS)",
      "example": "200px tall logo → 38px clear space"
    },
    {
      "asset": "Mark and favicon",
      "rule": "X = 0.25 × mark height",
      "example": "48px mark → 12px clear space"
    }
